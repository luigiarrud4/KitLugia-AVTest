    },
    {
      "id": "e2",
      "from": "browse",
      "to": "select"
    },
    {
      "id": "e3",
      "from": "select",
      "to": "download"
    },
    {
      "id": "e4",
      "from": "download",
      "to": "verify"
    },
    {
      "id": "e5",
      "from": "verify",
      "to": "install"
    },
    {
      "id": "e6",
      "from": "install",
      "to": "done"
    }
