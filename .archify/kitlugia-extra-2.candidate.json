  "nodes": [
    {
      "id": "start",
      "lane": "ui",
      "col": 0,
      "type": "external",
      "label": "Abre StorePage",
      "width": 120
    },
    {
      "id": "browse",
      "lane": "engine",
      "col": 1,
      "type": "backend",
      "label": "ListPackages",
      "sublabel": "manifest local + remote",
      "width": 150
    },
    {
      "id": "select",
      "lane": "ui",
      "col": 2,
      "type": "backend",
      "label": "User seleciona pacote",
