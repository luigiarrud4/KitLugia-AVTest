    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "ui",
      "label": "StorePage UI"
    },
    {
      "id": "engine",
      "label": "StoreEngine"
    },
    {
      "id": "net",
      "label": "HTTP + File IO"
    }
  ],
  "phases": [
    {
      "id": "p1",
      "label": "Browse",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "p2",
      "label": "Download",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "p3",
      "label": "Install",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "start",
    "browse",
    "select",
    "download",
    "verify",
    "install",
    "done"
