    },
    {
      "id": "e4",
      "from": "baseline",
      "to": "run_uninstaller"
    },
    {
      "id": "e5",
      "from": "find_uninstaller",
      "to": "run_uninstaller"
    },
    {
      "id": "e6",
      "from": "run_uninstaller",
