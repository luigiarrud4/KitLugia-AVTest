      "toCol": 1
    },
    {
      "id": "p2",
      "label": "Uninstall",
      "fromCol": 2,
      "toCol": 3
    },
    {
      "id": "p3",
      "label": "Scan + Cleanup",
      "fromCol": 4,
      "toCol": 5
    }
  ],
  "mainPath": [
    "start",
    "kill",
    "baseline",
    "run_uninstaller",
    "scan",
    "cleanup",
    "report"
