<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<StartupObject>KitLugia.GUI.Program</StartupObject>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Permite restore/build do projeto Windows no Linux (CI GitHub Actions) -->
		<EnableWindowsTargeting>true</EnableWindowsTargeting>

		<NoWarn>$(NoWarn);WFAC010;CS1668;XLS0414</NoWarn>

		
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		
		<CodePage>65001</CodePage>
		<ApplicationIcon>Iconarchive-Realistic-Fruits-Yellow-Apple.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<SatelliteResourceLanguages>pt-BR;en-US</SatelliteResourceLanguages>
		<PublishReadyToRun>true</PublishReadyToRun>
		<PublishReadyToRunShowWarnings>false</PublishReadyToRunShowWarnings>
		<DebugType>embedded</DebugType>
		
		<EnableXamlDiagnostics Condition="'$(Configuration)' == 'Debug'">true</EnableXamlDiagnostics>
		<EnableXamlDiagnostics Condition="'$(Configuration)' != 'Debug'">false</EnableXamlDiagnostics>
		<XamlDebuggingInformation Condition="'$(Configuration)' == 'Debug'">True</XamlDebuggingInformation>
		<XamlDebuggingInformation Condition="'$(Configuration)' != 'Debug'">False</XamlDebuggingInformation>
<Version>2.0.29</Version>
<AssemblyVersion>2.0.29.0</AssemblyVersion>
<FileVersion>2.0.29.0</FileVersion>
	</PropertyGroup>

	<ItemGroup>
	  <None Remove="Pages\DriversPage.xaml.txt" />
	</ItemGroup>

	<ItemGroup>
	  <Content Include="Iconarchive-Realistic-Fruits-Yellow-Apple.ico" />
	  
	  <Content Include="..\KitLugia.Core\Resources\LinuxPreOS\vmlinuz">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Link>Resources\LinuxPreOS\vmlinuz</Link>
	  </Content>
	  <Content Include="..\KitLugia.Core\Resources\LinuxPreOS\initrd.gz">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Link>Resources\LinuxPreOS\initrd.gz</Link>
	  </Content>
	  <Content Include="..\KitLugia.Core\Resources\LinuxPreOS\grubx64.efi" Condition="Exists('..\KitLugia.Core\Resources\LinuxPreOS\grubx64.efi')">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Link>Resources\LinuxPreOS\grubx64.efi</Link>
	  </Content>
	  
	  <Content Include="..\KitLugia.Core\Resources\BootGoodies\refind\refind_x64.efi">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Link>Resources\BootGoodies\refind\refind_x64.efi</Link>
	  </Content>
	  <Content Include="..\KitLugia.Core\Resources\BootGoodies\refind\shellx64.efi">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<Link>Resources\BootGoodies\refind\shellx64.efi</Link>
	  </Content>
	  
	  <Content Include="External\MAS\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="External\ForceStopUnlock\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="External\WindowsUpdate\**\*" Condition="Exists('External\WindowsUpdate')">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="Resources\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <!-- Removido KitLugia.WinPE.exe e ISOs/WIMs grandes (300MB+ desnecessários no kit) -->
	  <Content Remove="Resources\**\KitLugia.WinPE.exe" />
	  <Content Remove="Resources\**\*.iso" />
	  <Content Remove="Resources\**\*.wim" />
	  <Content Remove="Resources\**\*.esd" />
	  <Content Remove="**\WinPE*.iso" />
	  <Content Remove="**\KitLugia_WinPE.iso" />
	  
	  <Content Include="Tools\GoodbyeDPI\**\*">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\KitLugia.Core\KitLugia.Core.csproj" />
	</ItemGroup>

  
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)..\rust_native\target\release\rust_native.dll')">
    <Content Include="..\rust_native\target\release\rust_native.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>rust_native.dll</Link>
    </Content>
  </ItemGroup>

<ItemGroup><Page Remove="Pages\_PageTemplate.xaml" Generator="MSBuild:Compile" /><None Include="Pages\_PageTemplate.xaml" CopyToOutputDirectory="Never" /><None Include="Pages\_PageTemplate.xaml.cs" CopyToOutputDirectory="Never" /><None Include="Pages\_CONVENTIONS.md" CopyToOutputDirectory="Never" />  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Pages\_PageTemplate.xaml.cs" />
    <None Include="Pages\_PageTemplate.xaml" CopyToOutputDirectory="Never" />
    <None Include="Pages\_PageTemplate.xaml.cs" CopyToOutputDirectory="Never" />
    <None Include="Pages\_CONVENTIONS.md" CopyToOutputDirectory="Never" />
  </ItemGroup>
</Project>