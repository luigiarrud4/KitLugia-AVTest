<UserControl x:Class="KitLugia.GUI.Controls.InfoButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Padrao de icone de informacao do KitLugia (ℹ dourado, hover realca).
        Uso:  <controls:InfoButton ToolTipText="ajuda (aceita &#x0a; p/ quebras de linha)"/>
        Opacidade fica no Button (pai) p/ o trigger de hover clarear o glifo inteiro.
    -->
    <Button x:Name="BtnInfo" Width="30" Height="30" Cursor="Help" Opacity="0.65"
            ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000"
            Background="Transparent" BorderThickness="0"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            Margin="0,0,10,0"
            Focusable="False">
        <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}"/>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="Transparent">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
