<UserControl x:Class="KitLugia.GUI.Controls.ProcessEngineConfigOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:KitLugia.GUI.Controls"
             Visibility="Collapsed"
             TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Grid Background="#CC000000">
        <Border x:Name="RootBorder" Background="#1A1A1A" BorderBrush="#FFD700" BorderThickness="1"
                CornerRadius="10" Width="660" MaxHeight="700"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#FFD700" BlurRadius="20" ShadowDepth="0" Opacity="0.15"/>
            </Border.Effect>
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="&#x2699;&#xFE0F; Configurações do Processo"
                                   FontSize="17" FontWeight="Bold" Foreground="#FFD700"/>
                        <TextBlock Text="Ajustes aplicados automaticamente enquanto este processo estiver na lista do RAM Limiter."
                                   FontSize="11" Foreground="#999" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="&#x2715;" Width="28" Height="28"
                            Background="Transparent" Foreground="#666" BorderThickness="0"
                            FontSize="14" Cursor="Hand" Click="BtnClose_Click"
                            VerticalAlignment="Top"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- ══════════ CPU ══════════ -->
                        <TextBlock Text="CPU" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,10,0,4"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Classe de prioridade base do processo (o Windows escalona threads com base nela).&#x0a;&#x0a;• Normal: padrão do sistema.&#x0a;• AboveNormal/High: mais CPU quando há disputa — recomendado para o app que você está usando.&#x0a;• RealTime: NÃO use em apps comuns — pode travar o mouse/teclado se o processo travar.&#x0a;• Idle/BelowNormal: deixa outros processos na frente (bom para downloads e backups)."/>
                            <TextBlock Grid.Column="1" Text="Prioridade CPU" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboCpuPriority" SelectedIndex="4"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="Idle"/>
                                <ComboBoxItem Content="BelowNormal"/>
                                <ComboBoxItem Content="Normal"/>
                                <ComboBoxItem Content="AboveNormal"/>
                                <ComboBoxItem Content="High"/>
                                <ComboBoxItem Content="RealTime"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Só funciona em CPUs híbridas (Intel 12ª geração+ / Ryzen com P+E cores), Windows 11 24H2+.&#x0a;&#x0a;• P-Cores (Performance): força as threads nos núcleos rápidos — reduz micro-travamentos em jogos.&#x0a;• E-Cores (Efficiency): empurra para os núcleos econômicos — economiza energia, bom para tarefas em segundo plano."/>
                            <TextBlock Grid.Column="1" Text="Efficiency Mode" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboEfficiencyMode" SelectedIndex="0"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="P-Cores (Performance)"/>
                                <ComboBoxItem Content="E-Cores (Efficiency)"/>
                            </ComboBox>
                        </Grid>

                        <!-- ══════════ I/O e Memória ══════════ -->
                        <TextBlock Text="I/O e Memória" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Prioridade das operações de disco (leitura/gravação).&#x0a;&#x0a;• Baixa: deixa outros programas lerem o disco primeiro — bom para apps que ficam gravando em segundo plano.&#x0a;• Normal: padrão.&#x0a;• Alta/Critical: o disco prioriza este processo — use em apps que precisam carregar muita coisa rápido."/>
                            <TextBlock Grid.Column="1" Text="Prioridade I/O" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboIoPriority" SelectedIndex="1"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="Baixa (0)"/>
                                <ComboBoxItem Content="Normal (1)"/>
                                <ComboBoxItem Content="Alta (2)"/>
                                <ComboBoxItem Content="Critical (3)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Prioridade das páginas de memória do processo no pool do sistema.&#x0a;&#x0a;• Normal: padrão.&#x0a;• Acima do Normal: as páginas deste processo são mantidas por mais tempo na RAM antes de irem para o arquivo de paginação — útil para apps que você usa o tempo todo."/>
                            <TextBlock Grid.Column="1" Text="Prioridade Página" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboPagePriority" SelectedIndex="0"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="Normal (0)"/>
                                <ComboBoxItem Content="Acima do Normal (1)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="0,4,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Prioridade de memória (quem é escolhido primeiro para ser compactado/despejado quando a RAM fica curta).&#x0a;&#x0a;• Alta: este processo é o último a perder memória — bom para o app que você não quer que trave.&#x0a;• Baixa/Média: o sistema pode recolher memória dele primeiro — bom para processos pesados em segundo plano."/>
                            <TextBlock Grid.Column="1" Text="Memory Priority" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboMemoryPriority" SelectedIndex="0"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12">
                                <ComboBoxItem Content="Normal (0)"/>
                                <ComboBoxItem Content="Baixa (1)"/>
                                <ComboBoxItem Content="Média (2)"/>
                                <ComboBoxItem Content="Alta (3)"/>
                            </ComboBox>
                        </Grid>

                        <!-- ══════════ Boosts ══════════ -->
                        <TextBlock Text="Boosts" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Aumenta a resolução do timer do Windows de ~15,6ms para 1ms enquanto este processo estiver na lista.&#x0a;&#x0a;Reduz atraso em jogos, áudio e vídeo — porém consome um pouco mais de bateria em notebooks. O kit restaura o valor original ao sair."/>
                            <CheckBox Grid.Column="1" x:Name="ChkTimerBoost" Content="Timer Boost (resolução 1ms)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Ajusta parâmetros de rede (TCP) para reduzir latência de conexões ativas.&#x0a;&#x0a;Pode ajudar em jogos online e chamadas de voz. Não mexe no seu tráfego — só nos buffers de envio/recebimento do Windows."/>
                            <CheckBox Grid.Column="1" x:Name="ChkNetworkBoost" Content="Network Boost (prioridade de rede)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- ══════════ ProBalance ══════════ -->
                        <TextBlock Text="ProBalance" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Estilo Process Lasso: quando este processo está em SEGUNDO PLANO e passa do limite de CPU, o kit o desacelera temporariamente e o restaura sozinho quando ele para.&#x0a;&#x0a;Nunca mexe no processo quando ele está em primeiro plano. Ideal para programas que ficam queimando CPU sem necessidade."/>
                            <CheckBox Grid.Column="1" x:Name="ChkProBalance" Content="ProBalance (controle de CPU em segundo plano)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" Checked="ChkProBalance_Checked" Unchecked="ChkProBalance_Checked"/>
                        </Grid>

                        <Grid Margin="24,4,0,0" x:Name="PanelProBalanceMode">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Como o desaceleramento é aplicado:&#x0a;&#x0a;• Clássico: prioridade BelowNormal + memória muito baixa — compatível com tudo.&#x0a;• EcoQoS: API oficial do Windows 11 (mesmo mecanismo do Modo Eficiência do Gerenciador de Tarefas) — mais suave, não mexe na prioridade.&#x0a;• Hard Cap: trava REAL de CPU via Job Object — o processo não passa do limite definido enquanto estiver acima do gatilho."/>
                            <TextBlock Grid.Column="1" Text="Modo do ProBalance" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="2" x:Name="CboProBalanceMode" SelectedIndex="0"
                                      Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                      Height="28" FontSize="12" SelectionChanged="CboProBalanceMode_SelectionChanged">
                                <ComboBoxItem Content="Clássico (BelowNormal)"/>
                                <ComboBoxItem Content="EcoQoS (Oficial Win11)"/>
                                <ComboBoxItem Content="Hard Cap (Job Object)"/>
                            </ComboBox>
                        </Grid>

                        <Grid Margin="24,4,0,0" x:Name="PanelProBalanceThreshold">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Porcentagem de CPU (de todos os núcleos) que dispara o ProBalance.&#x0a;&#x0a;• 5% = agressivo: qualquer usozinho já desacelera (bom para economizar recursos).&#x0a;• 30%+ = conservador: só age quando o processo está realmente pesado.&#x0a;&#x0a;No modo Hard Cap, este valor vira o TETO máximo real de CPU."/>
                            <TextBlock Grid.Column="1" Text="Limite CPU (%)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TxtProBalanceThreshold" Text="5"
                                     Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                     Height="28" FontSize="12" Padding="6,0"/>
                        </Grid>

                        <Border Background="#1A1F2A" BorderBrush="#4A90D9" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="20,6,0,4">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#9FC5E8">
                                <Run Text="⚖️ Enquanto estiver em segundo plano e acima do limite, o processo é desacelerado; quando ele normaliza, tudo volta ao normal sozinho."/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/><Run Text="Clássico: prioridade BelowNormal + memória muito baixa (compatível com tudo)."/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/><Run Text="EcoQoS: API oficial do Windows 11 (Modo Eficiência) — mais suave, sem mexer na prioridade."/>
                                <LineBreak/>
                                <Run Text="• " FontWeight="Bold"/><Run Text="Hard Cap: trava REAL de CPU via Job Object — usa o % acima como teto máximo."/>
                            </TextBlock>
                        </Border>

                        <!-- ══════════ Limitador de CPU ══════════ -->
                        <TextBlock Text="Limitador de CPU" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Diferente do ProBalance, este limite é PERMANENTE: o processo nunca passa do percentual definido, esteja em primeiro plano ou não.&#x0a;&#x0a;Ideal para programas de fundo que queimam CPU, mas pode causar lentidão no próprio app."/>
                            <CheckBox Grid.Column="1" x:Name="ChkCpuLimit" Content="Limitar uso máximo de CPU (%)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" Checked="ChkCpuLimit_Checked" Unchecked="ChkCpuLimit_Checked"/>
                        </Grid>

                        <Grid Margin="24,4,0,0" x:Name="PanelCpuLimit">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="190"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Teto permanente de CPU (1-99%).&#x0a;Exemplo: 50% num PC de 8 núcleos = o processo usa no máximo 4 núcleos completos."/>
                            <TextBlock Grid.Column="1" Text="CPU Máximo (%)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" x:Name="TxtCpuLimitPercent" Text="50"
                                     Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                     Height="28" FontSize="12" Padding="6,0"/>
                        </Grid>

                        <Border Background="#2A1A1A" BorderBrush="#FF4444" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,8,0,4">
                            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#FF9999">
                                <Run Text="⚠️ " FontWeight="Bold"/>
                                <Run Text="Hard cap real via Windows Job Object: o processo não ultrapassará o percentual, "/>
                                <Run Text="mas pode causar lentidão em aplicações sensíveis a tempo real. "/>
                                <Run Text="Recomendado apenas para processos em segundo plano com alto consumo de CPU."/>
                            </TextBlock>
                        </Border>

                        <!-- ══════════ Recursos Adicionais ══════════ -->
                        <TextBlock Text="Recursos Adicionais" Foreground="#888" FontSize="11" FontWeight="Bold" Margin="0,12,0,4"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Marca o processo como 'jogo' para o Game Mode do Windows (API oficial SetProcessGameClassInfo).&#x0a;&#x0a;O Windows pode dar prioridade de agendamento e evitar interferências de fundo quando este processo está ativo."/>
                            <CheckBox Grid.Column="1" x:Name="ChkGameClass" Content="Game Class Info (sinalizar como jogo)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Ajusta o Win32PrioritySeparation do registro (HKLM\SYSTEM\CurrentControlSet\Control\PriorityControl).&#x0a;&#x0a;Faz o Windows dar fatias de tempo mais longas ao app em primeiro plano — efeito global, fica aplicado até ser revertido."/>
                            <CheckBox Grid.Column="1" x:Name="ChkWin32Priority" Content="Win32 Priority Separation (registry)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center" IsChecked="True"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:InfoButton Grid.Column="0" ToolTipText="Opta o processo no EcoQoS do Windows 11: o sistema reduz a velocidade de execução em segundo plano.&#x0a;&#x0a;Economiza bateria/energia — bom para downloads e tarefas lentas que não precisam de pressa. (Em conflito com o modo EcoQoS do ProBalance, o ProBalance vence.)"/>
                            <CheckBox Grid.Column="1" x:Name="ChkEcoQoS" Content="EcoQoS (economia de energia)" Foreground="#CCC" FontSize="12" VerticalAlignment="Center"/>
                        </Grid>
                        <Border Height="6"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- Rodapé com margem topo 0: NÃO invade a área de rolagem (antes -12 cobria o último item) -->
                <Border Grid.Row="2" Background="#111111" CornerRadius="0,0,10,10" Padding="14,12" Margin="-20,0,-20,-20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnCancel" Content="Cancelar" Width="100" Height="34"
                                Margin="0,0,10,0" Click="BtnCancel_Click"
                                Background="#444" Foreground="White" BorderThickness="0"
                                FontSize="12" Cursor="Hand"/>
                        <Button x:Name="BtnSave" Content="Salvar" Width="100" Height="34"
                                Background="#FFD700" Foreground="Black" BorderThickness="0"
                                FontSize="12" FontWeight="Bold" Cursor="Hand"
                                Click="BtnSave_Click"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
