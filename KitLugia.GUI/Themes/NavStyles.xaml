    <!-- Item de submenu (dentro de uma categoria expansivel na barra lateral, ex.: Discos).
         BasedOn no NavButtonStyle: herda o template inteiro e so reduz altura/fonte, recua
         a margem para mostrar a hierarquia e tira o scale do hover (fica ruidoso em item
         pequeno). Criado em 03/10/2026 junto com o grupo expansivel de discos. -->
    <Style x:Key="NavSubButtonStyle" TargetType="{x:Type RadioButton}" BasedOn="{StaticResource NavButtonStyle}">
        <Setter Property="Height" Value="34"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Margin" Value="24,1,5,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,0" BorderThickness="1" BorderBrush="Transparent">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="icon" Text="{TemplateBinding Tag}" Width="24" FontSize="13" VerticalAlignment="Center" FontFamily="Segoe UI Emoji" Foreground="{DynamicResource TextSecondary}"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                            <Rectangle x:Name="ActiveBar" HorizontalAlignment="Left" Width="3" Height="16" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource AccentColor}" Visibility="Collapsed" Margin="-8,0,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#15FFFFFF"/>
                            <Setter Property="Foreground" Value="White"/>
                            <Setter TargetName="icon" Property="Foreground" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="border" Property="Background" Value="#25FFD700"/>
                            <Setter TargetName="border" Property="BorderBrush" Value="#44FFD700"/>
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="icon" Property="Foreground" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="ActiveBar" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Seta de expandir/recolher categoria da barra lateral (03/10/2026).
         Alvo de clique 40x40 (o primeiro versao tinha um glyph de 13 px num botao de 30 px:
         area pequena demais, o usuario reclamou que "dificil de clicar").
         Mesma abordagem do KitTaskManager: Path desenhado + RotatingTransform, sem fonte.
         Tag="0" = recolhido (aponta para a direita) / Tag="1" = aberto (aponta para baixo). -->
    <Style x:Key="NavExpandButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Margin" Value="0,1,5,1"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Tag" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="6">
                        <Path x:Name="chev" Data="M0,0 L4.5,4.5 L9,0" StrokeThickness="1.7"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              Stroke="{DynamicResource TextSecondary}" RenderTransformOrigin="0.5,0.5"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="-90"/>
                            </Path.RenderTransform>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                            <Setter TargetName="chev" Property="Stroke" Value="White"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bg" Property="Background" Value="#25FFD700"/>
                        </Trigger>
                        <!-- Tag="1" = categoria ABERTA: chevron gira para baixo e fica com a cor de
                             destaque. O angulo e animado no RenderTransform.Angle da Path (o
                             RotateTransform nao e um elemento nomeavel, entao nao da pra usar
                             Setter TargetName nele — precisa de Storyboard). -->
                        <Trigger Property="Tag" Value="1">
                            <Setter TargetName="chev" Property="Stroke" Value="{DynamicResource AccentColor}"/>
                            <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="chev"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         To="-90" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
