<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

<!-- Rodelas de carregamento oficiais do KitLugia (contrato visual, sec. 2 do plano).
     Moram aqui, e nao dentro de uma pagina, para qualquer tela usar a variante A
     sem copiar markup. A variante B (toast de progresso) e' Controls/LugiaToast. -->
        <!-- Rodela estilo Windows 11 (circulo de pontos girando, como no boot/shutdown) - grande -->
        <ControlTemplate x:Key="Win11SpinnerTemplate" TargetType="ContentControl">
            <Grid Width="44" Height="44" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotate"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Width="7" Height="7" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="-16"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="15.2" Y="-4.9"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="9.4" Y="12.9"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="-9.4" Y="12.9"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="7" Height="7" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="-15.2" Y="-4.9"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </ControlTemplate>

        <!-- Rodela estilo Windows 11 - versao mini (placeholder de icone) -->
        <ControlTemplate x:Key="Win11MiniSpinnerTemplate" TargetType="ContentControl">
            <Grid Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform x:Name="MiniSpinnerRotate"/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.4"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Width="4" Height="4" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="0" Y="-9"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="8.6" Y="-2.8"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="5.3" Y="7.3"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="-5.3" Y="7.3"/></Ellipse.RenderTransform>
                </Ellipse>
                <Ellipse Width="4" Height="4" Fill="#FFD700" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse.RenderTransform><TranslateTransform X="-8.6" Y="-2.8"/></Ellipse.RenderTransform>
                </Ellipse>
            </Grid>
        </ControlTemplate>

</ResourceDictionary>
