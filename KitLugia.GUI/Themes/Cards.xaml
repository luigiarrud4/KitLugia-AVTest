<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:KitLugia.GUI.Controls">

    <!-- ============================================================
         Superficies (F3 do docs/UI_CONSISTENCY_PLAN.md).

         Hover tem ANIMACAO de escala de novo (o realce do kit estavel): a imagem
         NAO projeta sombra - era o DropShadowEffect com BlurRadius animado que
         custava caro, e ele continua fora. A escala roda so' no item apontado.

         QUIRK: o scale NAO pode vir de um Setter de Style como ScaleTransform -
         o WPF congela Freezables ao selar o estilo e a animacao vira no-op
         silencioso. Por isso o zoom e' feito pelo comportamento
         Controls/HoverZoom (transform criado por elemento).
         Raio unico: 8.
         ============================================================ -->

    <!-- Cartao de CONTEUDO: o realce do hover e' so' de cor. Nao tem cursor de
         clique nem escala - um card destes costuma ser o bloco inteiro de uma
         secao (a lista de tweaks tem 700 px de largura), e a escala de 1,5%
         empurrava a borda ~7 px para fora do lugar. Pior: o Cursor="Hand" era
         HERDADO por todo texto dentro do card, entao a mao de clique aparecia
         sobre uma area onde nao ha nada para clicar. -->
    <Style x:Key="CardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Background" Value="{DynamicResource CardHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Card que REALMENTE abre algo no clique: mesma cor do CardStyle, mais o
         cursor de mao e um zoom suave (1,01 em 200 ms, o mesmo dos cards do
         Dashboard). Quem nao clica nao anuncia clique. -->
    <Style x:Key="InteractiveCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="controls:HoverZoom.Enabled" Value="True"/>
        <Setter Property="controls:HoverZoom.Scale" Value="1.01"/>
        <Setter Property="controls:HoverZoom.DurationMs" Value="200"/>
    </Style>

    <Style x:Key="CompactCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                <Setter Property="Background" Value="{DynamicResource CardHover}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtleCardStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="controls:HoverZoom.Enabled" Value="True"/>
        <Setter Property="controls:HoverZoom.Scale" Value="1.01"/>
        <Setter Property="controls:HoverZoom.DurationMs" Value="200"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Painel estatico (nao e' clicavel): usado para agrupar blocos de conteudo. -->
    <Style x:Key="SurfacePanelStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource Surface1}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

</ResourceDictionary>
