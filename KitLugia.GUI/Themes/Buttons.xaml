    <Style x:Key="ActionButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="#3A3A3A"/>
        <Setter Property="Foreground" Value="#EEEEEE"/>
        <Setter Property="BorderBrush" Value="#555555"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinWidth" Value="75"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bdr" Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="{TemplateBinding BorderThickness}" 
                            CornerRadius="4">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD700" BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" 
                                          TextElement.Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="#FFD700"/>
                            <Setter Property="BorderBrush" Value="#FFD700"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#4A4A4A"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="#B0B0B0"/>
                            <Setter Property="BorderBrush" Value="#666666"/>
                            <Setter Property="Background" Value="#2D2D2D"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============================================================
         Botao de barra de acoes com ICONE VETORIAL + texto.

         Tag recebe a Geometry do icone (Themes/Icons.xaml), Foreground pinta
         icone e texto juntos, Background/BorderBrush dao a familia de cor.
         Nada depende de fonte/emoji instalado no Windows.

         <Button Style="{StaticResource IconTextButtonStyle}"
                 Tag="{DynamicResource IconSelectAll}" Content="Selecionar Todos"
                 Foreground="#66BB6A" BorderBrush="#4D4CAF50" Background="#1F4CAF50"/>
         ============================================================ -->
    <Style x:Key="IconTextButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="controls:HoverZoom.Enabled" Value="True"/>
        <Setter Property="controls:HoverZoom.Scale" Value="1.03"/>
        <Setter Property="controls:HoverZoom.DurationMs" Value="120"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <!-- O Padding fica no conteudo, NAO no Border: com ele no Border o
                         realce do hover (que mora dentro) nascia 10 px para dentro e as
                         bordas esquerda/direita do botao ficavam sem brilho. -->
                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" RenderTransformOrigin="0.5,0.5">
                        <Grid>
                            <!-- realce do hover: nao troca a cor da familia, so' clareia -->
                            <Border x:Name="hl" Background="#14FFFFFF" CornerRadius="7" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}">
                                <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{TemplateBinding Foreground}"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="hl" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SettingsCardStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Height" Value="75"/>
        <Setter Property="Margin" Value="0,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="controls:HoverZoom.Enabled" Value="True"/>
        <Setter Property="controls:HoverZoom.Scale" Value="1.01"/>
        <Setter Property="controls:HoverZoom.DurationMs" Value="200"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="cardBorder" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" RenderTransformOrigin="0.5,0.5" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="30"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#15000000" HorizontalAlignment="Left" BorderBrush="Transparent">
                                <TextBlock Text="{TemplateBinding Tag}" FontSize="20" VerticalAlignment="Center" HorizontalAlignment="Center" FontFamily="Segoe UI Emoji" TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="{TemplateBinding Content}" FontSize="15" FontWeight="SemiBold" TextElement.Foreground="{TemplateBinding Foreground}"/>
                                <TextBlock Text="{TemplateBinding ToolTip}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#x203A;" FontSize="24" VerticalAlignment="Center" Foreground="{DynamicResource TextGold}" HorizontalAlignment="Right" Margin="0,-4,0,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource CardHover}"/>
                            <Setter TargetName="cardBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="cardBorder" Property="Background" Value="{DynamicResource AccentColor}"/>
                            <Setter Property="Foreground" Value="Black"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
