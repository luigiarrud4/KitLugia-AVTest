<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Tipografia do KitLugia (docs/UI_CONSISTENCY_PLAN.md).

         Escala de 6 degraus. Use SEMPRE o token; nao escreva FontSize solto.

         QUIRK: os estilos ficam NESTE dicionario de proposito. Um
         {StaticResource FontSize*} dentro do Setter de um estilo declarado em
         OUTRO dicionario mesclado resolve para DependencyProperty.UnsetValue
         (o estilo aplica sem FontSize e o texto cai para 14). Aqui, no mesmo
         dicionario, a referencia resolve normalmente.
         ============================================================ -->

    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>   <!-- titulo de pagina -->
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>     <!-- titulo de bloco destacado -->
    <sys:Double x:Key="FontSizeSection">16</sys:Double>   <!-- cabecalho de secao -->
    <sys:Double x:Key="FontSizeBody">13</sys:Double>      <!-- texto corrido / subtitulo -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>     <!-- texto auxiliar -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>   <!-- badge / legenda / rodape -->

    <!-- Titulo de pagina -->
    <Style x:Key="PageTitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <!-- Subtitulo de pagina -->
    <Style x:Key="PageSubtitleStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Cabecalho de secao -->
    <Style x:Key="SectionHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SectionAccentHeaderStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <Style x:Key="SectionDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="PageDescriptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextDescription}"/>
        <Setter Property="Margin" Value="0,0,0,16"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Linha de item -->
    <Style x:Key="TweakLabelStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TweakStatusStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,10,0"/>
    </Style>

    <!-- Texto corrido -->
    <Style x:Key="TextBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextBodyMutedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="TextSmallStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TextCaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
