<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ============================================================
         Escala tipografica do KitLugia (docs/UI_CONSISTENCY_PLAN.md).
         6 degraus. Use SEMPRE estes tokens; nao escreva FontSize="13" solto.
         ============================================================ -->

    <sys:Double x:Key="FontSizeDisplay">28</sys:Double>   <!-- titulo de pagina -->
    <sys:Double x:Key="FontSizeTitle">18</sys:Double>     <!-- titulo de bloco destacado -->
    <sys:Double x:Key="FontSizeSection">16</sys:Double>   <!-- cabecalho de secao -->
    <sys:Double x:Key="FontSizeBody">13</sys:Double>      <!-- texto corrido / subtitulo -->
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>     <!-- texto auxiliar -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>   <!-- badge / legenda / rodape -->

    <!-- Texto corrido -->
    <Style x:Key="TextBodyStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Texto de apoio (subtitulo de pagina, rotulo de linha) -->
    <Style x:Key="TextBodyMutedStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Auxiliar -->
    <Style x:Key="TextSmallStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Legenda / badge / rodape -->
    <Style x:Key="TextCaptionStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

</ResourceDictionary>
