<Window x:Class="KitLugia.GUI.Windows.PresetsPersonalizadosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Presets Personalizados - Privacidade" Height="720" Width="1060" MinWidth="860"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Consolas, Segoe UI Emoji"
        TextElement.Foreground="White"
        Background="#0F0F0F"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Abas de nivel (Todos/Seguros/Moderados/Perigosos) -->
        <Style x:Key="LevelTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#E8B84E"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#E8B84E"/>
                                <Setter TargetName="bdr" Property="TextElement.Foreground" Value="#141414"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="#E8B84E"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F5C963"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#E8B84E" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header compacto (arrastavel) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎛️ Presets Personalizados" FontSize="15" FontWeight="SemiBold" Foreground="#E8B84E"/>
                    <TextBlock Text="clique na linha para marcar · desmarcado volta ao padr&#xE3;o do Windows" FontSize="10.5" Foreground="#777" Margin="10,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="BtnClose" Text="&#x2715;" FontSize="12" Foreground="#666"
                           Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                           MouseDown="BtnClose_MouseDown"/>
            </Grid>

            <!-- ABAS DE NIVEL + contador -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <RadioButton x:Name="TabAll" Content="Todos" Tag="All" GroupName="Levels" IsChecked="True"
                                 Style="{StaticResource LevelTab}" Checked="TabLevel_Checked"/>
                    <RadioButton x:Name="TabSafe" Content="&#x1F7E2; Seguros" Tag="Recommended" GroupName="Levels"
                                 Style="{StaticResource LevelTab}" Checked="TabLevel_Checked"/>
                    <RadioButton x:Name="TabModerate" Content="&#x1F7E1; Moderados" Tag="Limited" GroupName="Levels"
                                 Style="{StaticResource LevelTab}" Checked="TabLevel_Checked"/>
                    <RadioButton x:Name="TabDanger" Content="&#x1F534; Perigosos" Tag="NotRecommended" GroupName="Levels"
                                 Style="{StaticResource LevelTab}" Checked="TabLevel_Checked"/>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtPresetCount" Text="0 de 0 selecionados" VerticalAlignment="Center" Foreground="#E8B84E" FontWeight="Bold" FontSize="12"/>
            </Grid>

            <!-- Selecao rapida -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Apenas Seguros" Click="BtnPresetQuick_Click" Tag="Safe" Style="{StaticResource WinButton}" Margin="0,0,10,0"/>
                <Button Content="Seguros + Moderados" Click="BtnPresetQuick_Click" Tag="SafeModerate" Style="{StaticResource WinButton}" Margin="0,0,10,0"/>
                <Button Content="Marcar Tudo" Click="BtnPresetQuick_Click" Tag="All" Style="{StaticResource WinButton}" Margin="0,0,10,0"/>
                <Button Content="Limpar Sele&#xE7;&#xE3;o" Click="BtnPresetQuick_Click" Tag="None" Style="{StaticResource WinButton}" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtStatus" Text="" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11"/>
            </StackPanel>

            <!-- Lista compacta: 1 linha por item -->
            <Border Grid.Row="3" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList" ItemsSource="{Binding DisplayItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBrush}" CornerRadius="4" Padding="8,4" Margin="0,1"
                                        Cursor="Hand" MouseLeftButtonDown="ItemRow_MouseDown" ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="9,0,0,0" VerticalAlignment="Center" Fill="{Binding LevelBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Description}" FontSize="10.5" Foreground="#8A8A8A" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterNote" Text="" VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11" TextWrapping="Wrap"/>
                <Button Grid.Column="1" x:Name="BtnCancel" Content="CANCELAR" Click="BtnCancel_Click" Style="{StaticResource WinButton}" Height="38" MinWidth="110" Margin="0,0,10,0"/>
                <Button Grid.Column="2" x:Name="BtnApply" Content="APLICAR SELE&#xC7;&#xC3;O" Click="BtnApply_Click" Style="{StaticResource ApplyButton}" MinWidth="180"/>
            </Grid>
        </Grid>
    </Border>
</Window>
