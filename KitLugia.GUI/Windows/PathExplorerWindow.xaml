<Window x:Class="KitLugia.GUI.Windows.PathExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Explorador de PATH" Height="720" Width="1060" MinWidth="860"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Consolas, Segoe UI Emoji"
        TextElement.Foreground="White"
        Background="#0F0F0F"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource WinButton}">
            <Setter Property="Background" Value="#223322"/>
            <Setter Property="BorderBrush" Value="#2E7D32"/>
            <Setter Property="Foreground" Value="#A5D6A7"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,4"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#FFD700"/>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#FFD700" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧭 Explorador de PATH" FontSize="16" FontWeight="SemiBold" Foreground="#FFD700"/>
                    <TextBlock Text="O que o KitLugia enxerga e o que falta - adicione por item"
                               FontSize="11" Foreground="#777" Margin="12,4,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="BtnGuide" Text="&#x24D8;" FontSize="16" Foreground="#FFD700"
                               Cursor="Hand" Margin="0,0,12,0" VerticalAlignment="Center"
                               ToolTip="Guia do PATH: o que cada cor e aviso significa"
                               MouseDown="BtnGuide_MouseDown"/>
                    <TextBlock x:Name="BtnClose" Text="&#x2715;" FontSize="12" Foreground="#666"
                               Cursor="Hand" VerticalAlignment="Center" Margin="0,0,4,0"
                               MouseDown="BtnClose_MouseDown"/>
                </StackPanel>
            </Grid>

            <!-- Content: System | User -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== SYSTEM PATH ===== -->
                <Border Grid.Column="0" Background="#131313" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Margin="0,0,6,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="🖥️ PATH do SISTEMA"/>
                            <Button Style="{StaticResource WinButton}" Content="Copiar" FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Right" Click="BtnCopySystem_Click"/>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="TxtSystemRaw" Margin="0,6,0,0"
                                 Background="#0A0A0A" BorderBrush="#222" Foreground="#9CDCFE"
                                 FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                 IsReadOnly="True" IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" MaxHeight="64" AcceptsReturn="True"/>

                        <TextBlock Grid.Row="2" Text="Entradas atuais" FontSize="12" FontWeight="SemiBold" Foreground="#AAA" Margin="0,10,0,4"/>
                        <ListBox x:Name="SysEntriesList" Grid.Row="3" Margin="0,0,0,6"
                                 Background="#0A0A0A" BorderBrush="#222" Foreground="#E6E6E6" FontSize="11"
                                 MaxHeight="210" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{Binding Color}"
                                                   FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4" Text="Ausentes - recomendados adicionar" FontSize="12" FontWeight="SemiBold" Foreground="#AAA" Margin="0,6,0,4"/>
                        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                            <ItemsControl x:Name="SysMissingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151515" CornerRadius="5" BorderBrush="#2A2A2A" BorderThickness="1"
                                                Padding="8,6" Margin="2,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MaxWidth="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="150">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11.5" Foreground="#EEE" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="#888" TextWrapping="Wrap" MaxWidth="190"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="#9CDCFE"
                                                           FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Path}"/>
                                                <Button Grid.Column="2" Style="{StaticResource AddButton}" Content="➕ Adicionar"
                                                        Tag="{Binding}" Click="BtnAddSystem_Click" VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanAdd}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- ===== USER PATH ===== -->
                <Border Grid.Column="1" Background="#131313" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Margin="6,0,0,0">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="👤 PATH do USUÁRIO"/>
                            <Button Style="{StaticResource WinButton}" Content="Copiar" FontSize="11" Padding="8,3"
                                    HorizontalAlignment="Right" Click="BtnCopyUser_Click"/>
                        </Grid>

                        <TextBox Grid.Row="1" x:Name="TxtUserRaw" Margin="0,6,0,0"
                                 Background="#0A0A0A" BorderBrush="#222" Foreground="#9CDCFE"
                                 FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap"
                                 IsReadOnly="True" IsUndoEnabled="False" VerticalScrollBarVisibility="Auto" MaxHeight="64" AcceptsReturn="True"/>

                        <TextBlock Grid.Row="2" Text="Entradas atuais" FontSize="12" FontWeight="SemiBold" Foreground="#AAA" Margin="0,10,0,4"/>
                        <ListBox x:Name="UsrEntriesList" Grid.Row="3" Margin="0,0,0,6"
                                 Background="#0A0A0A" BorderBrush="#222" Foreground="#E6E6E6" FontSize="11"
                                 MaxHeight="210" VirtualizingStackPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid ToolTip="{Binding Detail}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Icon}" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="{Binding Color}"
                                                   FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="4" Text="Programas instalados ausentes do PATH" FontSize="12" FontWeight="SemiBold" Foreground="#AAA" Margin="0,6,0,4"/>
                        <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                            <ItemsControl x:Name="UsrMissingList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#151515" CornerRadius="5" BorderBrush="#2A2A2A" BorderThickness="1"
                                                Padding="8,6" Margin="2,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" MaxWidth="200"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Center" MinWidth="150">
                                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="11.5" Foreground="#EEE" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Detail}" FontSize="9.5" Foreground="#888" TextWrapping="Wrap" MaxWidth="190"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding Path}" Foreground="#9CDCFE"
                                                           FontFamily="Consolas" FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" ToolTip="{Binding Path}"/>
                                                <Button Grid.Column="2" Style="{StaticResource AddButton}" Content="➕ Adicionar"
                                                        Tag="{Binding}" Click="BtnAddUser_Click" VerticalAlignment="Center"
                                                        IsEnabled="{Binding CanAdd}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

            <!-- Footer -->
            <Grid Grid.Row="2">
                <TextBlock x:Name="TxtNote" FontSize="10.5" Foreground="#777" TextWrapping="Wrap"
                           VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="560"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource WinButton}" Content="⚙️ Abrir Editor do Windows..." Margin="0,0,8,0"
                            Click="BtnOpenSystemEnv_Click"/>
                    <Button Style="{StaticResource WinButton}" Content="Fechar" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>