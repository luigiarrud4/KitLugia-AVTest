<Window x:Class="KitLugia.GUI.Windows.ServicePresetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Perfil de Otimização de Serviços - KitLugia" Height="720" Width="1060" MinWidth="860"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Consolas, Segoe UI Emoji"
        TextElement.Foreground="White"
        Background="#0F0F0F"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="WinButton" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bdr" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ApplyButton" TargetType="Button">
            <Setter Property="Background" Value="#E8B84E"/>
            <Setter Property="Foreground" Value="#141414"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#F5C963"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="4"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="#E8B84E" BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header (arrastável) -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎛️ Perfil de Otimização de Serviços" FontSize="15" FontWeight="SemiBold" Foreground="#E8B84E"/>
                    <TextBlock Text="clique na linha para marcar · desmarcado volta ao padrão do Windows" FontSize="10.5" Foreground="#777" Margin="10,3,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="BtnClose" Text="✕" FontSize="12" Foreground="#666"
                           Cursor="Hand" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                           MouseDown="BtnClose_MouseDown"/>
            </Grid>

            <!-- Seleção de perfil + contagem -->
            <Grid Grid.Row="1" Margin="0,10,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CboPreset" Width="320" Height="34" FontSize="13" SelectionChanged="CboPreset_SelectionChanged">
                    <ComboBoxItem Content="🛡️ Seguro — Fax/Spooler/RetailDemo" Tag="Safe" IsSelected="True"/>
                    <ComboBoxItem Content="🎮 Gamer — Telemetria/SysMain/Xbox..." Tag="Gamer"/>
                    <ComboBoxItem Content="🚀 Gamer+ — Gamer + updaters de terceiros" Tag="GamerPlus"/>
                    <ComboBoxItem Content="⏪ Restaurar padrão (lista segura)" Tag="Restore"/>
                </ComboBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="15,0,0,0" VerticalAlignment="Center">
                    <Button Content="Marcar Tudo" Click="BtnQuick_Click" Tag="All" Style="{StaticResource WinButton}" Margin="0,0,8,0" Height="30" Padding="12,4"/>
                    <Button Content="Limpar Seleção" Click="BtnQuick_Click" Tag="None" Style="{StaticResource WinButton}" Height="30" Padding="12,4"/>
                </StackPanel>
                <TextBlock Grid.Column="2" x:Name="TxtPresetCount" Text="0 de 0" VerticalAlignment="Center" Foreground="#E8B84E" FontWeight="Bold" FontSize="12" Margin="12,0,0,0"/>
            </Grid>

            <!-- Descrição do perfil -->
            <Border Grid.Row="2" Background="#161616" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock x:Name="TxtPresetTitle" Text="" Foreground="#E8B84E" FontWeight="Bold" FontSize="13"/>
                    <TextBlock x:Name="TxtPresetDescription" Text="" Foreground="#999" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
            </Border>

            <!-- Lista: 1 linha por serviço, tooltip = o 'i' de informação -->
            <Border Grid.Row="3" Background="#121212" BorderBrush="#2A2A2A" BorderThickness="1" CornerRadius="8" Padding="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ItemsList" ItemsSource="{Binding DisplayItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding RowBrush}" CornerRadius="4" Padding="8,4" Margin="0,1"
                                        Cursor="Hand" MouseLeftButtonDown="ItemRow_MouseDown" ToolTip="{Binding Tooltip}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsDisabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                                        <Ellipse Grid.Column="1" Width="8" Height="8" Margin="9,0,0,0" VerticalAlignment="Center" Fill="{Binding LevelBrush}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding Display}" FontSize="11.5" FontWeight="SemiBold" Foreground="White" Margin="9,0,0,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Reason}" FontSize="10.5" Foreground="#8A8A8A" Margin="10,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="4" Text="{Binding StateText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="4,0,2,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- Footer -->
            <Grid Grid.Row="4" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtFooterNote" Text="ℹ️ Passe o mouse sobre um serviço para ver a explicação completa (o porquê + o que quebra)." VerticalAlignment="Center" Foreground="#A0A0A0" FontSize="11" TextWrapping="Wrap"/>
                <Button Grid.Column="1" Content="CANCELAR" Click="BtnCancel_Click" Style="{StaticResource WinButton}" Height="38" MinWidth="110" Margin="0,0,10,0"/>
                <Button Grid.Column="2" Content="APLICAR SELEÇÃO" Click="BtnApply_Click" Style="{StaticResource ApplyButton}" MinWidth="180"/>
            </Grid>
        </Grid>
    </Border>
</Window>
