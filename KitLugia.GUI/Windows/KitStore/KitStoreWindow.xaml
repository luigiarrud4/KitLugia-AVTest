<Window x:Class="KitLugia.GUI.Windows.KitStore.KitStoreWindow"
         xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         Title="Microsoft Store Remake — KitLugia" Height="820" Width="1360" MinWidth="1020" MinHeight="620"
         WindowStartupLocation="CenterScreen"
         Background="#202020"
         ShowInTaskbar="True"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Foreground="White">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="#2A2A2A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- DRAG BAR igual TaskManager -->
            <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" MouseLeftButtonDown="DragBar_MouseDown" Cursor="SizeAll">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Border Width="20" Height="20" CornerRadius="4" Background="#0F1A2E" BorderBrush="#0078D4" BorderThickness="1">
                            <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Microsoft Store Remake" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text=" — KitLugia" FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Cursor="Hand" Click="BtnMinimize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#333333"/></Trigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Cursor="Hand" Click="BtnMaximize_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock x:Name="IconMaximize" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#333333"/></Trigger></Style.Triggers></Style></Button.Style>
                        </Button>
                        <Button Width="46" Height="40" Background="Transparent" BorderThickness="0" Foreground="#CCCCCC" Cursor="Hand" Click="BtnClose_Click" WindowChrome.IsHitTestVisibleInChrome="True">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button.Style><Style TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E81123"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Frame x:Name="MainFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="#1A1A1A"/>
        </Grid>
    </Border>
</Window>
