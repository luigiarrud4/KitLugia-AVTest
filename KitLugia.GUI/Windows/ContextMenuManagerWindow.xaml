<Window x:Class="KitLugia.GUI.Windows.ContextMenuManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador de Menu de Contexto"
        Width="700" Height="550"
        WindowStartupLocation="CenterOwner"
        Background="#0D0D1A"
        FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="EntryListBoxStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#12122A" Padding="20,16" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#x1F4CB;" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Menu de Contexto" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Gerencie todas as entradas do clique direito do Explorer" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="&#x2715;" Width="32" Height="32"
                        Background="Transparent" Foreground="#888" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- TOOLBAR -->
        <Border Grid.Row="1" Background="#14142A" Padding="20,10" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Content="&#x1F504; Atualizar" Width="100" Height="32"
                        Background="#222244" Foreground="#AAA" BorderThickness="0"
                        Cursor="Hand" Click="BtnRefresh_Click" Margin="0,0,8,0"/>

                <TextBlock x:Name="TxtEntryCount" Grid.Column="1" Text="0 entradas encontradas"
                           FontSize="12" Foreground="#888" VerticalAlignment="Center" Margin="8,0,0,0"/>

                <Button Grid.Column="2" Content="&#x1F5D1; Remover Selecionadas" Width="170" Height="32"
                        Background="#AA3333" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnRemoveSelected_Click"
                        x:Name="BtnRemove"/>
            </Grid>
        </Border>

        <!-- FILTER -->
        <Border Grid.Row="2" x:Name="FilterBar" Background="#0D0D1A" Padding="20,8" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Filtrar:" Foreground="#888" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <RadioButton x:Name="RdAll" Content="Todas" Foreground="#AAA" FontSize="12" IsChecked="True"
                             Margin="0,0,12,0" Click="Filter_Changed"/>
                <RadioButton x:Name="RdKit" Content="KitLugia" Foreground="#8888CC" FontSize="12"
                             Margin="0,0,12,0" Click="Filter_Changed"/>
                <RadioButton x:Name="RdThirdParty" Content="Terceiros" Foreground="#FFAA44" FontSize="12"
                             Margin="0,0,12,0" Click="Filter_Changed"/>
                <RadioButton x:Name="RdSystem" Content="Sistema" Foreground="#44AA88" FontSize="12"
                             Margin="0,0,12,0" Click="Filter_Changed"/>
            </StackPanel>
        </Border>

        <!-- ENTRIES LIST -->
        <Border Grid.Row="2" x:Name="ListPanel" Background="#0D0D1A" Padding="20,8">
            <ListBox x:Name="EntryList"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource EntryListBoxStyle}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="8" Background="#16162A" BorderBrush="#2A2A40" BorderThickness="1"
                                Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                          VerticalAlignment="Top" Margin="0,2,12,0"
                                          Foreground="#AAA"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                        <Border Grid.Column="2" CornerRadius="4"
                                                Background="#222244" Padding="6,2" Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Root}" FontSize="10"
                                                       Foreground="#8888CC"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Command}" FontSize="11"
                                               Foreground="#666" Margin="0,2,0,0" TextWrapping="Wrap"
                                               MaxHeight="28"/>
                                </StackPanel>

                                <Border Grid.Column="2" CornerRadius="4" Padding="6,2"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1A1A28"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsKitEntry}" Value="True">
                                                    <Setter Property="Background" Value="#1A2A1A"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Terceiro"/>
                                                <Setter Property="Foreground" Value="#FFAA44"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKitEntry}" Value="True">
                                                        <Setter Property="Text" Value="KitLugia"/>
                                                        <Setter Property="Foreground" Value="#88CC88"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- BOTTOM STATUS -->
        <Border Grid.Row="3" Background="#0A0A18" Padding="20,8" BorderBrush="#3A3A50" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtStatus" Text="Clique em Atualizar para carregar as entradas" FontSize="11" Foreground="#555"/>
        </Border>
    </Grid>
</Window>
