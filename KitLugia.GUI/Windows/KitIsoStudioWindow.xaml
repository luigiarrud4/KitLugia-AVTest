<Window x:Class="KitLugia.GUI.Windows.KitIsoStudioWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIT ISO STUDIO — Expansor" Height="740" Width="1060" MinWidth="960" MinHeight="640"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        WindowStartupLocation="CenterOwner"
        TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji"
        TextElement.Foreground="White"
        Background="#0F0F0F"
        ShowInTaskbar="False"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="StudioCard" TargetType="Border">
            <Setter Property="Background" Value="#131313"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>
        <Style x:Key="StudioSectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFD700"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>
        <Style x:Key="StudioDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="LineHeight" Value="14"/>
        </Style>
        <Style x:Key="StudioCheck" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,12,7"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="StudioTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#2A2A2A"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}" Margin="0,0,4,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#FFD700"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#FFD700"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border BorderBrush="#FFD700" BorderThickness="1" CornerRadius="0">
        <Grid Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header nítido - arrastável como KitLugia Spy -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧬" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="KIT ISO STUDIO" FontSize="18" FontWeight="ExtraBold" Foreground="#FFD700" VerticalAlignment="Center" TextOptions.TextFormattingMode="Display"/>
                        <Border Background="#FFD700" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="EXPANSOR" FontSize="9" FontWeight="Bold" Foreground="Black" TextOptions.TextFormattingMode="Display"/>
                        </Border>
                        <Border Background="#1A1A1A" CornerRadius="4" BorderBrush="#333" BorderThickness="1" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ wimlib + pnputil + oscdimg — nativo, sem DISM" FontSize="10" Foreground="#4CAF50" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Expansor integrado — foge do estilo do kit para caber dezenas de personalizações reais da ISO. Encha com o máximo de configurações." FontSize="11" Foreground="#CCCCCC" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="15"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="↔" Width="32" Height="32" Click="BtnToggleMaximize_Click" Background="#2A2A2A" Foreground="#AAA" BorderBrush="#333" BorderThickness="1" Cursor="Hand" FontSize="12" Margin="0,0,8,0" ToolTip="Esticar/Restaurar janela (como Spy)"/>
                    <TextBlock Text="ⓘ" FontSize="16" Foreground="#FFD700" Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="Use abas para organizar. Tudo roda offline via wimlib (sem montar) + pnputil + registry offline. Rápido como PathManager."/>
                    <Button Content="✕" Width="32" Height="32" Click="BtnClose_Click" Background="#1A1A1A" Foreground="White" BorderBrush="#333" BorderThickness="1" Cursor="Hand" FontSize="14" ToolTip="Fechar">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#333"/>
                                        <Setter TargetName="bdr" Property="BorderBrush" Value="#FFD700"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Tabs expansor completo -->
            <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0">
                <!-- ABA 1: AppX & Bloat -->
                <TabItem Header="🧩 AppX (40+)" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="Remoção granular — cada pacote é opcional (wimlib dir + update delete --recursive)" Style="{StaticResource StudioSectionTitle}"/>
                                    <TextBlock Text="Muito além do preset único. Cada CheckBox vira um wimlib update delete + registro Deprovisioned offline. Rápido, sem montar." Style="{StaticResource StudioDesc}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Copilot" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Xbox App" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Xbox Overlay" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Clipchamp" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Bing Search" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Bing News" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Solitaire" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Phone Link / YourPhone" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Teams" IsChecked="False" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Cortana (549981C3F5F10)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Maps" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="OneDrive Sync" IsChecked="False" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="People" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="GetStarted / GetHelp" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Alarms/Calculator/Camera" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Photos / Scan / Sketch" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Feedback Hub" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Paint 3D / 3D Viewer" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button Content="✅ Marcar 40+" Height="28" Width="110" Click="BtnApplyDebloat_Click" Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1"/>
                                        <Button Content="Desmarcar tudo" Height="28" Width="120" Margin="8,0,0,0" Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🗂️ Support &amp; Store" Style="{StaticResource StudioSectionTitle}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Remover Support\" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="RemoveDefaultStorePackages (política 24H2)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Ei.cfg Retail genérico" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ABA 2: Registro & IA -->
                <TabItem Header="🔧 Registro &amp; IA" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="IA &amp; Copilot/Recall (registro offline, sem DISM)" Style="{StaticResource StudioSectionTitle}"/>
                                    <TextBlock Text="TurnOffWindowsCopilot + DisableAIDataAnalysis + AllowRecallEnablement=0 — 24H2/25H2 via wimlib." Style="{StaticResource StudioDesc}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Desabilitar Copilot" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar Recall (DisableAIDataAnalysis)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Remover AI (tudo)" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🛡️ Sistema &amp; Privacidade" Style="{StaticResource StudioSectionTitle}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Bypass TPM/CPU/RAM/SecureBoot (LabConfig)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar Telemetria (AllowTelemetry 0)" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar BitLocker auto" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Reserved Storage OFF" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar Sponsored Apps (CloudContent)" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar Chat/Teams ChatIcon 3" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="📝 Registro custom (.reg) — injetado offline via wimlib" Style="{StaticResource StudioSectionTitle}"/>
                                    <TextBox x:Name="TxtReg" Height="110" AcceptsReturn="True" TextWrapping="Wrap" Background="#0A0A0A" Foreground="#E0E0E0" BorderBrush="#2A2A2A" BorderThickness="1" FontFamily="Consolas" FontSize="11" Padding="8" VerticalScrollBarVisibility="Auto" Text="Windows Registry Editor Version 5.00&#x0a;&#x0a;[HKEY_LOCAL_MACHINE\SOFTWARE\Exemplo]&#x0a;&quot;Valor&quot;=dword:00000001"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button Content="Importar .reg" Width="110" Height="28" Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1"/>
                                        <Button Content="Limpar" Width="80" Height="28" Margin="8,0,0,0" Background="#2A2A2A" Foreground="White" BorderBrush="#444" BorderThickness="1"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ABA 3: Drivers & Boot -->
                <TabItem Header="💾 Drivers &amp; Boot" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="Drivers — export direto via pnputil /export-driver + $WinPEDriver$" Style="{StaticResource StudioSectionTitle}"/>
                                    <TextBlock Text="Método MS Learn nativo: o Setup.exe do WinPE injeta automaticamente no driverstore. Mais rápido que DISM." Style="{StaticResource StudioDesc}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtDriverFolder" IsReadOnly="True" Text="Nenhuma pasta selecionada" Background="#0A0A0A" Foreground="#888" BorderBrush="#2A2A2A" Padding="8" Height="30" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="📁" Width="36" Height="30" Margin="6,0,0,0" Click="BtnPickDriverFolder_Click" Background="#1A1A1A" BorderBrush="#FFD700" Foreground="#FFD700"/>
                                    </Grid>
                                    <CheckBox x:Name="ChkInjectDrivers" Content="Injetar drivers desta pasta na ISO" Margin="0,10,0,0" Foreground="White" FontSize="11.5"/>
                                    <CheckBox Content="Forçar boot duplo BIOS+UEFI (oscdimg -m -o -u2)" IsChecked="True" Margin="0,6,0,0" Foreground="White" FontSize="11.5"/>
                                    <TextBlock Text="Compatível com Secure Boot bypass via $WinPEDriver$ — não toca no boot.wim." FontSize="10" Foreground="#666" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🕒 WinPE &amp; SetupComplete" Style="{StaticResource StudioSectionTitle}"/>
                                    <CheckBox Content="SetupComplete.cmd pós-setup (SYSTEM, lança KitLugia no 1º boot)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                    <CheckBox Content="Fix ConX Legacy 24H2/25H2 (winpeshl.ini → setup.exe /legacy no boot.wim)" Style="{StaticResource StudioCheck}"/>
                                    <CheckBox Content="wimlib optimize (remove buracos, sem recompressão, segundos)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ABA 4: Sistema -->
                <TabItem Header="🌐 Sistema" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="Idioma, Região &amp; Edição" Style="{StaticResource StudioSectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="Idioma base" Foreground="#AAA" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" SelectedIndex="0">
                                                <ComboBoxItem Content="pt-BR — Português Brasil"/>
                                                <ComboBoxItem Content="en-US — English"/>
                                                <ComboBoxItem Content="es-ES — Español"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,6,0">
                                            <TextBlock Text="TimeZone" Foreground="#AAA" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" SelectedIndex="0">
                                                <ComboBoxItem Content="E. South America Standard Time"/>
                                                <ComboBoxItem Content="Eastern Standard Time (US)"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="6,0,0,0">
                                            <TextBlock Text="Edição a manter (strip)" Foreground="#AAA" FontSize="10" Margin="0,0,0,4"/>
                                            <ComboBox Height="30" SelectedIndex="0">
                                                <ComboBoxItem Content="Manter todas"/>
                                                <ComboBoxItem Content="Apenas Pro"/>
                                                <ComboBoxItem Content="Apenas Home"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="Adicionar pacote de idioma pt-BR se faltar (lp.cab offline)" Margin="0,10,0,0" Foreground="White" FontSize="11.5"/>
                                    <CheckBox Content="Manter apenas 1 edição + LZX (recomendado, rápido) — export wimlib" IsChecked="True" Margin="0,6,0,0" Foreground="White" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🏷️ OEM Branding &amp; $OEM$" Style="{StaticResource StudioSectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="Fabricante" Background="#0A0A0A" Foreground="White" BorderBrush="#2A2A2A" Padding="8" Height="30" Margin="0,0,6,0"/>
                                        <TextBox Grid.Column="1" Text="Modelo" Background="#0A0A0A" Foreground="White" BorderBrush="#2A2A2A" Padding="8" Height="30" Margin="6,0,0,0"/>
                                    </Grid>
                                    <TextBox Text="URL de suporte" Background="#0A0A0A" Foreground="White" BorderBrush="#2A2A2A" Padding="8" Height="30" Margin="0,8,0,0"/>
                                    <CheckBox Content="Adicionar $OEM$ com scripts pós-instalação" Margin="0,8,0,0" Foreground="White" FontSize="11.5"/>
                                    <CheckBox Content="Ei.cfg Retail genérico (desbloqueia todas as edições na seleção)" IsChecked="True" Margin="0,6,0,0" Foreground="White" FontSize="11.5"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🔧 Serviços &amp; Tarefas" Style="{StaticResource StudioSectionTitle}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Desabilitar DiagTrack" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Remover WaaSMedic/UpdateAssistant tasks" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Desabilitar Teams auto-install" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Prevenir Outlook novo" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ABA 5: Phobos (inspirado na ISO Phobos11) -->
                <TabItem Header="👻 Phobos" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="Análise Phobos11 (7.07GB) — customização leve que dá para adicionar ao kit" Style="{StaticResource StudioSectionTitle}"/>
                                    <TextBlock Text="autounattend.xml do Phobos: Admin/Administrators sem senha, ComputerName PHOBOS, RegisteredOwner Phobos11 / XPower7125, OOBE HideEULA/HideOnline/HideWireless SkipMachineOOBE. install.wim 6.45GB boot.wim 0.55GB, sem $OEM$." Style="{StaticResource StudioDesc}" Foreground="#CCCCCC"/>
                                    <WrapPanel>
                                        <CheckBox Content="Criar usuário Admin (PHOBOS)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Hostname PHOBOS" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="OEM XPower7125" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Skip OOBE (HideEULA/Online/Wireless)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Dica: Phobos é minimalista — dá para expandir com os 40+ AppX + $WinPEDriver$ + registro offline do Studio para uma ISO bem mais customizada e rápida." FontSize="10" Foreground="#666" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ABA 6: Avançado -->
                <TabItem Header="⚡ Avançado" Style="{StaticResource StudioTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,10,6,0">
                        <StackPanel>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="Nativas ultrarrápidas do kit (por que é rápido)" Style="{StaticResource StudioSectionTitle}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,6,0">
                                            <TextBlock Text="✓ wimlib-imagex" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="dir / export / update delete --recursive / extract --dest-dir / optimize (sem --compress). Tudo sem montar, sem DISM." Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                                            <TextBlock Text="✓ oscdimg" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" Margin="0,6,0,0"/>
                                            <TextBlock Text="Cria ISO bootável BIOS+UEFI dual (-m -o -u2 -udfver102) em 11s para 7GB." Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="✓ pnputil + registry offline" Foreground="#4CAF50" FontWeight="Bold" FontSize="11"/>
                                            <TextBlock Text="pnputil /export-driver + reg load HKLM\z... (SYSTEM/SOFTWARE/DEFAULT/NTUSER) + wimlib re-inject. 1-2s por hive." Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                                            <TextBlock Text="✓ IOCTL nativo" Foreground="#4CAF50" FontWeight="Bold" FontSize="11" Margin="0,6,0,0"/>
                                            <TextBlock Text="GetDisks via IOCTL 0x70050 em 18ms vs WMI 340ms. Usado no WinBoot." Foreground="#888" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StudioCard}">
                                <StackPanel>
                                    <TextBlock Text="🔍 O que dá para fazer com ISO (checklist completo)" Style="{StaticResource StudioSectionTitle}"/>
                                    <WrapPanel>
                                        <CheckBox Content="Strip edição (export 1 imagem)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Compressão LZX/LZMS" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Debloat AppX granular" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Tweaks de registro (LabConfig, CloudContent, etc)" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Drivers $WinPEDriver$" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Arquivos soltos $OEM$/autounattend" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="SetupComplete pós-setup" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Fix ConX /legacy" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="OEM branding" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Idioma/Timezone" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="Tarefas agendadas" IsChecked="True" Style="{StaticResource StudioCheck}"/>
                                        <CheckBox Content="WinSxS optimize" Style="{StaticResource StudioCheck}"/>
                                    </WrapPanel>
                                    <TextBlock Text="Tudo aqui é aplicado no fluxo nativo em ~2min para ISO 7GB (vs 5min DISM). Veja Log Detalhado no painel padrão." FontSize="10" Foreground="#666" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#0F0F0F" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="#2A2A2A" BorderThickness="1">
                <Grid>
