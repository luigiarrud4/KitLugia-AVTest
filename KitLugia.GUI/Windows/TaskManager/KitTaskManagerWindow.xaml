                    <!-- Cabeçalho -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <!-- 2 colunas: antes o título/subtítulo/status e a barra de intervalo+botões
                             dividiam a MESMA célula, e o status longo ("Atualizando a cada 1s · ...")
                             passava por baixo dos botões. Com coluna própria + TextTrimming eles
                             nunca mais se cruzam. -->
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
