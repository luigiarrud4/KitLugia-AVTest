<Window x:Class="KitLugia.GUI.Windows.TaskManager.KitTaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gerenciador de Tarefas - KIT LUGIA" Height="780" Width="1300" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#111823"
        WindowStyle="None"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="False"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Foreground="White"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ══ ToolTip de INFORMAÇÃO (mesmo balão das páginas Tweaks/GameBoost) ══
             Usado pela aba Latência: passar o mouse e ESPERAR um pouco mostra a
             explicação completa (o que aconteceu, quem causou, por que e o que fazer).
             InitialShowDelay maior = o balão só aparece quando você realmente quer. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111823"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

        <!-- ToolTip que QUEBRA LINHA (para textos longos da aba Latência).
             Fica com chave para não afetar os balões que já contam conteúdo rico
             (StackPanel com seções), como os das páginas Tweaks/GameBoost. -->
        <Style x:Key="InfoTipWrap" TargetType="ToolTip">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aba Usuários: cada linha expande para mostrar os processos do usuário
             (o DataGridRow.DetailsVisibility segue o IsExpanded do item). -->
        <Style x:Key="UserRowStyle" TargetType="DataGridRow">
            <Setter Property="DetailsVisibility" Value="{Binding DetailsVisibility}"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#26262C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17324F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de toolbar padrão (Serviços/Inicialização) — mesmo visual da aba Processos -->
        <Style x:Key="TmToolButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="#1F2A3A" BorderBrush="#2C3A4E" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center" TextBlock.Foreground="White"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#33333C"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#3A4C66"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid escuro padrão das tabelas de diagnóstico (aba Latência) -->
        <Style x:Key="TmGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#141C28"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#161F2C"/>
                        <Setter Property="Foreground" Value="#999"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,6"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#333"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#DDD"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#26262B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#33445A"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menu de contexto escuro padrão -->
        <Style x:Key="TmDarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#141C28"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TmMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Icon}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#243040"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#555"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#1F2A3A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ===== DRAG BAR + SEARCH + WINDOW BUTTONS ===== -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#111823" Cursor="SizeAll"
                    MouseLeftButtonDown="DragBar_MouseDown" BorderBrush="#1F2A3A" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="58"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                            <TextBlock Text="Gerenciador de Tarefas" FontSize="14" FontWeight="SemiBold" Foreground="#CCCCCC" VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <Border x:Name="SearchBorder" Background="#1F2A3A" BorderBrush="#2C3A4E" BorderThickness="1" CornerRadius="6" Height="28" MinWidth="300" Padding="8,0"
                                    MouseLeftButtonDown="SearchBar_MouseDown" MouseLeftButtonUp="SearchBar_MouseUp" Cursor="IBeam">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="&#x1F50D;" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#888"/>
                                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" VerticalAlignment="Center" FontSize="12" CaretBrush="White" TextChanged="TxtSearch_TextChanged"/>
                                    <TextBlock Grid.Column="1" Text="Buscar processo, PID ou caminho..." Foreground="#555" FontSize="11" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,4,0" MouseLeftButtonDown="WindowControls_MouseDown">
                            <Button x:Name="BtnRefresh" Width="42" Height="30" Click="BtnRefresh_Click" Cursor="Hand" ToolTip="Atualizar processos (F5)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="Transparent" CornerRadius="4">
                                            <TextBlock Text="&#x21BB;" FontSize="16" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#224FC3F7"/></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#554FC3F7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button x:Name="BtnExport" Width="42" Height="30" Click="BtnExport_Click" Cursor="Hand" ToolTip="Exportar para CSV">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="Transparent" CornerRadius="4">
                                            <TextBlock Text="&#x2B07;" FontSize="16" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#224FC3F7"/></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#554FC3F7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="42" Height="30" Click="BtnToggleMaximize_Click" Cursor="Hand" ToolTip="Maximizar/Restaurar">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="Transparent"><TextBlock Text="&#x25A1;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#33FFFFFF"/></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#55FFFFFF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <Button Width="42" Height="30" Click="BtnClose_Click" Cursor="Hand" ToolTip="Fechar (Esc)">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bdr" Background="Transparent"><TextBlock Text="&#x2715;" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#C42B1C"/></Trigger>
                                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#E81123"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ===== SIDEBAR ===== -->
            <Border Grid.Row="1" Grid.Column="0" Background="#111823" BorderBrush="#1F2A3A" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,8,0,0">
                    <!-- SUMMARY TAB (abertura estilo TMOG) -->
                    <Button x:Name="BtnTabSummary" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Summary" ToolTip="Resumo">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x2302;" FontSize="17" Foreground="#4FC3F7" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Resumo" FontSize="8" Foreground="#4FC3F7" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1C2634"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- PROCESSES TAB -->
                    <Button x:Name="BtnTabProcesses" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Processes" ToolTip="Processos">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x25A3;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Processos" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1C2634"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#26334A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- PERFORMANCE TAB -->
                    <Button x:Name="BtnTabPerformance" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Performance" ToolTip="Performance">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x2589;&#x2589;" FontSize="14" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Perf" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1C2634"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#26334A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- SERVICES TAB -->
                    <Button x:Name="BtnTabServices" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Services" ToolTip="Serviços">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x2699;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Svc" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1C2634"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#26334A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- USERS TAB -->
                    <Button x:Name="BtnTabUsers" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Users" ToolTip="Usuários">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x1F464;" FontSize="16" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Users" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1C2634"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#26334A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- CONNECTIONS TAB (TCP/UDP por processo, estilo TMOG) -->
                    <Button x:Name="BtnTabConnections" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Connections" ToolTip="Conexões">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x21C4;" FontSize="17" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Rede" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1C2634"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- LATENCY TAB (escuta do sistema: DPC/ISR, paginação, travamentos) -->
                    <Button x:Name="BtnTabLatency" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Latency" ToolTip="Latência — descubra o que travou e por quê">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x2248;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Latência" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1C2634"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- STORAGE TAB (diagnóstico de armazenamento: quem está saturando o disco) -->
                    <Button x:Name="BtnTabStorage" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Storage" ToolTip="Armazenamento — descubra o que está saturando o disco">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x1F4BE;" FontSize="15" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Disco" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1C2634"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <!-- STARTUP TAB -->
                    <Button x:Name="BtnTabStartup" Width="60" Height="52" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="SwitchTab" Tag="Startup" ToolTip="Inicialização">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bdr" Background="Transparent" Padding="4,4" CornerRadius="6" Margin="4,1">
                                    <Grid>
                                        <Border x:Name="Indicator" Visibility="Collapsed" CornerRadius="2" Width="3" Height="26" HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4FC3F7" Offset="0"/><GradientStop Color="#2196F3" Offset="1"/></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock x:Name="Icon" Text="&#x26A1;" FontSize="18" Foreground="#888" HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="Label" Text="Init" FontSize="8" Foreground="#888" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#1C2634"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bdr" Property="Background" Value="#26334A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ===== MAIN CONTENT ===== -->
            <Grid Grid.Row="1" Grid.Column="1" Background="#111823">

            <!-- ═══ TAB: RESUMO (painel de abertura estilo TMOG) ═══ -->
                <Grid x:Name="TabSummary" Visibility="Visible" Margin="14,12,14,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Resumo" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock x:Name="TxtSumSubtitle" Text="Visão geral do sistema em tempo real" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Intervalo:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox x:Name="CmbSummaryInterval" Width="80" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" FontSize="11" SelectedIndex="0" SelectionChanged="CmbSummaryInterval_Changed">
                                <ComboBoxItem Content="1s"/><ComboBoxItem Content="2s"/><ComboBoxItem Content="3s"/><ComboBoxItem Content="5s"/>
                            </ComboBox>
                            <Button Content="📋 Copiar" Height="26" Margin="8,0,0,0" Padding="10,0" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" Cursor="Hand" Click="BtnSummaryCopy_Click" ToolTip="Copiar o resumo para a área de transferência"/>
                            <Button Content="⚡ resmon" Height="26" Margin="6,0,0,0" Padding="10,0" Background="#1F2A3A" Foreground="#4FC3F7" BorderBrush="#2C3A4E" BorderThickness="1" Cursor="Hand" Click="BtnPerfResmon_Click" ToolTip="Abrir Monitor de Recursos"/>
                        </StackPanel>
                    </Grid>

                    <!-- Miolo: vitais | gráficos | top processos -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="238" MinWidth="200"/>
                            <ColumnDefinition Width="*" MinWidth="300"/>
                            <ColumnDefinition Width="330" MinWidth="250"/>
                        </Grid.ColumnDefinitions>

                        <!-- VITAIS -->
                        <Border Grid.Column="0" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="SISTEMA" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,10"/>

                                <TextBlock Text="CPU" FontSize="10" Foreground="#777"/>
                                <TextBlock x:Name="TxtSumCpu" Text="—" FontSize="19" FontWeight="Bold" Foreground="#4CAF50"/>
                                <Border Height="5" Background="#0E141B" CornerRadius="2" Margin="0,3,0,10">
                                    <Border x:Name="BarSumCpu" HorizontalAlignment="Left" Width="0" Background="#4CAF50" CornerRadius="2"/>
                                </Border>

                                <TextBlock Text="Relógio" FontSize="10" Foreground="#777"/>
                                <TextBlock x:Name="TxtSumClock" Text="—" FontSize="17" FontWeight="Bold" Foreground="#DDD"/>
                                <Border Height="5" Background="#0E141B" CornerRadius="2" Margin="0,3,0,10">
                                    <Border x:Name="BarSumClock" HorizontalAlignment="Left" Width="0" Background="#7E57C2" CornerRadius="2"/>
                                </Border>

                                <TextBlock Text="Temperatura" FontSize="10" Foreground="#777"/>
                                <TextBlock x:Name="TxtSumTemp" Text="—" FontSize="17" FontWeight="Bold" Foreground="#FF9800"/>
                                <Border Height="5" Background="#0E141B" CornerRadius="2" Margin="0,3,0,10">
                                    <Border x:Name="BarSumTemp" HorizontalAlignment="Left" Width="0" Background="#FF9800" CornerRadius="2"/>
                                </Border>

                                <TextBlock Text="GPU" FontSize="10" Foreground="#777"/>
                                <TextBlock x:Name="TxtSumGpu" Text="—" FontSize="17" FontWeight="Bold" Foreground="#2196F3"/>
                                <Border Height="5" Background="#0E141B" CornerRadius="2" Margin="0,3,0,10">
                                    <Border x:Name="BarSumGpu" HorizontalAlignment="Left" Width="0" Background="#2196F3" CornerRadius="2"/>
                                </Border>

                                <TextBlock Text="Potência" FontSize="10" Foreground="#777"/>
                                <TextBlock x:Name="TxtSumPower" Text="—" FontSize="17" FontWeight="Bold" Foreground="#F44336"/>
                                <Border Height="5" Background="#0E141B" CornerRadius="2" Margin="0,3,0,0">
                                    <Border x:Name="BarSumPower" HorizontalAlignment="Left" Width="0" Background="#F44336" CornerRadius="2"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- GRÁFICOS -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- CPU -->
                            <Border Grid.Row="0" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CPU" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TxtSumCpuCores" Text="" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Ellipse Width="7" Height="7" Fill="#4CAF50" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Uso" FontSize="10" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#F44336" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Kernel" FontSize="10" Foreground="#888" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <Ellipse Width="7" Height="7" Fill="#FF9800" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                            <TextBlock Text="Temp" FontSize="10" Foreground="#888" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Grid.Row="1" Margin="0,6,0,6" MinHeight="110">
                                        <Canvas x:Name="SumCpuCanvas" Background="#0E141B" ClipToBounds="True"/>
                                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,8,0">
                                            <TextBlock x:Name="TxtSumCpuBig" Text="—" FontSize="26" FontWeight="Bold" Foreground="#4CAF50" HorizontalAlignment="Right"/>
                                            <TextBlock x:Name="TxtSumCpuSub" Text="" FontSize="10" Foreground="#777" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Grid.Row="2" x:Name="TxtSumCpuFooter" Text="" FontSize="10" Foreground="#666"/>
                                </Grid>
                            </Border>

                            <!-- NÚCLEOS (paridade TMOG "CPU Expandida") -->
                            <Border Grid.Row="1" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock Text="NÚCLEOS" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                                        <TextBlock x:Name="TxtSumCoresInfo" Text="" FontSize="10" Foreground="#666" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="PnlCores" Orientation="Horizontal"/>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <!-- MEMÓRIA -->
                            <Border Grid.Row="2" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,8,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <Grid>
                                            <TextBlock Text="MEMÓRIA" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" HorizontalAlignment="Left"/>
                                            <TextBlock x:Name="TxtSumMemPctBig" Text="" FontSize="14" FontWeight="Bold" Foreground="#B36AE2" HorizontalAlignment="Right" Margin="0,0,10,0"/>
                                        </Grid>
                                        <!-- Gráfico grande de RAM (paridade com o "Memory Utilization" do TMOG) -->
                                        <Canvas x:Name="SumMemCanvas" Height="86" Background="#121212" Margin="0,6,10,0" ClipToBounds="True">
                                            <Canvas.ToolTip>
                                                <ToolTip Background="#0D131A" BorderBrush="#2C3A4E" BorderThickness="1" Padding="10">
                                                    <StackPanel MaxWidth="420">
                                                        <TextBlock Text="RAM AO LONGO DO TEMPO" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                                                        <TextBlock x:Name="TxtSumMemTip" Text="" FontSize="11" Foreground="#DDD" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        <TextBlock Text="O gráfico mostra a última 1 minuto (1 amostra por segundo). A linha sobe quando programas pedem mais RAM. Se ela encostar no topo e o disco começar a trabalhar, o Windows está paginando (usando o arquivo de paginação) e os programas engasgam." FontSize="10" Foreground="#999" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </Canvas.ToolTip>
                                        </Canvas>
                                        <!-- Barra de composição da RAM: em uso / em cache / livre -->
                                        <Border Height="14" Background="#0E141B" CornerRadius="3" Margin="0,6,10,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition x:Name="ColMemUsed" Width="*"/>
                                                    <ColumnDefinition x:Name="ColMemCache" Width="0"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="BarMemUsed" Grid.Column="0" Background="#B36AE2" CornerRadius="3,0,0,3" Margin="0,0,1,0"/>
                                                <Border x:Name="BarMemCache" Grid.Column="1" Background="#4A6FA5" CornerRadius="0" Margin="0,0,1,0"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="TxtSumMemUsed" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="#B36AE2" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" MinWidth="230">
                                        <TextBlock x:Name="TxtSumMemAvail" Text="" FontSize="10" Foreground="#AAA" Margin="0,20,0,0"/>
                                        <TextBlock x:Name="TxtSumMemCache" Text="" FontSize="10" Foreground="#AAA" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="TxtSumMemSwap" Text="" FontSize="10" Foreground="#AAA" Margin="0,3,0,0">
                                            <TextBlock.ToolTip>
                                                <ToolTip Background="#0D131A" BorderBrush="#2C3A4E" BorderThickness="1" Padding="10">
                                                    <StackPanel MaxWidth="380">
                                                        <TextBlock Text="ARQUIVO DE PAGINAÇÃO (swap)" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                                                        <TextBlock Text="É a parte do disco que o Windows usa como RAM extra. Enquanto estiver baixo, nada a temer — o Windows só coloca ali o que não está sendo usado." FontSize="10" Foreground="#999" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                                        <TextBlock Text="" FontSize="10" Foreground="#999"/>
                                                        <TextBlock Text="Se ele crescer junto com a paginação do disco (aba Latência), a RAM está apertada de verdade: aí sim vale fechar programas ou aumentar a memória." FontSize="10" Foreground="#999" TextWrapping="Wrap"/>
                                                    </StackPanel>
                                                </ToolTip>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                        <TextBlock x:Name="TxtSumMemCommit" Text="" FontSize="10" Foreground="#AAA" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="TxtSumMemPools" Text="" FontSize="10" Foreground="#AAA" Margin="0,3,0,0"/>
                                        <TextBlock x:Name="TxtSumMemMeta" Text="" FontSize="10" Foreground="#666" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- TOP PROCESSOS POR CPU -->
                        <Border Grid.Column="2" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10" Margin="10,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="TOP PROCESSOS POR CPU" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="2,0,0,8"/>
                                <DataGrid x:Name="DgSumTopCpu" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                          AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                          IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False" CanUserSortColumns="False"
                                          RowHeight="26" FontSize="11" Foreground="#DDD"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                                          MouseDoubleClick="DgSumTopCpu_MouseDoubleClick">
                                    <DataGrid.Resources>
                                        <Style TargetType="DataGridColumnHeader">
                                            <Setter Property="Background" Value="#1A2432"/>
                                            <Setter Property="Foreground" Value="#888"/>
                                            <Setter Property="FontSize" Value="10"/>
                                            <Setter Property="Padding" Value="6,4"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                        </Style>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Cursor" Value="Hand"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2A2A2E"/></Trigger>
                                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                        <Style TargetType="DataGridCell">
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Padding" Value="4,2"/>
                                        </Style>
                                    </DataGrid.Resources>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="52">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#777"/><Setter Property="FontSize" Value="10"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <!-- Nome com ÍCONE do app (como o TOP 25 do TMOG) -->
                                        <DataGridTemplateColumn Header="Nome" Width="*" SortMemberPath="Name">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0" SnapsToDevicePixels="True"
                                                               RenderOptions.BitmapScalingMode="HighQuality"
                                                               Visibility="{Binding IconVisibility}"/>
                                                        <TextBlock Text="{Binding Name}" Foreground="#EEE" TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="58">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4CAF50"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="Memória" Binding="{Binding RamMB}" Width="72">
                                            <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA"/><Setter Property="HorizontalAlignment" Value="Right"/></Style></DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Grid.Row="2" Text="Duplo clique abre o processo na aba Processos" FontSize="10" Foreground="#555" Margin="2,6,0,0"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- TILES INFERIORES (Rede / Disco / GPU / Energia) -->
                    <UniformGrid Grid.Row="2" Columns="4" Margin="0,10,0,0">
                        <Border Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,5,0">
                            <StackPanel>
                                <TextBlock Text="REDE" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock x:Name="TxtSumNet" Text="—" FontSize="15" FontWeight="Bold" Foreground="#9C27B0"/><TextBlock x:Name="TxtSumNetDetail" Text="" FontSize="10" Foreground="#777"/></StackPanel>
                                    <Canvas x:Name="SumNetCanvas" Grid.Column="1" Width="120" Height="34" Background="#0E141B" ClipToBounds="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="DISCO" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock x:Name="TxtSumDisk" Text="—" FontSize="15" FontWeight="Bold" Foreground="#FF9800"/><TextBlock x:Name="TxtSumDiskDetail" Text="" FontSize="10" Foreground="#777"/></StackPanel>
                                    <Canvas x:Name="SumDiskCanvas" Grid.Column="1" Width="120" Height="34" Background="#0E141B" ClipToBounds="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="GPU" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock x:Name="TxtSumGpuTile" Text="—" FontSize="15" FontWeight="Bold" Foreground="#2196F3"/><TextBlock x:Name="TxtSumGpuDetail" Text="" FontSize="10" Foreground="#777"/></StackPanel>
                                    <Canvas x:Name="SumGpuCanvas" Grid.Column="1" Width="120" Height="34" Background="#0E141B" ClipToBounds="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="5,0,0,0">
                            <StackPanel>
                                <TextBlock Text="ENERGIA" FontSize="10" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <Grid Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0"><TextBlock x:Name="TxtSumPowerTile" Text="—" FontSize="15" FontWeight="Bold" Foreground="#F44336"/><TextBlock x:Name="TxtSumPowerDetail" Text="" FontSize="10" Foreground="#777"/></StackPanel>
                                    <Canvas x:Name="SumPowerCanvas" Grid.Column="1" Width="120" Height="34" Background="#0E141B" ClipToBounds="True"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </Grid>

                <!-- ═══ TAB: CONEXÕES (TCP/UDP por processo, estilo TMOG) ═══ -->
                <Grid x:Name="TabConnections" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,12,14,6">
                        <StackPanel>
                            <TextBlock Text="Conexões" FontSize="22" FontWeight="Bold" Foreground="White"/>
                            <TextBlock x:Name="TxtConnSubtitle" Text="" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="↻ Atualizar" Height="26" Padding="10,0" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" Cursor="Hand" Click="BtnConnRefresh_Click"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="14,0,14,6">
                        <TextBox x:Name="TxtConnFilter" Width="280" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" Padding="8,0" FontSize="11" VerticalContentAlignment="Center" TextChanged="TxtConnFilter_TextChanged" ToolTip="Filtrar por processo, PID, endereço ou porta"/>
                        <CheckBox x:Name="ChkConnOnlyEstablished" Content="Apenas conexões ativas" Foreground="#CCC" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Checked="ChkConnFilter_Changed" Unchecked="ChkConnFilter_Changed"/>
                        <CheckBox x:Name="ChkConnGroupProc" Content="Agrupar por processo" Foreground="#CCC" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" Checked="ChkConnFilter_Changed" Unchecked="ChkConnFilter_Changed"/>
                    </StackPanel>
                    <DataGrid x:Name="DgConnections" Grid.Row="2" Margin="14,0,14,0" Background="Transparent" BorderThickness="0"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#1A2432" VerticalGridLinesBrush="Transparent"
                              IsReadOnly="True" SelectionMode="Extended" CanUserAddRows="False" RowHeight="26" FontSize="11"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="#1C2634" CornerRadius="4" Padding="6,3" Margin="0,3,0,1">
                                            <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="#4FC3F7"/>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </DataGrid.GroupStyle>
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A2432"/><Setter Property="Foreground" Value="#888"/>
                                <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="8,5"/>
                                <Setter Property="BorderBrush" Value="#1F2A3A"/><Setter Property="BorderThickness" Value="0,0,1,1"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#243040"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/></Trigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Padding" Value="6,2"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Processo" Binding="{Binding ProcessName}" Width="*">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EEE"/><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="70">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#777"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Protocolo" Binding="{Binding Protocol}" Width="80">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4FC3F7"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Endereço local" Binding="{Binding Local}" Width="230">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#BBB"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Endereço remoto" Binding="{Binding Remote}" Width="230">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#BBB"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Estado" Binding="{Binding State}" Width="130">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#4CAF50"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="3" Margin="14,4,14,10">
                        <TextBlock x:Name="TxtConnStatus" Text="" FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                        <TextBlock Text="F5=Atualizar" FontSize="10" Foreground="#555" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

            <!-- ═══ TAB: USUÁRIOS ═══ -->
            <Grid x:Name="TabUsers" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="14,12,14,6" Orientation="Horizontal">
                        <TextBlock Text="Usuários" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock x:Name="TxtUserCount" Text="" FontSize="12" Foreground="#888" VerticalAlignment="Bottom" Margin="12,0,0,4"/>
                    </StackPanel>
                    <DataGrid x:Name="DgUsers" Grid.Row="1" Margin="14,0,14,14" Background="Transparent" BorderThickness="0"
                              AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                              HorizontalGridLinesBrush="#1A2432" VerticalGridLinesBrush="Transparent"
                              IsReadOnly="True" SelectionMode="Single" CanUserAddRows="False"
                              RowDetailsVisibilityMode="VisibleWhenSelected"
                              RowBackground="#111823" AlternatingRowBackground="#161F2C"
                              RowHeight="32" CanUserSortColumns="True"
                              RowStyle="{DynamicResource UserRowStyle}">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <!-- Processos do usuário (como o TMOG: aparece ao clicar na setinha) -->
                                <Border Background="#0D131A" BorderBrush="#1F2A3A" BorderThickness="0,1,0,1" Padding="26,4,6,6">
                                    <ItemsControl ItemsSource="{Binding Processes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Height="24">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="90"/>
                                                        <ColumnDefinition Width="110"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11" Foreground="#DDD"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Name}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Cpu}" FontSize="11" Foreground="#CCC"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding MemMB}" FontSize="11" Foreground="#AAA"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="" Width="30" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ExpandIcon}" Click="BtnUserExpand_Click" Cursor="Hand"
                                                Background="Transparent" BorderThickness="0" Foreground="#4FC3F7" FontSize="10"
                                                Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                ToolTip="Mostrar os processos deste usuário"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Usuário" Width="180" SortMemberPath="UserName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                                            <Border Width="18" Height="18" CornerRadius="9" Background="#1F2A3A" Margin="0,0,8,0">
                                                <TextBlock Text="👤" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4FC3F7"/>
                                            </Border>
                                            <TextBlock Text="{Binding UserName}" Foreground="#EEE" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" CanUserSort="False">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA"/><Setter Property="FontSize" Value="11"/><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="CPU" Width="110" SortMemberPath="CpuValue">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding CpuCellBackground}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Stretch">
                                            <TextBlock Text="{Binding Cpu}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Memória" Width="120" SortMemberPath="MemValue">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MemMB}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Processos" Width="110" SortMemberPath="ProcessCount">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessCount}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>

                <!-- ═══ TAB: PROCESSOS ═══ -->
                <Grid x:Name="TabProcesses" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ACTION BAR + RESOURCE SUMMARY -->
                    <Grid Grid.Row="0" Margin="14,10,14,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <!-- Header row -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="Processos" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtProcessCount" Text="" FontSize="12" Foreground="#777" VerticalAlignment="Center"/>
                                <!-- FPS medido pelo motor de render (motor de 60 fps, estilo TMOG) -->
                                <Border Background="#13251F" BorderBrush="#2E7D32" BorderThickness="1" CornerRadius="3"
                                        Margin="8,0,0,0" Padding="5,1" VerticalAlignment="Center"
                                        ToolTip="Quadros por segundo do motor de render do Kit. As métricas são amostradas 1x por segundo e interpoladas quadro a quadro, no ritmo da tela (60 Hz ou mais) — o mesmo truque visual do Task Manager TMOG.">
                                    <TextBlock x:Name="TxtRenderFps" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#7CDb7C"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Intervalo:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox x:Name="CmbRefreshInterval" Width="70" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" SelectionChanged="CmbRefreshInterval_Changed" FontSize="11">
                                    <ComboBoxItem Content="1s" IsSelected="True"/>
                                    <ComboBoxItem Content="2s"/>
                                    <ComboBoxItem Content="3s"/>
                                    <ComboBoxItem Content="5s"/>
                                </ComboBox>
                                <Button x:Name="BtnFinalizar" Height="28" Padding="12,0" Margin="10,0,0,0" Click="BtnKill_Click" Cursor="Hand" ToolTip="Finalizar processo (Delete)">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="#1F2A3A" BorderBrush="#2C3A4E" BorderThickness="1" CornerRadius="4" Padding="12,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x2716;" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="White"/><TextBlock Text="Finalizar" FontSize="12" VerticalAlignment="Center" Foreground="White"/></StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#3A2A2A"/><Setter TargetName="bdr" Property="BorderBrush" Value="#C42B1C"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#C42B1C"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Opacity" Value="0.4"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="BtnForceStop" Height="28" Padding="12,0" Margin="6,0,0,0" Click="BtnForceStop_Click" Cursor="Hand" ToolTip="Force Stop: libera handles e drivers">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bdr" Background="#8B1A1A" CornerRadius="4" Padding="12,0">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#x26A1;" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="#4FC3F7"/><TextBlock Text="Force Stop" FontSize="12" VerticalAlignment="Center" Foreground="#4FC3F7" FontWeight="SemiBold"/></StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#AA2222"/></Trigger>
                                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#CC3333"/></Trigger>
                                                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Opacity" Value="0.4"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <!-- Resource summary row -->
                        <Border Grid.Row="1" Margin="0,8,0,0" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="16,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0"><TextBlock Text="CPU" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtCpuUsage" Text="0%" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="Memória" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtMemUsage" Text="0%" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Disco" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtDiskUsage" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="3"><TextBlock Text="Rede" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtNetUsage" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="4"><TextBlock Text="GPU" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtGpuUsage" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="5" Margin="26,0,0,0"><TextBlock Text="Frequência" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtCpuFreq" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="6" Margin="26,0,0,0"><TextBlock Text="Temperatura" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtCpuTemp" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                            <StackPanel Grid.Column="7" Margin="26,0,0,0"><TextBlock Text="Potência" FontSize="11" FontWeight="Bold" Foreground="#777"/><TextBlock x:Name="TxtCpuPower" Text="—" FontSize="20" FontWeight="Bold" Foreground="White"/></StackPanel>
                        </Grid>
                        </Border>
                    </Grid>

                    <!-- MAIN AREA: DataGrid + Detail Panel -->
                    <Grid Grid.Row="1" Margin="14,8,14,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="400"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="340" MinWidth="0" MaxWidth="500"/>
                        </Grid.ColumnDefinitions>

                        <!-- DATA GRID — Win11 illuminated + virtualized -->
                        <DataGrid x:Name="DgProcesses" Grid.Column="0"
                                   Background="Transparent" BorderBrush="#1F2A3A"
                                   Foreground="White" FontSize="12" RowBackground="Transparent"
                                   AlternatingRowBackground="#141C28" GridLinesVisibility="None"
                                   HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                                   SelectionMode="Extended" SelectionUnit="FullRow"
                                   AutoGenerateColumns="False" IsReadOnly="True"
                                   EnableRowVirtualization="True" EnableColumnVirtualization="True"
                                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                   VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                   VirtualizingPanel.CacheLength="1,2" VirtualizingPanel.CacheLengthUnit="Page"
                                   VirtualizingPanel.ScrollUnit="Pixel"
                                   ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto"
                                   ScrollViewer.CanContentScroll="True"
                                   ScrollViewer.IsDeferredScrollingEnabled="False"
                                   RowHeight="32" MinRowHeight="24"
                                   BorderThickness="0" Cursor="Hand"
                                   CanUserSortColumns="True"
                                   Sorting="DgProcesses_Sorting"
                                   SelectionChanged="DgProcesses_SelectionChanged"
                                   MouseDoubleClick="DgProcesses_MouseDoubleClick">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#1A2432"/>
                                    <Setter Property="Foreground" Value="#888"/>
                                    <Setter Property="FontSize" Value="11"/>
                                    <Setter Property="Padding" Value="8,6"/>
                                    <Setter Property="BorderBrush" Value="#1F2A3A"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridColumnHeader">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                                        <TextBlock x:Name="SortArrow" Grid.Column="1" Margin="6,0,0,0" FontSize="9" Foreground="#4FC3F7" VerticalAlignment="Center" Visibility="Collapsed" Text="▼"/>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="SortDirection" Value="Ascending">
                                                        <Setter TargetName="SortArrow" Property="Text" Value="▲"/>
                                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                    <Trigger Property="SortDirection" Value="Descending">
                                                        <Setter TargetName="SortArrow" Property="Text" Value="▼"/>
                                                        <Setter TargetName="SortArrow" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Height" Value="32"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Margin" Value="2,1,2,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridRow">
                                              <Grid>
                                                <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                                    <SelectiveScrollingGrid>
                                                        <SelectiveScrollingGrid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </SelectiveScrollingGrid.ColumnDefinitions>
                                                        <SelectiveScrollingGrid.RowDefinitions>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </SelectiveScrollingGrid.RowDefinitions>
                                                        <DataGridCellsPresenter Grid.Column="1" Grid.Row="0" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                        <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{TemplateBinding DetailsVisibility}"/>
                                                    </SelectiveScrollingGrid>
                                                </Border>
                                                <!-- BRILHO de processo novo (verde) / fechado (vermelho).
                                                     A Opacity deste brush é animada pelo motor de 60 fps; sem
                                                     IsHitTestVisible=False os cliques na linha morreriam aqui. -->
                                                <Border x:Name="DGR_Highlight" Background="{Binding HighlightBrush}" CornerRadius="6"
                                                        IsHitTestVisible="False" SnapsToDevicePixels="True"/>
                                                <TextBlock Text="{Binding GhostBadge}" Visibility="{Binding IsGhostVisible}"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                                           FontSize="11" FontWeight="Bold" Foreground="#FF8A8A" IsHitTestVisible="False"
                                                           ToolTip="Este processo foi encerrado agora"/>
                                              </Grid>
                                                <ControlTemplate.Triggers>
                                                    <!-- Filho: cantos retos — o bloco do grupo fica
                                                         contínuo (o 1º filho encosta no pai e os
                                                         demais encostam uns nos outros). -->
                                                    <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                        <Setter TargetName="DGR_Border" Property="CornerRadius" Value="0"/>
                                                        <Setter TargetName="DGR_Highlight" Property="CornerRadius" Value="0"/>
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <!-- ORDEM IMPORTA: triggers posteriores vencem. Estado de
                                             grupo (expandido/filho) primeiro, hover/seleção/foco por
                                             último — assim o feedback do mouse funciona TAMBÉM em
                                             grupo expandido (antes o fundo fixo do expandido matava o
                                             hover e parecia "congelado"). -->
                                        <!-- Expandido — highlight claro (flat) -->
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Background" Value="#2A2A30"/>
                                            <Setter Property="BorderBrush" Value="#31465F"/>
                                        </DataTrigger>
                                        <!-- Filho: sem margem vertical = linhas coladas, o grupo
                                             expandido lê como UM bloco em vez de pílulas soltas. -->
                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                            <Setter Property="Background" Value="#1B2937"/>
                                            <Setter Property="BorderBrush" Value="#3A4C66"/>
                                            <Setter Property="Height" Value="28"/>
                                            <Setter Property="Margin" Value="2,0,2,0"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#243040"/>
                                            <Setter Property="BorderBrush" Value="#33445C"/>
                                        </Trigger>
                                        <!-- DEPOIS do hover genérico: hover de filho vence o hover
                                             normal (trigger posterior tem precedência). -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsChild}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#2E3D52"/>
                                            <Setter Property="BorderBrush" Value="#52688A"/>
                                        </MultiDataTrigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#17324F"/>
                                            <Setter Property="BorderBrush" Value="#2E5F94"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                                <Condition Property="IsSelected" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="#28507E"/>
                                            <Setter Property="BorderBrush" Value="#3F74B8"/>
                                        </MultiTrigger>
                                        <!-- Foco via teclado — anel dourado sutil -->
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="#4FC3F7"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <!-- Icon -->
                                <DataGridTemplateColumn Header="" Width="30">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Image Source="{Binding ProcessIcon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Name — flat indentação Win11 (└─) + seta -->
                                <DataGridTemplateColumn Header="Nome" Width="220" SortMemberPath="DisplayName">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{Binding NameMargin}">
                                                <TextBlock Text="{Binding ExpandIcon}" FontSize="9" Foreground="#4FC3F7" VerticalAlignment="Center" Width="14" Cursor="Hand" ToolTip="Expandir/recolher" MouseLeftButtonDown="ExpandIcon_Click"/>
                                                <TextBlock Text="└─" FontSize="9" Foreground="#888" VerticalAlignment="Center" Width="14">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers><DataTrigger Binding="{Binding IsChild}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding DisplayName}" FontSize="12" Foreground="White" VerticalAlignment="Center"/>
                                                <Border Background="#4FC3F7" CornerRadius="3" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center" MinHeight="14" MinWidth="28" HorizontalAlignment="Left"
                                                        Visibility="{Binding IsProtectedBadgeVisible}">
                                                    <TextBlock Text="{Binding ProtectedBadge}" FontSize="8" FontWeight="Bold" Foreground="#111823" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Status -->
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- CPU -->
                                <DataGridTemplateColumn Header="CPU" Width="65" SortMemberPath="CpuValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding CpuCellBackground}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Cpu}" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- RAM -->
                                <DataGridTemplateColumn Header="Memória" Width="95" SortMemberPath="RamValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding RamCellBackground}" CornerRadius="3" Padding="4,1" HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding RamMB}" FontSize="11" Foreground="White" HorizontalAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Disk -->
                                <DataGridTemplateColumn Header="Disco" Width="95" SortMemberPath="DiskBytesPerSec">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Disk}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Network -->
                                <DataGridTemplateColumn Header="Rede" Width="80" SortMemberPath="NetBytesPerSec">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Network}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- GPU -->
                                <DataGridTemplateColumn Header="GPU" Width="60" SortMemberPath="GpuValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Gpu}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Paridade TMOG: Usuário / Peak memory / CPU time / Page faults -->
                                <DataGridTextColumn Header="Usuário" Binding="{Binding UserName}" Width="90">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Pico mem." Width="85" SortMemberPath="PeakMemValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PeakMemMB}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Tempo CPU" Width="85" SortMemberPath="CpuTimeSec">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuTime}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Page faults" Width="90" SortMemberPath="PageFaultsValue">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PageFaults}" FontSize="11" Foreground="#CCC" HorizontalAlignment="Right" Margin="0,0,6,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <!-- Threads -->
                                <DataGridTextColumn Header="Threads" Binding="{Binding Threads}" Width="60">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAA"/><Setter Property="FontSize" Value="11"/><Setter Property="TextAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <!-- PID -->
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65">
                                    <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#888"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" Foreground="White" Padding="4">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#DDD"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Setter Property="Padding" Value="8,6"/>
                                            <Setter Property="Margin" Value="2,1"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="MenuItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                <TextBlock x:Name="Icon" Text="{TemplateBinding Icon}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA"/>
                                                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                            </Grid>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#243040"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Foreground" Value="#555"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                        <Style TargetType="Separator">
                                            <Setter Property="Background" Value="#1F2A3A"/>
                                            <Setter Property="Margin" Value="4,4"/>
                                            <Setter Property="Height" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Separator">
                                                        <Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="MenuKill" Header="Finalizar tarefa" Icon="✕" InputGestureText="Del" Click="MenuKill_Click"/>
                                    <MenuItem x:Name="MenuKillTree" Header="Finalizar árvore" Icon="🌳" InputGestureText="Shift+Del" Click="MenuKillTree_Click" FontWeight="SemiBold"/>
                                    <MenuItem x:Name="MenuKillMulti" Header="Finalizar N tarefas" Icon="✕" Click="MenuKill_Click"/>
                                    <MenuItem x:Name="MenuKillTreeMulti" Header="Finalizar N árvores" Icon="🌳" Click="MenuKillTree_Click" FontWeight="SemiBold"/>
                                    <MenuItem x:Name="MenuSuspendMulti" Header="Suspender N" Icon="⏸" Click="MenuSuspend_Click"/>
                                    <MenuItem x:Name="MenuResumeMulti" Header="Retomar N" Icon="▶" Click="MenuResume_Click"/>
                                    <MenuItem x:Name="MenuEcoQoSMulti" Header="Eficiência EcoQoS (N)" Icon="🌱" Click="MenuEcoQoS_Click"/>
                                    <MenuItem x:Name="MenuPriorityMulti" Header="Prioridade para N" Icon="⬢">
                                        <MenuItem Header="Tempo real" Tag="RealTime" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Alta" Tag="High" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Acima do normal" Tag="AboveNormal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Normal" Tag="Normal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Abaixo do normal" Tag="BelowNormal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Baixa" Tag="Low" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Ocioso" Tag="Idle" Click="MenuPriority_Click"/>
                                    </MenuItem>
                                    <MenuItem Header="Force Stop" Icon="⚡" Foreground="#4FC3F7" FontWeight="SemiBold" Click="MenuForceStop_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Suspender" Icon="⏸" Click="MenuSuspend_Click"/>
                                    <MenuItem Header="Retomar" Icon="▶" Click="MenuResume_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Eficiência  EcoQoS" Icon="🌱" Click="MenuEcoQoS_Click"/>
                                    <MenuItem Header="Prioridade" Icon="⬢">
                                        <MenuItem Header="Tempo real" Tag="RealTime" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Alta" Tag="High" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Acima do normal" Tag="AboveNormal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Normal" Tag="Normal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Abaixo do normal" Tag="BelowNormal" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Baixa" Tag="Low" Click="MenuPriority_Click"/>
                                        <MenuItem Header="Ocioso" Tag="Idle" Click="MenuPriority_Click"/>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Abrir local do arquivo" Icon="📁" Click="MenuOpenFolder_Click"/>
                                    <MenuItem Header="Copiar caminho" Icon="📋" Click="MenuCopyPath_Click"/>
                                    <MenuItem Header="Copiar PID" Icon="#" Click="MenuCopyPid_Click"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>

                        <!-- GRID SPLITTER -->
                        <GridSplitter x:Name="DetailSplitter" Grid.Column="1" Width="4" Background="#1F2A3A" Cursor="SizeWE"
                                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

                        <!-- DETAIL PANEL -->
                        <Border x:Name="DetailPanel" Grid.Column="2" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1,0,0,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Close button bar -->
                                <Grid Grid.Row="0" Margin="0">
                                    <TextBlock Text="Detalhes do Processo" FontSize="10" Foreground="#555" VerticalAlignment="Center" Margin="12,6,0,6"/>
                                    <Button x:Name="BtnCloseDetail" HorizontalAlignment="Right" Width="22" Height="22" Margin="0,0,6,0" Cursor="Hand" Click="BtnCloseDetail_Click" ToolTip="Fechar painel de detalhes">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bdr" Background="Transparent" CornerRadius="4" Width="22" Height="22">
                                                    <TextBlock x:Name="CloseIcon" Text="✕" FontSize="11" Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#3A2A2A"/><Setter TargetName="CloseIcon" Property="Foreground" Value="#E81123"/></Trigger>
                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#C42B1C"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </Grid>

                                <Border Grid.Row="0" Grid.RowSpan="2" BorderBrush="#1F2A3A" BorderThickness="0,1,0,0"/>

                                <!-- Scrollable content -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel Margin="12,8,12,12">
                                        <!-- Process header -->
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Image x:Name="DetailIcon" Grid.Column="0" Width="32" Height="32" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock x:Name="DetailName" Text="" FontSize="15" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="DetailPid" Text="" FontSize="11" Foreground="#888"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Properties (fixed: explicit RowDefinitions prevent overlap) -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Propriedades" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="PID" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailPidValue" Grid.Row="0" Grid.Column="1" Text="" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Status" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailStatus" Grid.Row="1" Grid.Column="1" Text="" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Usuário" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailUser" Grid.Row="2" Grid.Column="1" Text="" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Início" Foreground="#888" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock x:Name="DetailStartTime" Grid.Row="3" Grid.Column="1" Text="" Foreground="White" FontSize="11" Margin="0,0,0,4"/>
                                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Uptime" Foreground="#888" FontSize="11"/>
                                                    <TextBlock x:Name="DetailUptime" Grid.Row="4" Grid.Column="1" Text="" Foreground="White" FontSize="11"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Detalhes avançados (paridade TMOG: sessão, arquitetura, cmdline, IO, tempos) -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,6">
                                                    <TextBlock Text="Detalhes avançados" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7"/>
                                                    <TextBlock x:Name="TxtDetailAdvLoading" Text="" FontSize="10" Foreground="#777" HorizontalAlignment="Right"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="86"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <TextBlock Grid.Row="0" Text="Processo pai" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailParent" Grid.Row="0" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Grid.Row="1" Text="Sessão" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailSession" Grid.Row="1" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="2" Text="Arquitetura" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailArch" Grid.Row="2" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="3" Text="Prior. base" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailBasePrio" Grid.Row="3" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="4" Text="Grupo" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailGroup" Grid.Row="4" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3" TextTrimming="CharacterEllipsis"/>

                                                    <TextBlock Grid.Row="5" Text="Commit" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailCommit" Grid.Row="5" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="6" Text="Pico mem." Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailPeak" Grid.Row="6" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="7" Text="Tempo kernel" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailKernelTime" Grid.Row="7" Grid.Column="1" Text="—" Foreground="#F44336" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="8" Text="Tempo usuário" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailUserTime" Grid.Row="8" Grid.Column="1" Text="—" Foreground="#4CAF50" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="9" Text="E/S lida" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailIoRead" Grid.Row="9" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="10" Text="E/S escrita" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailIoWrite" Grid.Row="10" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="11" Text="Op. de E/S" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailIoOps" Grid.Row="11" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="12" Text="Falhas de pág." Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailPageFaults" Grid.Row="12" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="13" Text="GDI / USER" Foreground="#888" FontSize="11" Margin="0,0,0,3"/>
                                                    <TextBlock x:Name="DetailGuiUser" Grid.Row="13" Grid.Column="1" Text="—" Foreground="White" FontSize="11" Margin="0,0,0,3"/>

                                                    <TextBlock Grid.Row="14" Text="Elevado" Foreground="#888" FontSize="11"/>
                                                    <TextBlock x:Name="DetailElevated" Grid.Row="14" Grid.Column="1" Text="—" Foreground="White" FontSize="11"/>
                                                </Grid>
                                                <TextBlock Text="Linha de comando" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,8,0,3"/>
                                                <Border Background="#1C1C1C" CornerRadius="4" Padding="6,4" MinHeight="26">
                                                    <TextBlock x:Name="DetailCommandLine" Text="—" FontSize="10" Foreground="#AAA" TextWrapping="Wrap"/>
                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <!-- Performance -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Performance" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="CPU" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailCpu" Text="0%" Foreground="#4CAF50" FontSize="16" FontWeight="Bold"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="RAM" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailRam" Text="0 MB" Foreground="#2196F3" FontSize="16" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Handles" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailHandles" Text="0" Foreground="White" FontSize="13"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Threads" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailThreads" Text="0" Foreground="White" FontSize="13"/>
                                                    </StackPanel>
                                                </Grid>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                                        <TextBlock Text="Disco R/W" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailDisk" Text="—" Foreground="#FF9800" FontSize="13"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="Rede" Foreground="#888" FontSize="10"/>
                                                        <TextBlock x:Name="DetailNet" Text="—" Foreground="#9C27B0" FontSize="13"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Mini CPU Graph -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="CPU (30s)" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                                <Canvas x:Name="MiniCpuCanvas" Height="40" Background="#111823"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Quick Actions (UniformGrid 2 columns) -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Ações Rápidas" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,8"/>
                                                <UniformGrid Columns="2">
                                                    <!-- Priority -->
                                                    <StackPanel Margin="0,0,4,6">
                                                        <TextBlock Text="Prioridade" Foreground="#888" FontSize="10" Margin="0,0,0,2"/>
                                                        <ComboBox x:Name="CmbPriority" Height="24" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" FontSize="10" SelectionChanged="CmbPriority_Changed">
                                                            <ComboBoxItem Content="Realtime" Tag="RealTime"/>
                                                            <ComboBoxItem Content="Alta" Tag="High"/>
                                                            <ComboBoxItem Content="Acima Normal" Tag="AboveNormal"/>
                                                            <ComboBoxItem Content="Normal" Tag="Normal" IsSelected="True"/>
                                                            <ComboBoxItem Content="Abaixo Normal" Tag="BelowNormal"/>
                                                            <ComboBoxItem Content="Baixa" Tag="Low"/>
                                                            <ComboBoxItem Content="Ocioso" Tag="Idle"/>
                                                        </ComboBox>
                                                    </StackPanel>
                                                    <!-- Memory -->
                                                    <Button Height="26" Margin="4,0,0,6" Cursor="Hand" Click="BtnClearMemory_Click" ToolTip="Limpar memória do processo">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="#1F2A3A" CornerRadius="4" Padding="8,0">
                                                                    <TextBlock Text="🧹 Limpar RAM" FontSize="10" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1A3A5A"/></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#2196F3"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <!-- Suspend -->
                                                    <Button Height="26" Margin="0,0,4,6" Cursor="Hand" Click="BtnSuspend_Click" ToolTip="Suspender processo">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="#1F2A3A" CornerRadius="4" Padding="8,0">
                                                                    <TextBlock Text="⏸ Suspender" FontSize="10" Foreground="#FF9800" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#3A2A1A"/></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#FF9800"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <!-- EcoQoS -->
                                                    <Button Height="26" Margin="4,0,0,6" Cursor="Hand" Click="BtnEcoQos_Click" ToolTip="Ativar modo de eficiência (EcoQoS)">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="#1F2A3A" CornerRadius="4" Padding="8,0">
                                                                    <TextBlock Text="🌱 EcoQoS" FontSize="10" Foreground="#4CAF50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#1A3A2A"/></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#4CAF50"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <!-- Open folder -->
                                                    <Button Height="26" Margin="0,0,4,0" Cursor="Hand" Click="MenuOpenFolder_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="#1F2A3A" CornerRadius="4" Padding="8,0">
                                                                    <TextBlock Text="📁 Abrir Pasta" FontSize="10" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#555555"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <!-- Copy path -->
                                                    <Button Height="26" Margin="4,0,0,0" Cursor="Hand" Click="MenuCopyPath_Click">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="bdr" Background="#1F2A3A" CornerRadius="4" Padding="8,0">
                                                                    <TextBlock Text="📋 Copiar Path" FontSize="10" Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26334A"/></Trigger>
                                                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#555555"/></Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </UniformGrid>
                                            </StackPanel>
                                        </Border>

                                        <!-- Process path -->
                                        <Border Background="#1C2634" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="Caminho" FontSize="11" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,4"/>
                                                <TextBlock x:Name="DetailPath" Text="" FontSize="10" Foreground="#AAA" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- STATUS BAR -->
                    <Grid Grid.Row="2" Margin="14,4,14,8">
                        <TextBlock x:Name="TxtStatus" Text="Carregando processos..." FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="F5=Atualizar | Delete=Finalizar | Ctrl+F=Buscar | Esc=Fechar" FontSize="10" Foreground="#555" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ═══ TAB: PERFORMANCE (estilo Windows 11: lista de dispositivos à esquerda) ═══ -->
                <Grid x:Name="TabPerformance" Visibility="Collapsed" Margin="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Header + Action Bar -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Desempenho" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                            <TextBlock Text="Selecione um componente na lista para ver os detalhes" FontSize="11" Foreground="#666" Margin="0,2,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Intervalo:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox Width="80" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" FontSize="11" SelectedIndex="0" SelectionChanged="CmbPerfInterval_Changed">
                                <ComboBoxItem Content="1s"/><ComboBoxItem Content="2s"/><ComboBoxItem Content="Pausado"/>
                            </ComboBox>
                            <Button Content="📋 Copiar" Height="26" Margin="8,0,0,0" Padding="10,0" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" Cursor="Hand" Click="BtnPerfCopy_Click" ToolTip="Copiar métricas para clipboard"/>
                            <Button Content="⚡ resmon" Height="26" Margin="6,0,0,0" Padding="10,0" Background="#1F2A3A" Foreground="#4FC3F7" BorderBrush="#2C3A4E" BorderThickness="1" Cursor="Hand" Click="BtnPerfResmon_Click" ToolTip="Abrir Monitor de Recursos"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Todos os dispositivos visíveis como cards (como antes, mas completo) -->
                        <ListBox x:Name="LstPerfDevices" Background="Transparent" BorderThickness="0"
                                 SelectionMode="Single" SelectionChanged="LstPerfDevices_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Width" Value="215"/>
                                    <Setter Property="Margin" Value="3"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bdr" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Padding="10,8">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="#26262B"/><Setter TargetName="bdr" Property="BorderBrush" Value="#3A3A44"/></Trigger>
                                                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="bdr" Property="BorderBrush" Value="#4FC3F7"/><Setter TargetName="bdr" Property="Background" Value="#23231E"/></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                        <TextBlock Grid.Row="1" Text="{Binding Summary}" FontSize="11" Foreground="#4CAF50" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                                        <!-- Preview do histórico -->
                                        <Grid Grid.Row="2" Height="38" Margin="0,6,0,0" Background="#0E141B">
                                            <Canvas x:Name="MiniPerfGraph" VerticalAlignment="Stretch"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Painel de detalhes do dispositivo clicado -->
                        <Border Grid.Row="1" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="8" Margin="0,8,0,0" Padding="16"
                                MaxHeight="320">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock x:Name="PerfDeviceTitle" Text="Selecione um componente" FontSize="17" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="PerfDeviceUtil" Text="" FontSize="22" FontWeight="Bold" Foreground="#4CAF50" Margin="14,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Canvas x:Name="PerfBigCanvas" Grid.Row="1" Height="90" Background="#0E141B" Margin="0,4,0,10"/>
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PnlPerfDetails" Margin="0,0,4,0"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ═══ TAB: SERVICES ═══ -->
                <Grid x:Name="TabServices" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Serviços" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtServiceCount" Text="" FontSize="12" Foreground="#777" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="▶ Iniciar" Style="{StaticResource TmToolButton}" Click="MenuStartService_Click" ToolTip="Iniciar serviço selecionado"/>
                            <Button Content="⏹ Parar" Style="{StaticResource TmToolButton}" Click="MenuStopService_Click" ToolTip="Parar serviço"/>
                            <Button Content="🔄 Reiniciar" Style="{StaticResource TmToolButton}" Click="MenuRestartService_Click" ToolTip="Reiniciar serviço"/>
                            <Button Content="⚙️ services.msc" Style="{StaticResource TmToolButton}" Foreground="#4FC3F7" Click="BtnOpenServicesMsc_Click" ToolTip="Abrir gerenciador de Serviços do Windows"/>
                            <TextBlock Text="Filtrar:" FontSize="11" Foreground="#777" VerticalAlignment="Center" Margin="6,0,6,0"/>
                            <ComboBox x:Name="CmbServiceFilter" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" FontSize="11" SelectionChanged="CmbServiceFilter_Changed">
                                <ComboBoxItem Content="Todos" IsSelected="True"/>
                                <ComboBoxItem Content="Executando"/>
                                <ComboBoxItem Content="Parados"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="DgServices" Grid.Row="1" Margin="14,0,14,0"
                              Background="Transparent" BorderBrush="#1F2A3A"
                              Foreground="White" FontSize="12" RowBackground="Transparent"
                              AlternatingRowBackground="#141C28" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              RowHeight="30" BorderThickness="0" Cursor="Hand"
                              CanUserSortColumns="True" Sorting="DgServices_Sorting">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A2432"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#1F2A3A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="DGR_Border2" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></SelectiveScrollingGrid.ColumnDefinitions>
                                                    <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridCellsPresenter Grid.Column="1" Grid.Row="0" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{TemplateBinding DetailsVisibility}"/>
                                                </SelectiveScrollingGrid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#243040"/><Setter Property="BorderBrush" Value="#33445C"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/><Setter Property="BorderBrush" Value="#2E5F94"/></Trigger>
                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#28507E"/><Setter Property="BorderBrush" Value="#3F74B8"/></MultiTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="180">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Exibição" Binding="{Binding DisplayName}" Width="220">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Status" Width="110" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,4" MinWidth="90" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Inicialização" Binding="{Binding StartMode}" Width="110"/>
                            <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="120"/>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource TmDarkMenu}">
                                <MenuItem Header="Iniciar serviço" Icon="▶" Style="{StaticResource TmMenuItem}" Click="MenuStartService_Click"/>
                                <MenuItem Header="Parar serviço" Icon="⏹" Style="{StaticResource TmMenuItem}" Click="MenuStopService_Click"/>
                                <MenuItem Header="Reiniciar serviço" Icon="🔄" Style="{StaticResource TmMenuItem}" Click="MenuRestartService_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="14,4,14,8">
                        <TextBlock x:Name="TxtServiceStatus" Text="" FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ═══ TAB: STARTUP ═══ -->
                <Grid x:Name="TabStartup" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="Inicialização" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock x:Name="TxtStartupCount" Text="" FontSize="12" Foreground="#777" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="✅ Habilitar" Style="{StaticResource TmToolButton}" Click="MenuEnableStartup_Click" ToolTip="Habilitar na inicialização"/>
                            <Button Content="🚫 Desabilitar" Style="{StaticResource TmToolButton}" Click="MenuDisableStartup_Click" ToolTip="Desabilitar da inicialização"/>
                            <Button Content="📂 Pasta" Style="{StaticResource TmToolButton}" Click="BtnStartupOpenFolder_Click" ToolTip="Abrir local do arquivo"/>
                            <Button Content="🔍 Web" Style="{StaticResource TmToolButton}" Click="BtnStartupSearchWeb_Click" ToolTip="Pesquisar no Google"/>
                            <Button Content="🗑️ Órfãs" Style="{StaticResource TmToolButton}" Click="BtnStartupRemoveOrphans_Click" ToolTip="Remover entradas órfãs (arquivo não existe)"/>
                            <TextBox x:Name="TxtStartupSearch" Width="170" Height="26" Margin="6,0,0,0" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" Padding="6,0" FontSize="11" VerticalContentAlignment="Center" TextChanged="TxtStartupSearch_TextChanged" ToolTip="Buscar por nome ou caminho..."/>
                            <ComboBox x:Name="CmbStartupFilter" Height="26" Background="#1F2A3A" Foreground="White" BorderBrush="#2C3A4E" BorderThickness="1" FontSize="11" SelectionChanged="CmbStartupFilter_Changed" Margin="4,0,0,0">
                                <ComboBoxItem Content="Todos" IsSelected="True"/>
                                <ComboBoxItem Content="Habilitados"/>
                                <ComboBoxItem Content="Desabilitados"/>
                                <ComboBoxItem Content="Órfãos"/>
                                <ComboBoxItem Content="Alto impacto"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                    <DataGrid x:Name="DgStartup" Grid.Row="1" Margin="14,0,14,0"
                              Background="Transparent" BorderBrush="#1F2A3A"
                              Foreground="White" FontSize="12" RowBackground="Transparent"
                              AlternatingRowBackground="#141C28" GridLinesVisibility="None"
                              HeadersVisibility="Column" CanUserAddRows="False" CanUserDeleteRows="False"
                              SelectionMode="Single" SelectionUnit="FullRow"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              EnableRowVirtualization="True"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              RowHeight="30" BorderThickness="0" Cursor="Hand"
                              CanUserSortColumns="True" Sorting="DgStartup_Sorting"
                              MouseDoubleClick="DgStartup_MouseDoubleClick">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#1A2432"/>
                                <Setter Property="Foreground" Value="#888"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="BorderBrush" Value="#1F2A3A"/>
                                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Margin" Value="2,1"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridRow">
                                            <Border x:Name="DGR_Border3" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" SnapsToDevicePixels="True">
                                                <SelectiveScrollingGrid>
                                                    <SelectiveScrollingGrid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></SelectiveScrollingGrid.ColumnDefinitions>
                                                    <SelectiveScrollingGrid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></SelectiveScrollingGrid.RowDefinitions>
                                                    <DataGridCellsPresenter Grid.Column="1" Grid.Row="0" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                                    <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" Visibility="{TemplateBinding DetailsVisibility}"/>
                                                </SelectiveScrollingGrid>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#243040"/><Setter Property="BorderBrush" Value="#33445C"/></Trigger>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/><Setter Property="BorderBrush" Value="#2E5F94"/></Trigger>
                                    <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="True"/></MultiTrigger.Conditions><Setter Property="Background" Value="#28507E"/><Setter Property="BorderBrush" Value="#3F74B8"/></MultiTrigger>
                                </Style.Triggers>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="200">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="12"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Comando" Binding="{Binding FullCommand}" Width="350">
                                <DataGridTextColumn.ElementStyle><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#CCC"/><Setter Property="FontSize" Value="11"/></Style></DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="160"/>
                            <DataGridTemplateColumn Header="Status" Width="100" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="8,4" MinWidth="80" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{Binding StatusColor}">
                                            <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu Style="{StaticResource TmDarkMenu}">
                                <MenuItem Header="Habilitar" Icon="✅" Style="{StaticResource TmMenuItem}" InputGestureText="" Click="MenuEnableStartup_Click"/>
                                <MenuItem Header="Desabilitar" Icon="🚫" Style="{StaticResource TmMenuItem}" Click="MenuDisableStartup_Click"/>
                                <Separator Background="#1F2A3A" Margin="4,4">
                                    <Separator.Template><ControlTemplate TargetType="Separator"><Border Background="{TemplateBinding Background}" Height="1" Margin="{TemplateBinding Margin}"/></ControlTemplate></Separator.Template>
                                </Separator>
                                <MenuItem Header="Abrir local do arquivo" Icon="📂" Style="{StaticResource TmMenuItem}" Click="BtnStartupOpenFolder_Click"/>
                                <MenuItem Header="Pesquisar na web" Icon="🔍" Style="{StaticResource TmMenuItem}" Click="BtnStartupSearchWeb_Click"/>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="14,4,14,8">
                        <TextBlock x:Name="TxtStartupStatus" Text="" FontSize="11" Foreground="#AAA" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>

                <!-- ═══ TAB: LATÊNCIA (escuta DPC/ISR, paginação e travamentos — estilo LatencyMon, sem driver) ═══ -->
                <Grid x:Name="TabLatency" Visibility="Collapsed">
                    <Grid.Resources>
                        <!-- Aqui todos os balões são TEXTO longo → quebram linha e só
                             aparecem depois de ~0,9 s de hover (você não é atropelado
                             por balão ao passar o mouse rápido pelas linhas). -->
                        <Style TargetType="ToolTip" BasedOn="{StaticResource InfoTipWrap}"/>

                        <!-- Toda linha das 4 tabelas mostra a explicação completa no hover.
                             InitialShowDelay curto-médio: você precisa PARAR o mouse na linha
                             (~0,9 s) para o balão aparecer — e ele fica aberto bastante tempo
                             para você conseguir ler e até copiar. -->
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="900"/>
                            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                            <Setter Property="Cursor" Value="Help"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#26262C"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#17324F"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <!-- Os textos desta tabela são frases (estalo de áudio, janela travada…).
                             Sem TextTrimming o texto LONGO invade a coluna seguinte e vira sopa
                             ilegível. O texto completo continua no tooltip da linha. -->
                        <Style x:Key="LatCellEllipsis" TargetType="TextBlock">
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="Margin" Value="2,0,6,0"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="314"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + ações -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Latência e Travamentos" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Border x:Name="LatStateBadge" Background="#333" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="LatState" Text="PARADO" FontSize="10" FontWeight="Bold" Foreground="#AAA"/>
                                </Border>
                                <TextBlock x:Name="LatEtwStatus" Text="" FontSize="10" Foreground="#777" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            </StackPanel>
                            <TextBlock Text="O Kit escuta o que o sistema faz nos bastidores — DPC/ISR dos drivers, paginação do disco e janelas travadas — e explica em português simples o que travou, quando e por quê." FontSize="11" Foreground="#777" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnLatToggle" Content="▶ INICIAR" Style="{StaticResource TmToolButton}" Click="BtnLatToggle_Click" Width="104" ToolTip="Começa a escutar o sistema (roda em segundo plano)"/>
                            <Button x:Name="BtnLatClear" Content="🧹 Limpar" Style="{StaticResource TmToolButton}" Click="BtnLatClear_Click" ToolTip="Zera eventos e estatísticas da sessão"/>
                            <Button x:Name="BtnLatCopy" Content="📋 Copiar relatório (IA)" Style="{StaticResource TmToolButton}" Click="BtnLatCopy_Click" ToolTip="Copia o relatório técnico completo — cole numa IA ou no suporte"/>
                            <Button x:Name="BtnLatElevate" Content="🛡️ Admin" Style="{StaticResource TmToolButton}" Click="BtnLatElevate_Click" ToolTip="Reiniciar como administrador para identificar o driver exato dos DPCs"/>
                        </StackPanel>
                    </Grid>

                    <!-- Faixa de métricas -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Margin="14,0,14,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="TEMPO" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatTime" Text="00:00:00" FontSize="15" FontWeight="Bold" Foreground="White"/>
                                <TextBlock x:Name="LatEvents" Text="0 eventos" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="DPC (1 min)" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatDpcPct" Text="0,0%" FontSize="15" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock Text="pico de UM núcleo" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="MAIOR DPC" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatDpcMax" Text="—" FontSize="15" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <TextBlock x:Name="LatDpcMaxDrv" Text="driver ainda não identificado" FontSize="9" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="MAIOR ISR" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatIsrMax" Text="—" FontSize="15" FontWeight="Bold" Foreground="#FFB74D"/>
                                <TextBlock Text="rotina de interrupção" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="PAGINAÇÃO" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatHf" Text="0/s" FontSize="15" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock x:Name="LatHfTotal" Text="0 no total" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="SISTEMA TRAVOU" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="LatStall" Text="0x" FontSize="15" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock x:Name="LatStallWorst" Text="pior: —" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Coluna esquerda: conclusão + tabelas -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="14,0,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Conclusão em texto simples (caixa do LatencyMon) -->
                        <Border x:Name="LatConclusionCard" Grid.Row="0" Background="#141C28" BorderBrush="#4CAF50" BorderThickness="1,0,0,0" CornerRadius="6" Padding="12,10" Margin="0,0,0,10">
                            <StackPanel>
                                <TextBlock x:Name="LatConclusionTitle" Text="O que o Kit está vendo" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" Margin="0,0,0,5"/>
                                <TextBlock x:Name="LatConclusionText" Text="Clique em INICIAR e deixe rodar alguns minutos. A análise aparece aqui — igual ao LatencyMon, mas em português." FontSize="12" Foreground="#DDD" TextWrapping="Wrap" LineHeight="18"/>
                            </StackPanel>
                        </Border>

                        <!-- Seletor de visão -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
                            <Button x:Name="BtnLatViewEvents" Content="Eventos" Style="{StaticResource TmToolButton}" Click="LatView_Click" Tag="Events"/>
                            <Button x:Name="BtnLatViewDrivers" Content="Drivers" Style="{StaticResource TmToolButton}" Click="LatView_Click" Tag="Drivers"/>
                            <Button x:Name="BtnLatViewCores" Content="Núcleos" Style="{StaticResource TmToolButton}" Click="LatView_Click" Tag="Cores"/>
                            <Button x:Name="BtnLatViewProcs" Content="Processos" Style="{StaticResource TmToolButton}" Click="LatView_Click" Tag="Procs"/>
                            <TextBlock x:Name="LatViewHint" Text="" FontSize="10" Foreground="#777" VerticalAlignment="Center" Margin="6,0,0,0"/>
                        </StackPanel>

                        <!-- Tabelas -->
                        <Grid Grid.Row="2">
                            <DataGrid x:Name="DgLatEvents" Style="{StaticResource TmGrid}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Hora" Binding="{Binding Hora}" Width="70"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="80"/>
                                    <DataGridTemplateColumn Header="Gravidade" Width="100" SortMemberPath="Gravidade">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Ellipse Width="8" Height="8" Fill="{Binding GravidadeCor}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{Binding Gravidade}" FontSize="11" Foreground="{Binding GravidadeCor}" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="O que aconteceu" Binding="{Binding Titulo}" Width="*"
                                                        ElementStyle="{StaticResource LatCellEllipsis}"/>
                                    <DataGridTextColumn Header="Explicação (passe o mouse)" Binding="{Binding Resumo}" Width="2*"
                                                        ElementStyle="{StaticResource LatCellEllipsis}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="DgLatDrivers" Style="{StaticResource TmGrid}" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Driver" Binding="{Binding Nome}" Width="170"/>
                                    <DataGridTextColumn Header="O que é" Binding="{Binding Descricao}" Width="2*"/>
                                    <DataGridTextColumn Header="DPC" Binding="{Binding DpcCount}" Width="70"/>
                                    <DataGridTextColumn Header="ISR" Binding="{Binding IsrCount}" Width="70"/>
                                    <DataGridTextColumn Header="Maior DPC" Binding="{Binding MaxDpc}" Width="90"/>
                                    <DataGridTextColumn Header="Maior ISR" Binding="{Binding MaxIsr}" Width="90"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="DgLatCores" Style="{StaticResource TmGrid}" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Núcleo" Binding="{Binding Nome}" Width="90"/>
                                    <DataGridTemplateColumn Header="DPC na janela" Width="120" SortMemberPath="DpcPct">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DpcPct}" FontSize="11" Foreground="{Binding DpcCor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Pico DPC (1s)" Binding="{Binding MaxDpc}" Width="120"/>
                                    <DataGridTextColumn Header="ISR na janela" Binding="{Binding IsrPct}" Width="120"/>
                                    <DataGridTextColumn Header="Pico ISR" Binding="{Binding MaxIsr}" Width="100"/>
                                    <DataGridTextColumn Header="Interrupções" Binding="{Binding Ints}" Width="110"/>
                                    <DataGridTextColumn Header="DPC acumulado" Binding="{Binding TotalDpc}" Width="*" MinWidth="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <DataGrid x:Name="DgLatProcs" Style="{StaticResource TmGrid}" Visibility="Collapsed">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Processo" Binding="{Binding Nome}" Width="2*"/>
                                    <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="80"/>
                                    <DataGridTextColumn Header="Falhas no disco (total)" Binding="{Binding Duras}" Width="170"/>
                                    <DataGridTemplateColumn Header="Agora" Width="100" SortMemberPath="Agora">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Agora}" FontSize="11" Foreground="{Binding AgoraCor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Falhas totais" Binding="{Binding Soft}" Width="130"/>
                                    <DataGridTextColumn Header="Memória" Binding="{Binding Ws}" Width="*" MinWidth="100"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Aviso de tabela vazia (ex.: drivers sem admin) — explicado, não um grid mudo -->
                            <TextBlock x:Name="LatEmptyHint" Text="" Visibility="Collapsed" FontSize="12" Foreground="#888"
                                       TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       TextAlignment="Center" LineHeight="19"/>
                        </Grid>
                    </Grid>

                    <!-- Coluna direita: medidores + explicação didática -->
                    <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="0,0,14,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ÁUDIO: o Kit ouve o que o dispositivo está TOCANDO e pergunta ao
                                 próprio motor de áudio do Windows quando ele precisou pular
                                 quadros. Não é estimativa: é a API oficial de glitch (Win7+). -->
                            <Border x:Name="LatAudioCard" Background="#141C28" BorderBrush="#4CAF50" BorderThickness="1,0,0,0" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Estalos e travadas de áudio" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                        <Border x:Name="LatAudioBadge" Background="#333" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="LatAudioBadgeText" Text="DESLIGADO" FontSize="9" FontWeight="Bold" Foreground="#AAA"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="LatAudioState" Text="Ligue a escuta do áudio. O Kit pergunta ao motor de áudio do Windows quando ele perdeu quadros e cruza cada estalo com disco, drivers, CPU e memória do exato instante." FontSize="11" Foreground="#DDD" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LatAudioStats" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap" LineHeight="15" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="LatAudioLast" Text="" FontSize="11" Foreground="#FFD54F" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button x:Name="BtnLatAudio" Content="🎧 INICIAR ESCUTA" Style="{StaticResource TmToolButton}" Click="BtnLatAudio_Click" ToolTip="Abre a captura em loopback do dispositivo de saída padrão (nada é gravado em disco) e registra cada descontinuidade que o Windows sinalizar"/>
                                        <Button x:Name="BtnLatAudioClear" Content="🧹 Limpar estalos" Style="{StaticResource TmToolButton}" Click="BtnLatAudioClear_Click" ToolTip="Zera a lista de estalos de áudio"/>
                                        <Button x:Name="BtnLatAudioCopy" Content="📋 Copiar (IA)" Style="{StaticResource TmToolButton}" Click="BtnLatAudioCopy_Click" ToolTip="Copia o relatório completo dos estalos de áudio — cole numa IA para análise profunda"/>
                                    </WrapPanel>
                                    <CheckBox x:Name="ChkLatAutoRecover" Content="Recuperar sozinho: sincronizar o motor de áudio quando os estalos se repetirem (o desligar/ligar que resolve, sem você mexer)"
                                              Foreground="#CCC" FontSize="11" VerticalAlignment="Center" Margin="0,8,0,0"
                                              Checked="ChkLatAutoRecover_Changed" Unchecked="ChkLatAutoRecover_Changed"
                                              ToolTip="Quando houver 2+ estalos confirmados em 90s, o Kit congela o motor de áudio por ~300 ms e retoma — o mesmo reset do desligar/ligar, imperceptível. O evento criado pelo próprio reset é marcado como PROVOCADO e nunca conta como estalo real. Máx. 3 por hora."/>
                                    <TextBlock x:Name="LatAudioRecover" Text="" FontSize="10" Foreground="#7FD490" TextWrapping="Wrap" LineHeight="15" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Medidores" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,8"/>

                                    <TextBlock Text="Maior DPC de um driver (0–5 ms)" FontSize="10" Foreground="#999"/>
                                    <TextBlock x:Name="LatBarDpcVal" Text="—" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                    <Border Background="#0D131A" CornerRadius="3" Height="9" Width="260" HorizontalAlignment="Left" Margin="0,3,0,9">
                                        <Border x:Name="LatBarDpc" Background="#4CAF50" CornerRadius="3" Height="9" HorizontalAlignment="Left" Width="2"/>
                                    </Border>

                                    <TextBlock Text="Maior ISR de um driver (0–5 ms)" FontSize="10" Foreground="#999"/>
                                    <TextBlock x:Name="LatBarIsrVal" Text="—" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                    <Border Background="#0D131A" CornerRadius="3" Height="9" Width="260" HorizontalAlignment="Left" Margin="0,3,0,9">
                                        <Border x:Name="LatBarIsr" Background="#4CAF50" CornerRadius="3" Height="9" HorizontalAlignment="Left" Width="2"/>
                                    </Border>

                                    <TextBlock Text="Pior travada do sistema (0–10 s)" FontSize="10" Foreground="#999"/>
                                    <TextBlock x:Name="LatBarStallVal" Text="—" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                    <Border Background="#0D131A" CornerRadius="3" Height="9" Width="260" HorizontalAlignment="Left" Margin="0,3,0,9">
                                        <Border x:Name="LatBarStall" Background="#4CAF50" CornerRadius="3" Height="9" HorizontalAlignment="Left" Width="2"/>
                                    </Border>

                                    <TextBlock Text="Paginação do disco (0–2000 /s; verde se RAM de sobra)" FontSize="10" Foreground="#999"/>
                                    <TextBlock x:Name="LatBarHfVal" Text="—" FontSize="11" Foreground="White" FontWeight="SemiBold"/>
                                    <Border Background="#0D131A" CornerRadius="3" Height="9" Width="260" HorizontalAlignment="Left" Margin="0,3,0,0">
                                        <Border x:Name="LatBarHf" Background="#4CAF50" CornerRadius="3" Height="9" HorizontalAlignment="Left" Width="2"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="O que o Kit está escutando" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17"><Run Foreground="#4FC3F7" FontWeight="Bold">DPC</Run> — trabalho que o driver faz ANTES de qualquer programa. Se demora demais, áudio estala e o jogo engasga.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">ISR</Run> — atendimento de hardware (placa de rede, disco, USB). Picos aparecem como travadinhas curtas.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">Paginação</Run> — quando falta RAM, o Windows busca no disco. Cada busca congela o programa que pediu.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">Janela travada</Run> — aquele "Não respondendo". O Kit marca quando começou, quanto durou e em qual programa.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">Sistema travado</Run> — se TODOS os programas pararem juntos, o Kit registra e mostra o horário exato.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4CAF50" FontWeight="Bold">Estalo de áudio</Run> — o motor de áudio do Windows avisa quando precisou pular quadros. O Kit mostra quanto áudio se perdeu, o que estava tocando e o que o sistema fazia no mesmo instante.</TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Como ler" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17"><Run Foreground="#4CAF50" FontWeight="Bold">Verde</Run> = saudável. <Run Foreground="#FFB74D" FontWeight="Bold">Laranja</Run> = atenção. <Run Foreground="#F44336" FontWeight="Bold">Vermelho</Run> = está causando travamento agora.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0">Clique numa linha de <Run FontWeight="Bold">Eventos</Run> e passe o mouse: a explicação completa (o que significa e o que fazer) aparece no tooltip.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0">O nome do <Run FontWeight="Bold">driver</Run> exato só aparece com o Kit como administrador. Sem admin, o Kit continua medindo — só não sabe dizer o arquivo.</TextBlock>
                                    <TextBlock Text="Dica: deixe rodando enquanto o problema acontece. Depois clique em 'Copiar relatório (IA)'." FontSize="11" Foreground="#4FC3F7" TextWrapping="Wrap" LineHeight="17" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ══════════════════════════════════════════════════════════════
                     ABA ARMAZENAMENTO — "meu disco está em 100%, o que exatamente
                     está fazendo isso?"
                     Fluxo: FATO (atividade/fila/latência) → HIPÓTESE (quem faz E/S)
                     → CORRELAÇÃO (teste de impacto medindo antes/depois) → AÇÃO.
                     ══════════════════════════════════════════════════════════════ -->
                <Grid x:Name="TabStorage" Visibility="Collapsed">
                    <Grid.Resources>
                        <Style TargetType="ToolTip" BasedOn="{StaticResource InfoTipWrap}"/>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                            <Setter Property="ToolTipService.InitialShowDelay" Value="900"/>
                            <Setter Property="ToolTipService.ShowDuration" Value="60000"/>
                            <Setter Property="ToolTipService.BetweenShowDelay" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#26262C"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/></Trigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="330"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + ações -->
                    <Grid Grid.Row="0" Grid.ColumnSpan="2" Margin="14,12,14,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Diagnóstico de Armazenamento" FontSize="18" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Border x:Name="StStateBadge" Background="#333" CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="StState" Text="PARADO" FontSize="10" FontWeight="Bold" Foreground="#AAA"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="O Kit separa FATO de HIPÓTESE: mede o disco, ranqueia quem está fazendo E/S e, quando você pede, testa a hipótese suspendendo o suspeito e comparando antes/depois. Nada é afirmado sem medição." FontSize="11" Foreground="#777" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="BtnStToggle" Content="▶ ESCUTAR" Style="{StaticResource TmToolButton}" Click="BtnStToggle_Click" Width="104" ToolTip="Começa a medir os discos e ranquear quem está fazendo E/S"/>
                            <Button x:Name="BtnStCopy" Content="📋 Copiar relatório (IA)" Style="{StaticResource TmToolButton}" Click="BtnStCopy_Click" ToolTip="Copia o relatório técnico completo — cole numa IA"/>
                            <Button x:Name="BtnStElevate" Content="🛡️ Admin" Style="{StaticResource TmToolButton}" Click="BtnStElevate_Click" ToolTip="Reiniciar como administrador para suspender processos de outros usuários"/>
                        </StackPanel>
                    </Grid>

                    <!-- Faixa de métricas do disco em foco -->
                    <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Margin="14,0,14,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DISCO" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StDiskTitle" Text="—" FontSize="16" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="StDiskMeta" Text="" FontSize="9" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ATIVIDADE" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StActivity" Text="—" FontSize="17" FontWeight="Bold" Foreground="#4CAF50"/>
                                <TextBlock x:Name="StActivityHint" Text="tempo ocupado" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="LEITURA" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StRead" Text="—" FontSize="15" FontWeight="Bold" Foreground="#4FC3F7"/>
                                <TextBlock Text="do disco" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="ESCRITA" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StWrite" Text="—" FontSize="15" FontWeight="Bold" Foreground="#FFB74D"/>
                                <TextBlock Text="para o disco" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="FILA" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StQueue" Text="—" FontSize="15" FontWeight="Bold" Foreground="#FFB74D"/>
                                <TextBlock x:Name="StQueueHint" Text="operações esperando" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="LATÊNCIA" FontSize="9" Foreground="#888"/>
                                <TextBlock x:Name="StLatency" Text="—" FontSize="15" FontWeight="Bold" Foreground="#FFB74D"/>
                                <TextBlock x:Name="StTransfers" Text="—" FontSize="9" Foreground="#666"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Coluna esquerda: seleção de disco + histórico + diagnóstico + tabela -->
                    <Grid Grid.Row="2" Grid.Column="0" Margin="14,0,8,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Seletor de discos em chips (um botão por disco físico) -->
                        <StackPanel x:Name="StDiskChips" Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8"/>

                        <!-- Histórico curto (antes/depois das intervenções) -->
                        <Border Grid.Row="1" Background="#141C28" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Atividade nos últimos 60 s" FontSize="10" Foreground="#999"/>
                                    <Canvas x:Name="StChartActivity" Height="38" Background="#0B1018" ClipToBounds="True" Margin="0,2,4,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Fila de operações" FontSize="10" Foreground="#999"/>
                                    <Canvas x:Name="StChartQueue" Height="38" Background="#0B1018" ClipToBounds="True" Margin="0,2,4,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Latência (ms)" FontSize="10" Foreground="#999"/>
                                    <Canvas x:Name="StChartLatency" Height="38" Background="#0B1018" ClipToBounds="True" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tabela: quem está fazendo E/S -->
                        <DataGrid x:Name="DgStProcs" Grid.Row="2" Style="{StaticResource TmGrid}" SelectionChanged="DgStProcs_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Processo" Width="2*" SortMemberPath="TotalBps">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Image Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding Name}" FontSize="11" Foreground="#DDD" VerticalAlignment="Center"/>
                                                <Border x:Name="SuspTag" Background="#5C4B00" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding SuspensionVisibility}">
                                                    <TextBlock Text="SUSPENSO" FontSize="8" FontWeight="Bold" Foreground="#FFD54F"/>
                                                </Border>
                                                <Border Background="#3A2020" CornerRadius="3" Padding="4,0" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ServiceVisibility}">
                                                    <TextBlock Text="{Binding ServiceBadge}" FontSize="8" Foreground="#FF8A80"/>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65"/>
                                <DataGridTextColumn Header="Leitura" Binding="{Binding Read}" Width="90"/>
                                <DataGridTextColumn Header="Escrita" Binding="{Binding Write}" Width="90"/>
                                <DataGridTemplateColumn Header="Total" Width="95" SortMemberPath="TotalBps">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Total}" FontSize="11" Foreground="{Binding TotalColor}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ops/s" Binding="{Binding Iops}" Width="80"/>
                                <DataGridTextColumn Header="Serviço" Binding="{Binding ServiceText}" Width="*" MinWidth="120"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Aviso de tabela vazia -->
                        <TextBlock x:Name="StEmptyHint" Grid.Row="2" Text="" Visibility="Collapsed" FontSize="12" Foreground="#888"
                                   TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextAlignment="Center" LineHeight="19"/>

                        <!-- Painel de investigação (dossiê do processo) -->
                        <Border x:Name="StInvestigatePanel" Grid.Row="3" Visibility="Collapsed" Background="#101822" BorderBrush="#2A3A4E" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0" MaxHeight="240">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Investigação do processo" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" VerticalAlignment="Center"/>
                                    <Button Content="Copiar" Style="{StaticResource TmToolButton}" Height="22" Padding="8,0" Margin="10,0,0,0" Click="BtnStCopyInvestigate_Click"/>
                                    <Button Content="Fechar" Style="{StaticResource TmToolButton}" Height="22" Padding="8,0" Click="BtnStCloseInvestigate_Click"/>
                                </StackPanel>
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="StInvestigateText" Text="" FontSize="11" Foreground="#CCC" TextWrapping="Wrap" LineHeight="17" FontFamily="Consolas"/>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Coluna direita: diagnóstico + ações + explicação -->
                    <ScrollViewer Grid.Row="2" Grid.Column="1" Margin="0,0,14,12" VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- DIAGNÓSTICO -->
                            <Border x:Name="StDiagCard" Background="#141C28" BorderBrush="#4CAF50" BorderThickness="1,0,0,0" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="StDiagTitle" Text="Diagnóstico" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" VerticalAlignment="Center"/>
                                        <Border x:Name="StDiagBadge" Background="#243024" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="StDiagBadgeText" Text="AGUARDANDO" FontSize="9" FontWeight="Bold" Foreground="#4CAF50"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="StDiagText" Text="Clique em ESCUTAR. O Kit mede o disco e mostra quem está fazendo E/S. Nada é dado como causa sem teste." FontSize="11" Foreground="#DDD" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <TextBlock x:Name="StCandidate" Text="" FontSize="11" Foreground="#FFD54F" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>

                                    <TextBlock Text="AÇÕES" FontSize="9" Foreground="#666" Margin="0,10,0,4"/>
                                    <WrapPanel>
                                        <Button x:Name="BtnStInvestigate" Content="🔍 Investigar" Style="{StaticResource TmToolButton}" Click="BtnStInvestigate_Click" ToolTip="Reunir tudo que o Kit sabe sobre o processo marcado"/>
                                        <Button x:Name="BtnStTest" Content="🧪 Testar impacto" Style="{StaticResource TmToolButton}" Click="BtnStTest_Click" ToolTip="Suspende o processo por alguns segundos e compara o disco antes/depois — a única forma de provar a causa"/>
                                        <Button x:Name="BtnStSweep" Content="🔎 Varrer suspeitos" Style="{StaticResource TmToolButton}" Click="BtnStSweep_Click" ToolTip="Testa os maiores consumidores um por um, sozinho, até achar um que realmente alivia o disco"/>
                                        <Button x:Name="BtnStSuspend" Content="⏸ Suspender" Style="{StaticResource TmToolButton}" Click="BtnStSuspend_Click" ToolTip="Congela o processo (não encerra). Sempre reversível"/>
                                        <Button x:Name="BtnStResume" Content="▶ Retomar" Style="{StaticResource TmToolButton}" Click="BtnStResume_Click" ToolTip="Volta a rodar o processo suspenso"/>
                                        <Button x:Name="BtnStRestartSvc" Content="🔄 Reiniciar serviço" Style="{StaticResource TmToolButton}" Click="BtnStRestartSvc_Click" ToolTip="Quando o processo é um serviço, reiniciar é a intervenção correta (não matar o processo)"/>
                                        <Button x:Name="BtnStStopSvc" Content="⏹ Parar serviço" Style="{StaticResource TmToolButton}" Click="BtnStStopSvc_Click" ToolTip="Parar o serviço hospedado neste PID (mais seguro que matar)"/>
                                        <Button x:Name="BtnStStartSvc" Content="▶ Iniciar serviço" Style="{StaticResource TmToolButton}" Click="BtnStStartSvc_Click" ToolTip="Iniciar de volta o serviço que foi parado"/>
                                        <Button x:Name="BtnStForceStop" Content="⚡ Force Stop" Style="{StaticResource TmToolButton}" Click="BtnStForceStop_Click" ToolTip="Último recurso: encerrar de verdade, liberando handles e drivers"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="StActionHint" Text="" FontSize="10" Foreground="#888" TextWrapping="Wrap" LineHeight="15" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RESULTADO DO TESTE DE IMPACTO -->
                            <Border x:Name="StImpactCard" Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="Teste de impacto" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock x:Name="StImpactTitle" Text="" FontSize="13" FontWeight="Bold" Foreground="#FFF" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="StImpactText" Text="" FontSize="11" Foreground="#CCC" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <Grid x:Name="StImpactTable" Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="105"/><ColumnDefinition Width="70"/><ColumnDefinition Width="70"/><ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Antes / Depois" FontSize="9" Foreground="#666"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="ANTES" FontSize="9" Foreground="#888" HorizontalAlignment="Right"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="DEPOIS" FontSize="9" Foreground="#888" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Atividade" FontSize="10" Foreground="#AAA"/>
                                        <TextBlock x:Name="StImpActB" Grid.Row="1" Grid.Column="1" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="StImpActA" Grid.Row="1" Grid.Column="2" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Fila" FontSize="10" Foreground="#AAA"/>
                                        <TextBlock x:Name="StImpQb" Grid.Row="2" Grid.Column="1" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="StImpQa" Grid.Row="2" Grid.Column="2" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Latência" FontSize="10" Foreground="#AAA"/>
                                        <TextBlock x:Name="StImpLb" Grid.Row="3" Grid.Column="1" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="StImpLa" Grid.Row="3" Grid.Column="2" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Escrita" FontSize="10" Foreground="#AAA"/>
                                        <TextBlock x:Name="StImpWb" Grid.Row="4" Grid.Column="1" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>
                                        <TextBlock x:Name="StImpWa" Grid.Row="4" Grid.Column="2" Text="—" FontSize="10" Foreground="#FFF" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- COMO O KIT DECIDE -->
                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="Fato, hipótese e prova" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17"><Run Foreground="#4FC3F7" FontWeight="Bold">FATO</Run> — o disco está ocupado X%, com fila e latência medidas.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#FFB74D" FontWeight="Bold">HIPÓTESE</Run> — quem mais transferiu bytes. Estar no topo NÃO prova culpa: muitos programas pequenos somados podem pesar mais que um grande.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4CAF50" FontWeight="Bold">PROVA</Run> — o teste de impacto: com o processo suspenso, o disco ficou livre? Se sim, a correlação é real. Se não, o Kit diz que ele NÃO é o culpado.</TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- GLOSSÁRIO -->
                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="O que o Kit está medindo" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17"><Run Foreground="#4FC3F7" FontWeight="Bold">Atividade</Run> — fração do último segundo em que o disco esteve ocupado. 100% com poucos MB/s significa fila/latência, não vazão.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">Fila</Run> — quantas operações estão esperando. Fila acima de 2 já atrasa o que você sente.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0"><Run Foreground="#4FC3F7" FontWeight="Bold">Latência</Run> — tempo médio de cada operação. Acima de 15 ms trava o sistema; um HDD saudável fica abaixo de 12 ms.</TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- SEGURANÇA -->
                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <StackPanel>
                                    <TextBlock Text="Segurança das intervenções" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,0,0,6"/>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17">O Kit <Run FontWeight="Bold">nunca</Run> suspende nem encerra processos do núcleo do Windows — mostra o motivo no lugar do botão.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0">Suspender é sempre reversível: o processo é retomado ao fim do teste, ao clicar em Retomar ou ao fechar a janela.</TextBlock>
                                    <TextBlock FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,0">Quando o processo é um serviço, o Kit oferece reiniciar/parar o serviço — que é a intervenção correta — em vez de matar o processo.</TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- ÁUDIO x ARMAZENAMENTO: o estalo de áudio é a "prova dos nove"
                                 de saturação de disco que o usuário sente antes de ver número. -->
                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Áudio e armazenamento" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" VerticalAlignment="Center"/>
                                        <Border x:Name="StAudioBadge" Background="#333" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="StAudioBadgeText" Text="DESLIGADO" FontSize="9" FontWeight="Bold" Foreground="#AAA"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock x:Name="StAudioText" Text="O Kit escuta o áudio do Windows (via API oficial de detecção de glitch) e cruza cada estalo com o estado do disco no mesmo instante. Isso separa 'o disco estava saturado' de fato." FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <Button x:Name="BtnStAudio" Content="🎧 Escutar o áudio" Style="{StaticResource TmToolButton}" Click="BtnStAudio_Click" Margin="0,8,0,0" ToolTip="Liga/desliga a escuta de glitches de áudio. Os detalhes completos ficam na aba Latência e travamentos."/>
                                </StackPanel>
                            </Border>

                            <!-- DIÁRIO DE INTERVENÇÕES: nenhuma ação do Kit pode ser invisível. -->
                            <Border Background="#161F2C" BorderBrush="#1F2A3A" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Diário de intervenções" FontSize="12" FontWeight="Bold" Foreground="#4FC3F7" VerticalAlignment="Center"/>
                                        <Border x:Name="StJournalBadge" Background="#333" CornerRadius="3" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock x:Name="StJournalBadgeText" Text="NADA FEITO" FontSize="9" FontWeight="Bold" Foreground="#AAA"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="Tudo que o Kit suspendeu, parou ou reiniciou nesta sessão fica registrado aqui — com a hora e se já foi revertido." FontSize="11" Foreground="#BBB" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                                    <TextBox x:Name="StJournalText" Text="" IsReadOnly="True" Background="#0D131A" BorderBrush="#1F2A3A" BorderThickness="1"
                                             Foreground="#9CC7E8" FontFamily="Consolas, Cascadia Mono, monospace" FontSize="10" Height="112" Margin="0,7,0,0"
                                             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                                    <WrapPanel Margin="0,7,0,0">
                                        <Button x:Name="BtnStUndoAll" Content="↩ Desfazer tudo agora" Style="{StaticResource TmToolButton}" Click="BtnStUndoAll_Click" ToolTip="Retoma todo processo que o Kit suspendeu e restaurá os serviços que ele parou"/>
                                        <Button x:Name="BtnStJournalClear" Content="Limpar diário" Style="{StaticResource TmToolButton}" Click="BtnStJournalClear_Click" ToolTip="Só limpa a lista — não mexe em nenhum processo"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
