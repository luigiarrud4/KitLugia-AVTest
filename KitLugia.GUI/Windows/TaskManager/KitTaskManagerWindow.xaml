<Window x:Class="KitLugia.GUI.Windows.TaskManager.KitTaskManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:tm="clr-namespace:KitLugia.GUI.Windows.TaskManager"
        Title="Gerenciador de Tarefas - KIT LUGIA" Height="780" Width="1300" MinWidth="1000" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Background="#111823"
        WindowStyle="None"
        MaxWidth="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Width}"
        MaxHeight="{Binding Source={x:Static SystemParameters.WorkArea}, Path=Height}"
        ShowInTaskbar="False"
        TextElement.Foreground="White"
        TextElement.FontFamily="Segoe UI Variable, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        Foreground="White"
        KeyDown="Window_KeyDown"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" ResizeBorderThickness="6"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- ==== PALETA E ESTILOS-BASE DO KIT TASK MANAGER ====
             Fonte unica do visual do TM (o mapa completo esta em docs/TM_STYLE_MAP.md).
             Fora desta paleta = divergencia. -->
        <SolidColorBrush x:Key="TmBgDeep"       Color="#0D131A"/>
        <SolidColorBrush x:Key="TmBgWindow"     Color="#111823"/>
        <SolidColorBrush x:Key="TmBgCard"       Color="#141C28"/>
        <SolidColorBrush x:Key="TmBgHeader"     Color="#1A2432"/>
        <SolidColorBrush x:Key="TmBgControl"    Color="#1F2A3A"/>
        <SolidColorBrush x:Key="TmBgHover"      Color="#243040"/>
        <SolidColorBrush x:Key="TmBgNavHover"   Color="#1C2634"/>
        <SolidColorBrush x:Key="TmBgNavPress"   Color="#26334A"/>
        <SolidColorBrush x:Key="TmBorder"       Color="#1F2A3A"/>
        <SolidColorBrush x:Key="TmBorderStrong" Color="#2C3A4E"/>
        <SolidColorBrush x:Key="TmAccent"       Color="#4FC3F7"/>
        <SolidColorBrush x:Key="TmAccentDeep"   Color="#2196F3"/>
        <SolidColorBrush x:Key="TmSelect"       Color="#17324F"/>
        <SolidColorBrush x:Key="TmText"         Color="#EEEEEE"/>
        <SolidColorBrush x:Key="TmTextDim"      Color="#AAAAAA"/>
        <SolidColorBrush x:Key="TmTextMuted"    Color="#888888"/>
        <SolidColorBrush x:Key="TmTextFaint"    Color="#666666"/>
        <SolidColorBrush x:Key="TmGood"         Color="#4CAF50"/>
        <SolidColorBrush x:Key="TmWarn"         Color="#FF9800"/>
        <SolidColorBrush x:Key="TmBad"          Color="#F44336"/>
        <SolidColorBrush x:Key="TmRam"          Color="#B36AE2"/>
        <SolidColorBrush x:Key="TmNet"          Color="#9C27B0"/>

        <!-- == CONTROLES BASE ==
             O tema GLOBAL do Kit pinta Button/CheckBox/DataGrid com DOURADO (#FFD700) e um
             "zoom" no hover. Estas definicoes vivem no Window.Resources e vencem o tema
             SOMENTE dentro do Gerenciador de Tarefas: qualquer controle que nao tenha estilo
             proprio ja sai no azul do TM. -->
        <Style TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bdr" Property="Background" Value="{StaticResource TmBgHover}"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="{StaticResource TmSelect}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- CheckBox compacto (o global tem 22x22 com marca e borda DOURADAS). -->
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#CCC"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="15" Height="15" CornerRadius="3" Background="{StaticResource TmBgControl}"
                                    BorderBrush="{StaticResource TmBorderStrong}" BorderThickness="1" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Path x:Name="Mark" Data="M1,6 L5,10 L12,1" Stroke="{StaticResource TmAccent}" StrokeThickness="2"
                                      Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TmAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TmAccent}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Separador de menu (o global e #333, sem contraste com o fundo do TM). -->
        <Style TargetType="{x:Type Separator}">
            <Setter Property="Background" Value="{StaticResource TmBorder}"/>
            <Setter Property="Margin" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Separator}">
                        <Rectangle Height="1" Fill="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Linha das tabelas de diagnostico (TmGrid): selecao AZUL, nunca o banho dourado
             (#25FFD700) que o estilo global de DataGridRow aplicava aqui. -->
        <Style x:Key="TmGridRow" TargetType="DataGridRow">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{StaticResource TmBgHover}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{StaticResource TmSelect}"/><Setter Property="Foreground" Value="White"/></Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True"/>
                        <Condition Property="IsSelected" Value="True"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="#28507E"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>

        <!-- Cartao padrao de todas as abas. -->
        <Style x:Key="TmCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TmBgCard}"/>
            <Setter Property="BorderBrush" Value="{StaticResource TmBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <!-- Titulo de secao dentro de um cartao. -->
        <Style x:Key="TmSectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TmAccent}"/>
        </Style>

        <!-- Selo de estado. -->
        <Style x:Key="TmBadge" TargetType="Border">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ══ ToolTip de INFORMAÇÃO (mesmo balão das páginas Tweaks/GameBoost) ══
             Usado pela aba Latência: passar o mouse e ESPERAR um pouco mostra a
             explicação completa (o que aconteceu, quem causou, por que e o que fazer).
             InitialShowDelay maior = o balão só aparece quando você realmente quer. -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#111823"/>
            <Setter Property="Foreground" Value="#FFF"/>
            <Setter Property="BorderBrush" Value="#4FC3F7"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MaxWidth" Value="520"/>
            <Setter Property="HasDropShadow" Value="False"/>
        </Style>

        <!-- ToolTip que QUEBRA LINHA (para textos longos da aba Latência).
             Fica com chave para não afetar os balões que já contam conteúdo rico
             (StackPanel com seções), como os das páginas Tweaks/GameBoost. -->
        <Style x:Key="InfoTipWrap" TargetType="ToolTip">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" LineHeight="17"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Aba Usuários: cada linha expande para mostrar os processos do usuário
             (o DataGridRow.DetailsVisibility segue o IsExpanded do item). -->
        <Style x:Key="UserRowStyle" TargetType="DataGridRow">
            <Setter Property="DetailsVisibility" Value="{Binding DetailsVisibility}"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#243040"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#17324F"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de toolbar padrão (Serviços/Inicialização) — mesmo visual da aba Processos -->
        <Style x:Key="TmToolButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="11,0"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="#1F2A3A" BorderBrush="#2C3A4E" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#33333C"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="#4FC3F7"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bdr" Property="Background" Value="#3A4C66"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bdr" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- DataGrid escuro padrão das tabelas de diagnóstico (aba Latência) -->
        <Style x:Key="TmGrid" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="#141C28"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="RowHeight" Value="26"/>
            <Setter Property="RowStyle" Value="{StaticResource TmGridRow}"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#1A2432"/>
                        <Setter Property="Foreground" Value="#888"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="8,5"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1F2A3A"/>
                        <Setter Property="ClipToBounds" Value="True"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="#DDD"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Setter Property="ToolTip" Value="{Binding Tooltip}"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#243040"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#17324F"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Menu de contexto escuro padrão -->
        <Style x:Key="TmDarkMenu" TargetType="ContextMenu">
            <Setter Property="Background" Value="#141C28"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="4">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TmMenuItem" TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Margin" Value="2,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{TemplateBinding Icon}" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#AAA"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" FontSize="10" Foreground="#666" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <!-- Seta + POPUP do submenu, no azul do TM. Sem isto o item com
                                     filhos ("Prioridade" > 7 niveis) parecia um comando comum e
                                     clicar nele NAO abria nada — submenu inacessivel. -->
                                <TextBlock x:Name="SubmenuArrow" Grid.Column="3" Text="&#x25B6;" FontSize="8" Foreground="#4FC3F7"
                                           VerticalAlignment="Center" Margin="10,0,2,0" Visibility="Collapsed"/>
                                <Popup x:Name="SubmenuHost" Placement="Right" VerticalOffset="-3" HorizontalOffset="-6"
                                       IsOpen="{TemplateBinding IsSubmenuOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                    <Border Background="#141C28" BorderBrush="#2C3A4E" BorderThickness="1" CornerRadius="6" Padding="4">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#243040"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#555"/></Trigger>
                            <Trigger Property="HasItems" Value="True"><Setter TargetName="SubmenuArrow" Property="Visibility" Value="Visible"/></Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Bd" Property="Background" Value="#243040"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ══ Estilos COMPARTILHADOS das tabelas (todas as abas iguais) ══
             Cabeçalho #1A2432/#888, hover #243040, seleção #17324F, célula sem borda.
             Aba Usuários usa este mesmo RowStyle (o DetailsVisibility vem do item). -->
        <Style x:Key="TmColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#1A2432"/>
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="BorderBrush" Value="#1F2A3A"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <!-- Recorta o cabeçalho na própria coluna (mesma razão do TmCellStyle). -->
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>
        <Style x:Key="TmRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#EEE"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#243040"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#17324F"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- ABa USUÁRIOS: o RowStyle precisa LIGAR o DetailsVisibility ao item.
             Sem este Setter o DataGrid recicla o container da linha durante o scroll e o
             detalhe volta a colapsar sozinho (o "cliquei na seta e o card fecha"). -->
        <Style x:Key="TmUserRowStyle" TargetType="DataGridRow" BasedOn="{StaticResource TmRowStyle}">
            <Setter Property="DetailsVisibility" Value="{Binding DetailsVisibility}"/>
        </Style>
        <Style x:Key="TmCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="Padding" Value="6,2"/>
            <!-- SEM este recorte o texto longo VAZAVA para a coluna vizinha e o valor da
                 coluna seguinte era desenhado em cima dele. Medido pelo TmVisualBench
                 (ex.: nome do processo sobrepondo o valor de "CPU" no Top CPU). -->
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Implicitos do TM: vencem o tema GLOBAL em qualquer tabela que nao tenha
             estilo proprio. Era daqui que vinha o cabecalho #1A1A1A com o texto DOURADO
             nas abas Latencia / Armazenamento / Diagnostico (o TmGrid declara o estilo por
             Setter, e o tema global acabava vencendo). -->
        <Style TargetType="{x:Type DataGridColumnHeader}" BasedOn="{StaticResource TmColumnHeaderStyle}"/>
        <Style TargetType="{x:Type DataGridCell}" BasedOn="{StaticResource TmCellStyle}"/>
        <Style TargetType="{x:Type DataGridRow}" BasedOn="{StaticResource TmRowStyle}">
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <!-- ══ BARRA DE ROLAGEM no azul do TM ══
             O tema global do Kit anima o polegar para DOURADO no hover; dentro do TM (azul) isso
             destoa — e a barra larga do tema aparecia amarela no popup do combo. -->
        <Style x:Key="TmScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Background" Value="#2C3A4E"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Th" Background="#2C3A4E" CornerRadius="4" Margin="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Th" Property="Background" Value="#4FC3F7"/></Trigger>
                            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Th" Property="Background" Value="#4FC3F7"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TmScrollBar" TargetType="ScrollBar">
            <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.Thumb><Thumb Style="{StaticResource TmScrollBarThumb}"/></Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="8"/><Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Implicito: todo ScrollBar dentro do TM (tabelas, paineis, popup do combo). -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource TmScrollBar}"/>

        <!-- ══ COMBOBOX no azul do TM ══
             O combo global do Kit pinta a borda e o item destacado de DOURADO. -->
        <Style x:Key="TmComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDD"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="It" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2,1" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="It" Property="Background" Value="#243040"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="It" Property="Background" Value="#17324F"/>
                                <Setter Property="Foreground" Value="#4FC3F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TmComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1F2A3A"/>
            <Setter Property="BorderBrush" Value="#2C3A4E"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TmComboBoxItem}"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="MainBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4"/>
                            <ToggleButton Focusable="False" ClickMode="Press" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent">
                                            <Path x:Name="Arrow" Data="M0,0 L4,4 L8,0" Stroke="#8FA3B8" StrokeThickness="1.4"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,1,9,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Arrow" Property="Stroke" Value="#4FC3F7"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
