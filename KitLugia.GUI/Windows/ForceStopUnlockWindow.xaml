<Window x:Class="KitLugia.GUI.Windows.ForceStopUnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Force Stop Unlock"
        Width="750" Height="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        BorderBrush="#3A3A50"
        BorderThickness="1"
        FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Arial"
        ResizeMode="CanResizeWithGrip"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="ProcessListStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#12122A" Padding="20,16" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="&#x1F513;" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Force Stop Unlock" FontSize="20" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Identifique e libere arquivos bloqueados por processos" FontSize="12" Foreground="#888" Margin="0,2,0,0"/>
                </StackPanel>

                <Button Grid.Column="2" Content="&#x2715;" Width="32" Height="32"
                        Background="Transparent" Foreground="#888" BorderThickness="0"
                        FontSize="16" Cursor="Hand" Click="BtnClose_Click"
                        HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- INPUT AREA -->
        <Border Grid.Row="1" Background="#14142A" Padding="20,14" BorderBrush="#3A3A50" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" CornerRadius="6" Background="#1A1A30" BorderBrush="#3A3A50" BorderThickness="1" Padding="10,0" Margin="0,0,10,0">
                    <TextBox x:Name="TxtPath" Background="Transparent" Foreground="White"
                             BorderThickness="0" FontSize="13" VerticalContentAlignment="Center"
                             Height="36" TextChanged="TxtPath_TextChanged"/>
                </Border>

                <Button Grid.Column="1" Content="&#x1F4C1;" Width="36" Height="36" FontSize="16"
                        Background="#222244" Foreground="White" BorderThickness="0"
                        Cursor="Hand" Click="BtnBrowse_Click" Margin="0,0,6,0"
                        ToolTip="Selecionar arquivo ou pasta"/>

                <Button Grid.Column="2" Content="&#x1F50D; Analisar" Width="100" Height="36"
                        Background="#3355AA" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnAnalyze_Click"
                        x:Name="BtnAnalyze" Margin="0,0,6,0"/>

                <Button Grid.Column="3" Content="&#x26A1; Liberar" Width="100" Height="36"
                        Background="#AA3333" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnUnlock_Click"
                        x:Name="BtnUnlock" IsEnabled="False"/>
            </Grid>
        </Border>

        <!-- STATUS OVERLAY -->
        <Border Grid.Row="2" x:Name="StatusOverlay" Visibility="Visible" Background="#0D0D1A">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="&#x1F513;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16" Opacity="0.5"/>
                    <TextBlock x:Name="TxtStatus" Text="Cole o caminho de um arquivo ou pasta bloqueada e clique em Analisar"
                               FontSize="14" Foreground="#666" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="400"/>
                    <ProgressBar x:Name="ProgressBar" Width="200" Height="4" Margin="0,16,0,0"
                                 Background="#222" Foreground="#4488FF" BorderThickness="0" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- RESULTS LIST -->
        <Border Grid.Row="2" x:Name="ResultsPanel" Visibility="Collapsed" Background="#0D0D1A" Padding="20,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Summary bar -->
                <Border Grid.Row="0" CornerRadius="8" Background="#1A1A28" BorderBrush="#3A3A50" BorderThickness="1" Padding="14,10" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="TxtSummary" Grid.Column="0" Text="Encontrados: 0 processo(s)"
                                   FontSize="13" FontWeight="SemiBold" Foreground="#CCC" VerticalAlignment="Center"/>

                        <TextBlock x:Name="TxtMethodInfo" Grid.Column="1" Text="" FontSize="11"
                                   Foreground="#888" VerticalAlignment="Center" Margin="12,0,0,0"/>

                        <CheckBox x:Name="ChkSelectAll" Grid.Column="2" Content="Selecionar Todos"
                                  Foreground="#AAA" FontSize="12" VerticalAlignment="Center"
                                  IsChecked="True" Click="ChkSelectAll_Click"/>
                    </Grid>
                </Border>

                <!-- Process list -->
                <ListBox Grid.Row="1" x:Name="ProcessList"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="8" Background="#16162A" BorderBrush="#2A2A40" BorderThickness="1"
                                    Padding="14,10" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}"
                                              VerticalAlignment="Center" Margin="0,0,12,0"
                                              Foreground="#AAA"/>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayLabel}" FontSize="13"
                                                   FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding DetailLabel}" FontSize="11"
                                                   Foreground="#777" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border Grid.Column="2" CornerRadius="4" Background="#222244"
                                            Padding="8,3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding HandleType}" FontSize="10"
                                                   Foreground="#8888CC"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="3" x:Name="ActionBar" Visibility="Collapsed"
                Background="#12122A" Padding="20,12" BorderBrush="#3A3A50" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtResult" Grid.Column="0" Text="" FontSize="12"
                           Foreground="#AAA" VerticalAlignment="Center" TextWrapping="Wrap"/>

                <Button Grid.Column="1" Content="&#x26A1; Liberar Selecionados" Width="180" Height="36"
                        Background="#AA3333" Foreground="White" BorderThickness="0"
                        FontWeight="SemiBold" Cursor="Hand" Click="BtnUnlock_Click"
                        x:Name="BtnUnlockBottom"/>
            </Grid>
        </Border>

        <!-- BOTTOM STATUS -->
        <Border Grid.Row="4" Background="#0A0A18" Padding="20,8" BorderBrush="#3A3A50" BorderThickness="0,1,0,0">
            <TextBlock x:Name="TxtBottomStatus" Text="Pronto" FontSize="11" Foreground="#555"/>
        </Border>
    </Grid>
</Window>
