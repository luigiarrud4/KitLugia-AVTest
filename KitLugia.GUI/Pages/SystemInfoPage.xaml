<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.SystemInfoPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:KitLugia.GUI.Pages"
      mc:Ignorable="d"
      Title="Informações do Sistema"
      TextElement.FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Page.Resources>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Informações do Sistema" FontSize="26" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Monitoramento em tempo real — CPU, GPU, RAM, disco e rede" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Gauges -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,16">
            <!-- CPU Gauge -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="CPU" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Grid Width="110" Height="110">
                        <Ellipse Stroke="#2A2A2A" StrokeThickness="8" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="ArcCpu" Stroke="{StaticResource AccentColor}" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        <TextBlock x:Name="TxtCpuPct" Text="0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtCpuName" Text="-" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="120"/>
                    <TextBlock x:Name="TxtCpuTemp" Text="Temp: -°C" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- RAM Gauge -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="RAM" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Grid Width="110" Height="110">
                        <Ellipse Stroke="#2A2A2A" StrokeThickness="8" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="ArcRam" Stroke="#B36AE2" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        <TextBlock x:Name="TxtRamPct" Text="0%" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtRam" Text="- / - GB" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    <TextBlock x:Name="TxtRamUsed" Text="Usado: -" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,2"/>
                </StackPanel>
            </Border>

            <!-- GPU Gauge -->
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="6">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <Grid Width="110" Height="110">
                        <Ellipse Stroke="#2A2A2A" StrokeThickness="8" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Path x:Name="ArcGpu" Stroke="#4CAF50" StrokeThickness="8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        <TextBlock x:Name="TxtGpuPct" Text="-" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="TxtGpuName" Text="-" FontSize="10" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="120"/>
                    <TextBlock x:Name="TxtGpuTemp" Text="Temp: -°C" FontSize="11" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Info cards -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="💻 Sistema" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,8"/>
                        <TextBlock x:Name="TxtPc" Text="PC: -" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="TxtOs" Text="SO: -" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="TxtArch" Text="Arquitetura: -" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="TxtUptime" Text="Uptime: -" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2"/>
                        <TextBlock x:Name="TxtCores" Text="Núcleos lógicos: -" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="💾 Armazenamento" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListStorage">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="🌐 Rede" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListNetwork">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="6" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="🛠️ Sistema (BIOS / Placa-Mãe / SO)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ListSystemDetail">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="12" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
