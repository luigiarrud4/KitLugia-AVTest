<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.PrivacyPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:controls="clr-namespace:KitLugia.GUI.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="900"
      Title="Privacy Manager"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,30,30,50" MaxWidth="1000">

            <!-- Header -->
            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="Gerenciador de Privacidade" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>
                <TextBlock Text="Controle a telemetria, rastreamento e dados enviados para a Microsoft." Foreground="{StaticResource TextSecondary}"/>
            </StackPanel>

            <!-- Status Geral: protecao POR NIVEL (verdes/amarelos/vermelhos) -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PROTE&#xC7;&#xC3;O ATUAL" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>

                        <!-- Verdes -->
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#4CAF50" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Seguros (Recomendado)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TxtProtSafe" Text="0 / 0" FontSize="12" FontWeight="Bold" Foreground="#4CAF50" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="3" x:Name="PbSafe" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#4CAF50" Background="#222222" BorderThickness="0" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Amarelos -->
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#FFA500" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Moderados (Limitado)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TxtProtModerate" Text="0 / 0" FontSize="12" FontWeight="Bold" Foreground="#FFA500" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="3" x:Name="PbModerate" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#FFA500" Background="#222222" BorderThickness="0" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Vermelhos -->
                        <Grid Margin="0,6,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="9" Height="9" Fill="#C42B1C" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Perigosos (Não Recomendado)" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" x:Name="TxtProtDanger" Text="0 / 0" FontSize="12" FontWeight="Bold" Foreground="#E57373" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            <ProgressBar Grid.Column="3" x:Name="PbDanger" Height="6" Minimum="0" Maximum="100" Value="0" Foreground="#C42B1C" Background="#222222" BorderThickness="0" Margin="14,0,0,0" VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Resultado -->
                        <TextBlock x:Name="TxtPrivacyScore" Text="Carregando..." FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentColor}" Margin="0,12,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="1" x:Name="BtnRefreshStatus" Content="&#x27F3; Atualizar" Click="BtnRefreshStatus_Click" 
                            Style="{StaticResource SecondaryButtonStyle}" Width="120" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Presets Personalizados (estilo O&O ShutUp10) -->
            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,25" BorderBrush="#E8B84E" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="PRESETS PERSONALIZADOS" FontSize="16" FontWeight="Bold" Foreground="#E8B84E"/>
                        <TextBlock Text="Escolha item por item o que aplicar: seguros, moderados e perigosos — como no O&amp;O ShutUp10. Itens desmarcados voltam ao padrão do Windows." FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,12,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Grid.Column="1" x:Name="BtnOpenPresets" Content="&#x1F39B; PRESETS PERSONALIZADOS" Click="BtnOpenPresets_Click"
                                Style="{StaticResource GoldButtonStyle}" Width="220" Height="40" FontWeight="Bold" VerticalAlignment="Center"
                                ToolTip="Abre a seleção por nível: Seguros, Moderados e Perigosos"/>
                        <Button x:Name="BtnResetAll" Content="&#x27F2; RESETAR TUDO" Click="BtnResetAll_Click"
                                Style="{StaticResource DeleteButtonStyle}" Width="180" Height="40" Margin="10,0,0,0" VerticalAlignment="Center"
                                ToolTip="Desliga TODAS as proteções de privacidade e reverte tudo ao padrão do Windows (160 configurações + serviços)"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lista Detalhada -->
            <StackPanel Margin="0,0,0,15">
                <!-- T&#xED;tulo -->
                <TextBlock Text="Configura&#xE7;&#xF5;es Detalhadas" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,10"/>

                <!-- Bot&#xF5;es de A&#xE7;&#xE3;o -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="Salvar Configura&#xE7;&#xE3;o" Click="BtnSaveUserConfig_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Width="150"/>
                    <Button Content="Restaurar Configura&#xE7;&#xE3;o" Click="BtnRestoreUserConfig_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Width="160"/>
                    <Button x:Name="BtnExpandAll" Content="Expandir Tudo" Click="BtnExpandAll_Click" Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
                </StackPanel>

                <!-- Pesquisa e Filtros -->
                <Grid Margin="0,5,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Caixa de Pesquisa -->
                    <TextBox Grid.Column="0"
                             x:Name="TxtSearch"
                             Text="&#x1F50D; Pesquisar configura&#xE7;&#xF5;es..."
                             Foreground="{StaticResource TextMuted}"
                             Background="{StaticResource CardBackground}"
                             BorderBrush="{StaticResource CardBorder}"
                             BorderThickness="1"
                             Padding="12,8"
                             FontSize="13"
                             GotFocus="TxtSearch_GotFocus"
                             LostFocus="TxtSearch_LostFocus"
                             TextChanged="TxtSearch_TextChanged"
                             Margin="0,0,10,0"/>

                    <!-- Bot&#xE3;o de Menu de Filtro (3 tra&#xE7;os) -->
                    <Button x:Name="BtnFilterMenu" Grid.Column="1" Click="BtnFilterMenu_Click" Style="{StaticResource SecondaryButtonStyle}" Width="60" ToolTip="Filtrar por n&#xED;vel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x2630;" FontSize="16" Margin="0,0,5,0"/>
                            <Ellipse x:Name="FilterIndicator" Width="10" Height="10" Fill="#FFD700" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="FilterContextMenu" Style="{StaticResource ServiceContextMenu}">
                                <MenuItem Header="Todos" Click="MenuItemFilter_Click" Tag="All" Style="{StaticResource ServiceMenuItem}">
                                    <MenuItem.Icon>
                                        <Ellipse Width="12" Height="12" Fill="#FFD700"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Recomendado" Click="MenuItemFilter_Click" Tag="Recommended" Style="{StaticResource ServiceMenuItem}" Foreground="#4CAF50">
                                    <MenuItem.Icon>
                                        <Ellipse Width="12" Height="12" Fill="#4CAF50"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Limitado" Click="MenuItemFilter_Click" Tag="Limited" Style="{StaticResource ServiceMenuItem}" Foreground="#FFA500">
                                    <MenuItem.Icon>
                                        <Ellipse Width="12" Height="12" Fill="#FFA500"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="N&#xE3;o Recomendado" Click="MenuItemFilter_Click" Tag="NotRecommended" Style="{StaticResource ServiceMenuItem}" Foreground="#C42B1C">
                                    <MenuItem.Icon>
                                        <Ellipse Width="12" Height="12" Fill="#C42B1C"/>
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </Grid>

                <!-- Legenda dos Indicadores -->
                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <Ellipse Width="8" Height="8" Fill="#4CAF50" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Recomendado" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                    <Ellipse Width="8" Height="8" Fill="#FFA500" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Limitado" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,15,0" VerticalAlignment="Center"/>

                    <Ellipse Width="8" Height="8" Fill="#C42B1C" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="N&#xE3;o Recomendado" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <!-- Lista Din&#xE2;mica de Categorias (Data Binding) -->
            <ItemsControl x:Name="CategoriesList" ItemsSource="{Binding Categories}" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" Margin="0,0,0,15" Padding="15">
                            <StackPanel>
                                <!-- Cabe&#xE7;alho da Categoria -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentColor}"
                                               FontSize="16"
                                               VerticalAlignment="Center"/>

                                    <!-- Checkbox Custom para Ativar Todos da Categoria -->
                                    <CheckBox Grid.Column="1"
                                              x:Name="CategoryCheckBox"
                                              IsChecked="{Binding AllEnabled, Mode=TwoWay}"
                                              Style="{StaticResource CategoryCheckBoxStyle}"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Margin="10,0,0,0"
                                              Checked="CategoryCheckBox_Checked"
                                              Unchecked="CategoryCheckBox_Unchecked"
                                              Tag="{Binding}"/>
                                </Grid>

                                <!-- Lista de Configura&#xE7;&#xF5;es -->
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5,0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Indicador de N&#xED;vel de Privacidade -->
                                                <Ellipse Grid.Column="0"
                                                         Width="10" Height="10"
                                                         Margin="0,0,12,0"
                                                         VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#4CAF50"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Level}" Value="Limited">
                                                                    <Setter Property="Fill" Value="#FFA500"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Level}" Value="NotRecommended">
                                                                    <Setter Property="Fill" Value="#C42B1C"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>

                                                <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="White" FontSize="14"/>
                                                    <TextBlock Text="{Binding Description}" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <controls:InfoButton Grid.Column="2" ToolTipText="{Binding InfoTooltip}" VerticalAlignment="Center" Margin="0,0,4,0"/>

                                                <CheckBox Grid.Column="3"
                                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          HorizontalAlignment="Right"
                                                          VerticalAlignment="Center"
                                                          Command="{Binding ToggleCommand}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
