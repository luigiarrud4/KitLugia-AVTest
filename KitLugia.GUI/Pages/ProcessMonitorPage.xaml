<Page x:Class="KitLugia.GUI.Pages.ProcessMonitorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="Monitor de Processos e RAM"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial"
      d:DesignHeight="800" d:DesignWidth="1200"
      Background="#1E1E1E">

    <Page.Resources>
        <!-- Estilo do Processo Item - Seleção Visual -->
        <Style x:Key="ProcessItemStyle" TargetType="ListViewItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3A2A"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#FFD700"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#1A4A3A"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para botões de ação -->
        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="#3A3A3A"/>
                                <Setter TargetName="bdr" Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bdr" Property="Background" Value="{DynamicResource AccentColor}"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#2D2D30" Padding="20,15,20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="🖥️ Monitor Avançado de Processos" 
                              FontSize="22" FontWeight="Bold" 
                              Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="RAM: " FontSize="14" Foreground="#00FF88" VerticalAlignment="Center" Margin="20,0,0,0"/>
                    <TextBlock x:Name="RamUsageText" Text="0 GB / 16 GB (0%)" 
                              FontSize="14" Foreground="#00FF88" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filtro:" Foreground="#AAA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CmbFilter" Width="160" Height="30" FontSize="12" Background="#1E1E1E" Foreground="White" 
                              BorderBrush="#444" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                        <ComboBoxItem Content="📋 Todos"/>
                        <ComboBoxItem Content="👤 Apps do Usuário"/>
                        <ComboBoxItem Content="⚙️ Background"/>
                        <ComboBoxItem Content="🪟 Windows/Sistema"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <!-- LEGENDA -->
        <Border Grid.Row="1" Background="#252526" Padding="20,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10" Height="10" Fill="#4ECDC4" Margin="0,0,6,0"/>
                <TextBlock Text="Apps do Usuário" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Ellipse Width="10" Height="10" Fill="#FFD700" Margin="0,0,6,0"/>
                <TextBlock Text="Background" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <Ellipse Width="10" Height="10" Fill="#828282" Margin="0,0,6,0"/>
                <TextBlock Text="Windows/Sistema" Foreground="#AAA" FontSize="11" VerticalAlignment="Center" Margin="0,0,20,0"/>
                <TextBlock Text="💡 Clique em um processo para selecionar" Foreground="#666" FontSize="11" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="2" Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- PROCESS LIST -->
            <Border Grid.Column="0" Background="#252526" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Process List with custom ItemTemplate -->
                    <ListView Grid.Row="1" x:Name="ProcessListView" 
                             Background="Transparent" 
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource ProcessItemStyle}"
                             SelectionMode="Single"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Ícone do processo -->
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="4" 
                                            Background="#333" VerticalAlignment="Center" Margin="0,0,8,0">
                                        <Image Source="{Binding Icon}" Width="24" Height="24" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <!-- Nome + Categoria -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" 
                                                           Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="350"/>
                                                <Border Background="{Binding CategoryColor}" CornerRadius="3" Padding="6,2" 
                                                        Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryLabel}" FontSize="9" Foreground="White" FontWeight="SemiBold"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock FontSize="10" Foreground="#666" TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <Run Text="PID: "/><Run Text="{Binding Id, Mode=OneWay}"/>
                                                <Run Text=" | "/><Run Text="{Binding RamUsage, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <!-- CPU -->
                                    <TextBlock Grid.Column="2" Text="{Binding CpuUsageFormatted}" FontSize="12" 
                                               Foreground="{Binding CpuColor}" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- RAM -->
                                    <TextBlock Grid.Column="3" Text="{Binding RamUsage}" FontSize="11" 
                                               Foreground="#AAA" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                    <!-- Prioridade -->
                                    <Border Grid.Column="4" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="3" Padding="6,3">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#333"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Priority}" Value="High">
                                                        <Setter Property="Background" Value="#1A3A1A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="AboveNormal">
                                                        <Setter Property="Background" Value="#1A2A3A"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Priority}" Value="RealTime">
                                                        <Setter Property="Background" Value="#3A1A1A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Priority}" FontSize="10" Foreground="#CCC" 
                                                   HorizontalAlignment="Center"/>
                                    </Border>

                                    <!-- Status -->
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="8" Height="8" Margin="0,0,5,0">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="#4CAF50"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Sem resposta">
                                                            <Setter Property="Fill" Value="#FF6B6B"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Status}" FontSize="10" Foreground="#AAA" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- Rede -->
                                    <TextBlock Grid.Column="6" Text="{Binding NetworkUsage}" FontSize="10" 
                                               Foreground="#666" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Process Controls -->
                    <Border Grid.Row="1" Background="#3C3C3C" Padding="15,10" CornerRadius="0,0,8,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" x:Name="RefreshButton" Content="🔄 Atualizar" 
                                   Style="{StaticResource ActionBtn}" Padding="15,8" Margin="0,0,10,0"
                                   Click="RefreshButton_Click"/>
                            <Button Grid.Column="1" x:Name="OptimizeButton" Content="⚡ Otimizar" 
                                   Style="{StaticResource ActionBtn}" Padding="15,8" Margin="0,0,10,0"
                                   Background="#1A3A1A" Click="OptimizeButton_Click"/>
                            <Button Grid.Column="2" x:Name="KillSelectedButton" Content="❌ Finalizar" 
                                   Style="{StaticResource ActionBtn}" Padding="15,8" Margin="0,0,10,0"
                                   Background="#3A1A1A" Click="KillSelectedButton_Click"/>
                            
                            <TextBlock Grid.Column="3" x:Name="ProcessCountText" Text="0 processos" 
                                       Foreground="#666" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"/>
                            
                            <TextBlock Grid.Column="4" Text="💡 Selecione um processo e clique Finalizar" 
                                       Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT PANEL: Advanced Customization -->
            <Border Grid.Column="2" Background="#252526" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Background="#3C3C3C" Padding="15,10" CornerRadius="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="⚙️ Customização Avançada" FontSize="16" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="Detectar apps e otimizar automaticamente" FontSize="12" Foreground="#AAA" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="15">
                            <!-- Gaming Profiles -->
                            <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🎮 Perfis de Gaming" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="SteamProfile" Content="Steam" Foreground="White" Margin="0,5" Checked="Profile_Checked"/>
                                    <CheckBox x:Name="EpicProfile" Content="Epic Games" Foreground="White" Margin="0,5" Checked="Profile_Checked"/>
                                    <CheckBox x:Name="XboxProfile" Content="Xbox Game Pass" Foreground="White" Margin="0,5" Checked="Profile_Checked"/>
                                    <CheckBox x:Name="DiscordProfile" Content="Discord" Foreground="White" Margin="0,5" Checked="Profile_Checked"/>
                                </StackPanel>
                            </Border>

                            <!-- Performance Modes -->
                            <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="⚡ Modos de Desempenho" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="UltraPerfMode" Content="🚀 Ultra Desempenho (Downloads)" Foreground="White" Margin="0,5" Checked="PerformanceMode_Checked"/>
                                    <CheckBox x:Name="GamingMode" Content="🎮 Gaming Mode" Foreground="White" Margin="0,5" Checked="PerformanceMode_Checked"/>
                                    <CheckBox x:Name="BalancedMode" Content="⚖️ Balanced Mode" Foreground="White" Margin="0,5" IsChecked="True" Checked="PerformanceMode_Checked"/>
                                </StackPanel>
                            </Border>

                            <!-- Network -->
                            <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🌐 Otimização de Rede" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="HighBandwidthMode" Content="📡 Alta Prioridade de Rede" Foreground="White" Margin="0,5" Checked="NetworkOptimization_Checked"/>
                                    <CheckBox x:Name="LowLatencyMode" Content="⚡ Baixa Latência" Foreground="White" Margin="0,5" Checked="NetworkOptimization_Checked"/>
                                    <CheckBox x:Name="DownloadBoost" Content="⬇️ Boost para Downloads" Foreground="White" Margin="0,5" Checked="NetworkOptimization_Checked"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM -->
                            <Border Background="#2D2D30" CornerRadius="5" Padding="15" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="🧠 Otimização de RAM" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="MemoryCompression" Content="🗜️ Compressão de RAM" Foreground="White" Margin="0,5" IsChecked="True" Checked="MemoryOptimization_Checked"/>
                                    <CheckBox x:Name="IntelligentCleanup" Content="🧹 Limpeza Inteligente" Foreground="White" Margin="0,5" IsChecked="True" Checked="MemoryOptimization_Checked"/>
                                    <CheckBox x:Name="StandbyListOptimization" Content="💤 Otimizar Standby List" Foreground="White" Margin="0,5" Checked="MemoryOptimization_Checked"/>
                                </StackPanel>
                            </Border>

                            <!-- Auto-Detection -->
                            <Border Background="#2D2D30" CornerRadius="5" Padding="15">
                                <StackPanel>
                                    <TextBlock Text="🤖 Detecção Automática" FontSize="14" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="AutoDetectSteam" Content="🎮 Detectar Steam (downloads/atualizações)" Foreground="White" Margin="0,5" IsChecked="True" Checked="AutoDetection_Checked"/>
                                    <CheckBox x:Name="AutoDetectEpic" Content="🎮 Detectar Epic Games (downloads/atualizações)" Foreground="White" Margin="0,5" IsChecked="True" Checked="AutoDetection_Checked"/>
                                    <CheckBox x:Name="AutoDetectHighNetwork" Content="📡 Alta atividade de rede = Ultra modo" Foreground="White" Margin="0,5" IsChecked="True" Checked="AutoDetection_Checked"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Apply Button -->
                    <Border Grid.Row="2" Background="#3C3C3C" Padding="15,10" CornerRadius="0,0,8,8">
                        <Button x:Name="ApplyCustomizationButton" Content="🚀 Aplicar Customização" 
                               Style="{StaticResource ActionBtn}" Padding="20,10" FontSize="14"
                               Background="#FF6B00" Click="ApplyCustomizationButton_Click"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="3" Background="#2D2D30" Padding="20,10" Margin="10,5,10,10" CornerRadius="0,0,8,8">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StatusText" Text="🟢 Sistema otimizado" FontSize="14" Foreground="#00FF88" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
