<Page x:Class="KitLugia.GUI.Pages.ShrinkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="Shrink Partição — KitLugia"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial"
      Background="{StaticResource WindowBackground}">

    <Page.Resources>
        <Style x:Key="TabRadioStyle" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#AAA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border Name="Border" Background="Transparent" CornerRadius="6" Padding="12,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#333"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#2A2A2A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="&#x2702;&#xFE0F; Shrink &amp; Recovery" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
            <TextBlock Text="Reduzir partição e gerenciar ambientes de recuperação" FontSize="14" Foreground="{StaticResource TextMuted}" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Mode Tabs -->
        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="8" BorderBrush="#333" BorderThickness="1" Padding="4" Margin="0,0,0,12" Height="38">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="RadioAntiX" Grid.Column="0" Content="&#x1F4BF; antiX Linux" 
                             IsChecked="True" Style="{StaticResource TabRadioStyle}" Click="RadioMode_Checked"/>
                <RadioButton x:Name="RadioWinPE" Grid.Column="1" Content="&#x1F5A5;&#xFE0F; WinPE KitLugia" 
                             Style="{StaticResource TabRadioStyle}" Click="RadioMode_Checked"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Border Grid.Row="2" Background="{StaticResource CardBackground}" CornerRadius="10" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Style="{StaticResource CardStyle}" Padding="25">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT: Config -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <TextBlock Text="&#x2699;&#xFE0F; CONFIGURAÇÃO" FontSize="16" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,15"/>

                        <TextBlock Text="Partição para reduzir:" FontSize="12" Foreground="#CCC" Margin="0,0,0,5"/>
                        <ComboBox x:Name="ComboPartitions" Height="32" Margin="0,0,0,12" DisplayMemberPath="DisplayText"/>

                        <!-- ============= ANTI-X SECTION ============= -->
                        <StackPanel x:Name="PanelAntiX">

                            <TextBlock Text="Tamanho do shrink (MB):" FontSize="12" Foreground="#CCC" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtShrinkSize" Text="4096" Height="32" Margin="0,0,0,5"
                                     Foreground="White" Background="#2B2B2B" BorderBrush="#444" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="8,0"/>
                            <TextBlock Text="Mínimo 1024 MB (1GB). Partição criada terá o antiX Live completo (kernel + linuxfs)." FontSize="10" Foreground="#888" Margin="0,0,0,12"/>

                            <Border Background="#1E2A1E" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#4CAF50" BorderThickness="1">
                                <TextBlock x:Name="TxtFlavorInfo" Text="&#x26A1; antiX Linux completo (kernel + linuxfs 585MB) será extraído na nova partição. rEFInd substitui o Windows Boot Manager e mostra menu interativo. Você escolhe entre antiX Live e Windows."
                                           FontSize="11" Foreground="#A5D6A7" TextWrapping="Wrap"/>
                            </Border>

                            <WrapPanel Margin="0,10,0,0">
                                <Button x:Name="BtnExecute" Content="&#x25B6; EXECUTAR SHRINK" Height="40" FontSize="14" FontWeight="Bold"
                                        Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Click="BtnExecute_Click" Width="220"/>
                                <Button x:Name="BtnInstallRefind" Content="&#x2B55; Instalar rEFInd" Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource RecycleButtonStyle}" Margin="0,0,8,0" Click="BtnInstallRefind_Click" Width="155"/>
                                <Button x:Name="BtnRemoveRefind" Content="&#x274C; Desinstalar rEFInd" Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource DeleteButtonStyle}" Click="BtnRemoveRefind_Click" Width="165"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- ============= WINPE SECTION ============= -->
                        <StackPanel x:Name="PanelWinPE" Visibility="Collapsed">

                            <TextBlock Text="Tamanho do shrink final (MB):" FontSize="12" Foreground="#CCC" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtWinpeShrinkSize" Text="7000" Height="32" Margin="0,0,0,5"
                                     Foreground="White" Background="#2B2B2B" BorderBrush="#444" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="8,0"/>
                            <TextBlock Text="Tamanho em MB do shrink que será executado dentro do WinPE (ex: 7000 = 7 GB)." FontSize="10" Foreground="#888" Margin="0,0,0,12"/>

                            <TextBlock Text="Partição A (temporária, MB):" FontSize="12" Foreground="#CCC" Margin="0,0,0,5"/>
                            <TextBox x:Name="TxtPartASize" Text="800" Height="32" Margin="0,0,0,5"
                                     Foreground="White" Background="#2B2B2B" BorderBrush="#444" BorderThickness="1"
                                     VerticalContentAlignment="Center" Padding="8,0"/>
                            <TextBlock Text="Espaço reservado para o WinPE bootar. 800 MB é suficiente." FontSize="10" Foreground="#888" Margin="0,0,0,12"/>

                            <TextBlock Text="Arquivo WinPE (.wim ou .iso):" FontSize="12" Foreground="#CCC" Margin="0,0,0,5"/>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtWinpePath" Text="C:\WinPE_KitLugia\boot.wim" Height="32"
                                         Foreground="White" Background="#2B2B2B" BorderBrush="#444" BorderThickness="1"
                                         VerticalContentAlignment="Center" Padding="8,0" IsReadOnly="False"/>
                                <Button Grid.Column="1" Content="&#x1F4C2; Selecionar" Height="32" Margin="4,0,0,0"
                                        Width="110" Click="BtnSelectWinpe_Click"
                                        Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>

                            <Border Background="#1A2A3A" CornerRadius="6" Padding="10" Margin="0,0,0,8" BorderBrush="#2196F3" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="&#x1F4A1; Como funciona:" FontSize="11" Foreground="#90CAF9" Margin="0,0,0,5"/>
                                    <TextBlock Text="1. Shrink inicial para criar Partição A" FontSize="10" Foreground="#B0BEC5"/>
                                    <TextBlock Text="2. Copia boot.wim para Partição A" FontSize="10" Foreground="#B0BEC5"/>
                                    <TextBlock Text="3. Registra entrada de boot ramdisk" FontSize="10" Foreground="#B0BEC5"/>
                                    <TextBlock Text="4. REINICIA — WinPE deleta Partição A e faz o shrink grande" FontSize="10" Foreground="#B0BEC5"/>
                                    <TextBlock Text="5. Cria Partição B com o espaço liberado" FontSize="10" Foreground="#B0BEC5"/>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="TxtWinpeWarning" Text="&#x26A0;&#xFE0F; O sistema será reiniciado automaticamente. Salve seu trabalho antes de continuar."
                                       FontSize="11" Foreground="#FFA726" TextWrapping="Wrap" Margin="15,5,0,15"/>

                            <WrapPanel Margin="0,5,0,0">
                                <Button x:Name="BtnWinpePrepare" Content="&#x1F4E5; PREPARAR WINPE (Fase 1)" Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Click="BtnWinpePrepare_Click" Width="240"/>
                                <Button x:Name="BtnWinpeContinue" Content="&#x25B6; CONTINUAR SHRINK (Fase 2)" Height="40" FontSize="13" FontWeight="Bold"
                                        Style="{StaticResource GoldButtonStyle}" Click="BtnWinpeContinue_Click" Width="250"/>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Status -->
                        <Border Background="#2B2B2B" CornerRadius="6" Padding="12" Margin="0,15,0,0" BorderBrush="#444" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="&#x1F4CB; STATUS" FontSize="11" Foreground="#AAA" Margin="0,0,0,5"/>
                                <TextBlock x:Name="TxtStatus" Text="Pronto." FontSize="13" Foreground="#E0E0E0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- RIGHT: Log -->
                <Border Grid.Column="2" Background="#1A1A1A" CornerRadius="8" BorderBrush="#333" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="&#x1F4DD; LOG" FontSize="11" Foreground="#AAA" Margin="10,8,10,5"/>
                        <ScrollViewer Grid.Row="1" Margin="5" x:Name="LogScroll">
                            <TextBox x:Name="TxtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="10"
                                     Foreground="#0F0" Background="#111" BorderThickness="0"
                                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Bottom overlay -->
        <Grid x:Name="OverlayBusy" Grid.RowSpan="3" Background="#CC000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="⏳" FontSize="48" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtProgressStatus" Text="Processando..." FontSize="16" Foreground="White" Margin="0,10,0,0"/>
                <ProgressBar x:Name="ProgressBar" Width="300" Height="6" Margin="0,10,0,0" IsIndeterminate="True"
                             Foreground="{StaticResource AccentColor}" Background="#333"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
