<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.ServicesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      mc:Ignorable="d" 
      Title="ServicesPage"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial" d:DesignHeight="700" d:DesignWidth="950">

    <Page.Resources>

        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border Name="Border" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="0,0,0,3" Margin="0,0,10,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

        <TextBlock Text="Gerenciador de Processos" Foreground="White" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,20"/>

        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0">

            <!-- ABA 1: STARTUP -->
            <TabItem Header="Inicializa&#xE7;&#xE3;o (Startup)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Aplicativos que iniciam com o Windows" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>

                        <Border Background="#15FFFFFF" CornerRadius="6" Height="32" Margin="10,0,0,0" BorderBrush="#404040" BorderThickness="1" Width="240">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="&#x1F50D;" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#888" FontSize="13"/>

                                <TextBlock Text="Pesquisar..." Foreground="#606060" VerticalAlignment="Center"
                                           IsHitTestVisible="False" FontStyle="Italic" FontSize="13" Grid.Column="1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearchStartup}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <TextBox x:Name="TxtSearchStartup" Background="Transparent" BorderThickness="0"
                                         Foreground="White" VerticalAlignment="Center" FontSize="13"
                                         Padding="0,0,8,0" CaretBrush="{StaticResource AccentColor}"
                                         TextChanged="TxtSearchStartup_TextChanged" Grid.Column="1"/>
                            </Grid>
                        </Border>

                        <TextBlock x:Name="TxtStartupCount" Text="0 itens" Foreground="#666" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="11"/>
                        <Button Content="Recarregar Lista" Click="BtnRefreshStartup_Click" Margin="20,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Height="30" FontSize="12"/>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="#111">
                        <DataGrid x:Name="GridStartup" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling" PreviewMouseRightButtonDown="GridStartup_PreviewMouseRightButtonDown">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="250" IsReadOnly="True" SortMemberPath="Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTextColumn Header="Comando / Caminho" Binding="{Binding FullCommand}" Width="*" IsReadOnly="True" SortMemberPath="FullCommand">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="Foreground" Value="#777"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding FullCommand}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <DataGridTemplateColumn Header="Status" Width="190" IsReadOnly="True" SortMemberPath="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock VerticalAlignment="Center" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding Status}"/>
                                                        <Setter Property="Foreground" Value="#777"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Enabled">
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                                <Setter Property="Text" Value="ATIVADO"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Disabled">
                                                                <Setter Property="Foreground" Value="#C42B1C"/>
                                                                <Setter Property="Text" Value="DESATIVADO"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Elevated">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                                <Setter Property="Text" Value="ELEVADO (ADM)"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#FFD700" BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="TurboBoot">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                                <Setter Property="Text" Value="&#x1F680; KITLUGIA (ADMIN)"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#FFD700" BlurRadius="5" ShadowDepth="0" Opacity="0.4"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="TurboBootNormal">
                                                                <Setter Property="Foreground" Value="#E8C98A"/>
                                                                <Setter Property="Text" Value="&#x1F680; KITLUGIA (NORMAL)"/>
                                                                <Setter Property="Effect">
                                                                    <Setter.Value>
                                                                        <DropShadowEffect Color="#E8C98A" BlurRadius="4" ShadowDepth="0" Opacity="0.25"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Local" Binding="{Binding Location}" Width="150" IsReadOnly="True" SortMemberPath="Location">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Setter Property="ToolTip" Value="{Binding Location}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>

                            <!-- Menu de Contexto para Startup -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ServiceContextMenu}" Opened="GridStartup_ContextMenuOpened">
                                    <MenuItem Header="Habilitar / Desabilitar" Click="BtnToggleStartup_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem x:Name="MenuMoveToTurboBoot_Admin" Header="&#x1F680; Mover para KitLugia Boot Tray (Admin)" Click="MenuMoveToTurboAdmin_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}" FontWeight="Bold"/>
                                    <MenuItem x:Name="MenuMoveToTurboBoot_Normal" Header="&#x1F680; Mover para KitLugia Boot Tray (Normal - Sem Admin)" Click="MenuMoveToTurboNormal_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                    <MenuItem x:Name="MenuRemoveFromTurboBoot" Header="&#x1F504; Remover do KitLugia Boot Tray" Click="MenuRemoveFromTurboBoot_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#FF6F61"/>
                                    <MenuItem x:Name="MenuRestoreNormal" Header="&#x23EA; Restaurar para Inicializa&#xE7;&#xE3;o Padr&#xE3;o" Click="MenuRestoreNormal_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="&#x1F6E1;&#xFE0F; Converter para Admin Elevado" Click="MenuConvertToAdmin_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                    <MenuItem Header="&#x23F3; Converter para Admin Elevado (Atraso 2min)" Click="MenuConvertToAdminDelayed_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="&#x25B6; Executar Agora (Testar)" Click="MenuRunNow_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#4CAF50" FontWeight="Bold"/>
                                    <MenuItem x:Name="MenuOpenLocation" Header="&#x1F4C1; Abrir Local do Arquivo" Click="MenuOpenLocation_Click" Style="{StaticResource ServiceMenuItem}" Foreground="White"
                                              ToolTip="Abre no Explorer a pasta do arquivo deste item"/>
                                    <MenuItem Header="&#x2699; Editar Argumentos..." Click="MenuEditArgs_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="Remover Permanentemente" Click="BtnRemoveStartup_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#FF6F61"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="&#x1F4C1; Abrir Local do Arquivo" Click="BtnOpenStartupLocation_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"
                                ToolTip="Abre no Explorer a pasta do arquivo do item selecionado na lista de inicializa&#xE7;&#xE3;o"/>
                        <Button Content="Remover" Click="BtnRemoveStartup_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Foreground="#FF6F61"/>
                        <Button Content="Desabilitar / Habilitar Selecionado" Click="BtnToggleStartup_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0"/>

                        <!-- CORRE&#xC7;&#xC3;O AQUI: Aplicado o estilo preto e amarelo no ContextMenu -->
                        <Button x:Name="BtnAddStartup" Content="Adicionar Novo... &#x25BE;" Click="BtnAddStartup_Click" Style="{StaticResource GoldButtonStyle}">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource ServiceContextMenu}">
                                    <MenuItem Header="Adicionar Padr&#xE3;o (Sem Admin)" Click="MenuAddNormal_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Adicionar como Administrador (Elevado)" Click="MenuAddAdmin_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}" FontWeight="Bold"/>
                                    <MenuItem Header="Adicionar com Atraso (2 min)" Click="MenuAddDelayed_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Adicionar como Admin + Atraso (2 min)" Click="MenuAddAdminDelayed_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Task Scheduler extra list -->
                    <!-- In-page overlay for editing arguments -->
                    <Grid x:Name="EditArgsOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC000000" ZIndex="100">
                        <Border Background="#1E1E1E" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="8" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Margin="20,20,20,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="&#x2699; Editar Argumentos de Inicialização" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="1" FontSize="14" Foreground="#CCC" Margin="0,0,0,8">
                                    <Run FontWeight="SemiBold" Foreground="#AAA" Text="Aplicativo: "/><Run x:Name="TxtEditAppName" Foreground="{StaticResource AccentColor}" FontWeight="Bold"/>
                                </TextBlock>

                                <TextBlock Grid.Row="2" Text="Caminho:" FontWeight="SemiBold" Foreground="#AAA" Margin="0,0,0,3"/>
                                <Border Grid.Row="3" BorderBrush="#444" BorderThickness="1" CornerRadius="4" Height="30" Background="#2d2d2d" Margin="0,0,0,8">
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <TextBlock x:Name="TxtEditExePath" Foreground="#888" FontSize="12" Padding="6,5" VerticalAlignment="Center"/>
                                    </ScrollViewer>
                                </Border>

                                <TextBlock Grid.Row="4" Text="Argumentos:" FontWeight="SemiBold" Foreground="#AAA" Margin="0,0,0,3"/>
                                <Border Grid.Row="5" Background="#2d2d2d" CornerRadius="4" BorderBrush="#444" BorderThickness="1" Padding="6" Height="30" Margin="0,0,0,5">
                                    <TextBox x:Name="TxtEditArgs" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" TextChanged="TxtEditArgs_TextChanged" AcceptsReturn="False" VerticalAlignment="Center"/>
                                </Border>

                                <ItemsControl x:Name="EditSuggestionsPanel" Grid.Row="6" Visibility="Collapsed" Margin="0,0,0,6" MaxHeight="50">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="0,0,4,3" Padding="10,2" FontSize="11" Cursor="Hand" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" Background="#20FFD700" Height="24" Click="BtnSuggestion_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="7" Background="#252525" CornerRadius="4" Padding="8" MinHeight="30" MaxHeight="120" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Resultado:" FontWeight="SemiBold" Foreground="#AAA" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TxtEditPreview" Foreground="{StaticResource AccentColor}" FontSize="12" FontFamily="Consolas" TextWrapping="NoWrap" Text=" "/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Cancelar" Click="BtnEditArgsCancel_Click" Width="100" Height="30" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnEditArgsSave" Content="Salvar" Click="BtnEditArgsSave_Click" Width="100" Height="30" Style="{StaticResource GoldButtonStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- In-page overlay for ADDING new startup -->
                    <Grid x:Name="AddStartupOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC000000" ZIndex="100">
                        <Border Background="#1E1E1E" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="8" Width="600" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Grid Margin="20,20,20,15">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="&#x2795; Adicionar Novo Item na Inicialização" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,10"/>
                                <TextBlock x:Name="TxtAddMode" Grid.Row="1" FontSize="13" Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>

                                <Grid Grid.Row="2" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Margin="0,0,8,0" Height="30" Background="#2d2d2d">
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                            <TextBlock x:Name="TxtAddExePath" Text="" Foreground="#888" FontSize="12" Padding="6,5" VerticalAlignment="Center"/>
                                        </ScrollViewer>
                                    </Border>
                                    <Button Grid.Column="1" Content="Selecionar..." Click="BtnAddPickFile_Click" Width="100" Height="30" Style="{StaticResource SecondaryButtonStyle}"/>
                                </Grid>

                                <TextBlock Grid.Row="3" Text="Argumentos:" FontWeight="SemiBold" Foreground="#AAA" Margin="0,0,0,3"/>
                                <Border Grid.Row="4" Background="#2d2d2d" CornerRadius="4" BorderBrush="#444" BorderThickness="1" Padding="6" Height="30" Margin="0,0,0,5">
                                    <TextBox x:Name="TxtAddArgs" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="13" TextChanged="TxtAddArgs_TextChanged" AcceptsReturn="False" VerticalAlignment="Center"/>
                                </Border>

                                <ItemsControl x:Name="AddSuggestionsPanel" Grid.Row="5" Visibility="Collapsed" Margin="0,0,0,6" MaxHeight="50">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Margin="0,0,4,3" Padding="10,2" FontSize="11" Cursor="Hand" Foreground="{DynamicResource AccentColor}" BorderBrush="{DynamicResource AccentColor}" BorderThickness="1" Background="#20FFD700" Height="24" Click="BtnAddSuggestion_Click"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="6" Background="#252525" CornerRadius="4" Padding="8" MinHeight="30" MaxHeight="120" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Resultado:" FontWeight="SemiBold" Foreground="#AAA" VerticalAlignment="Top" Margin="0,2,8,0"/>
                                        <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="TxtAddPreview" Foreground="{StaticResource AccentColor}" FontSize="12" FontFamily="Consolas" TextWrapping="NoWrap" Text=" "/>
                                        </ScrollViewer>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Cancelar" Click="BtnAddCancel_Click" Width="100" Height="30" Margin="0,0,10,0" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button x:Name="BtnAddSave" Content="Adicionar" Click="BtnAddSave_Click" Width="100" Height="30" Style="{StaticResource GoldButtonStyle}" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Loading Overlay para startup -->
                    <Grid x:Name="StartupLoadingOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="#CC000000" ZIndex="99">
                        <Border Background="#1E1E1E" CornerRadius="12" BorderBrush="{StaticResource AccentColor}" BorderThickness="1"
                                Width="260" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Viewbox Width="36" Height="36" Margin="0,0,0,12">
                                    <Grid>
                                        <Ellipse Stroke="{StaticResource AccentColor}" StrokeThickness="3" Fill="Transparent"
                                                Width="36" Height="36" Opacity="0.3"/>
                                        <Ellipse Stroke="{StaticResource AccentColor}" StrokeThickness="3" Fill="Transparent"
                                                Width="36" Height="36" StrokeDashArray="94 31">
                                            <Ellipse.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="StrokeDashOffset"
                                                                           From="0" To="125" Duration="0:0:1" RepeatBehavior="Forever"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Ellipse.Triggers>
                                        </Ellipse>
                                    </Grid>
                                </Viewbox>
                                <TextBlock x:Name="TxtStartupLoadingStatus" Text="Carregando..."
                                          Foreground="White" FontSize="14" HorizontalAlignment="Center" TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ABA 2: OTIMIZA&#xC7;&#xC3;O DE SERVI&#xC7;OS -->
            <TabItem Header="Servi&#xE7;os (Otimiza&#xE7;&#xE3;o)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Cards -->
                        <RowDefinition Height="Auto"/>
                        <!-- Filtros -->
                        <RowDefinition Height="*"/>
                        <!-- Tabela -->
                        <RowDefinition Height="Auto"/>
                        <!-- A&#xE7;&#xF5;es -->
                    </Grid.RowDefinitions>

                    <!-- STATS AO VIVO + PERFIL DE OTIMIZACAO (substitui os 3 cards estaticos) -->
                    <!-- Layout empilhado: stats na linha 1, perfil na linha 2 (largura total). Funciona em qualquer largura de janela. -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,15">
                        <!-- Linha 1: 4 mini-stats calculados da lista real -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Total" Foreground="#888" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSvcTotal" Text="—" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A1A1A" BorderBrush="#4CAF50" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Executando" Foreground="#4CAF50" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSvcRunning" Text="—" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A1A1A" BorderBrush="#777" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0">
                                <StackPanel>
                                    <TextBlock Text="Parados" Foreground="#AAA" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSvcStopped" Text="—" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Background="#1A1A1A" BorderBrush="#FF6F61" BorderThickness="1" CornerRadius="8" Padding="12,8">
                                <StackPanel>
                                    <TextBlock Text="Desativados" Foreground="#FF6F61" FontSize="11" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtSvcDisabled" Text="—" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Linha 2: Perfil de Otimizacao (largura total). Descricao com TRUNCACAO — nunca estica a linha
                             (bug antigo: TextWrapping em coluna de largura 0 gerava altura infinita e empurrava a tabela pra fora) -->
                        <Border Margin="0,10,0,0" Background="{StaticResource CardBackground}" BorderBrush="{StaticResource AccentColor}" BorderThickness="1" CornerRadius="8" Padding="12,8">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD700" BlurRadius="10" Opacity="0.1" ShadowDepth="0"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Perfil de Otimização de Serviços" Foreground="{StaticResource AccentColor}" FontWeight="Bold" FontSize="13" Margin="0,0,0,2"/>
                                    <TextBlock x:Name="TxtPresetDescription" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" FontSize="12"
                                               Text="Selecione um perfil e clique em Aplicar. Perfis desativam apenas serviços conhecidos como seguros."/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <ComboBox x:Name="CboServicePreset" Width="200" Height="32" FontSize="12" SelectionChanged="CboServicePreset_SelectionChanged">
                                        <ComboBoxItem Content="Seguro — Fax/Spooler/RetailDemo" Tag="Safe" IsSelected="True"/>
                                        <ComboBoxItem Content="Gamer — Telemetria/SysMain/Xbox..." Tag="Gamer"/>
                                        <ComboBoxItem Content="Gamer+ — Gamer + update de terceiros" Tag="GamerPlus"/>
                                        <ComboBoxItem Content="Restaurar padrão (Safe list)" Tag="Restore"/>
                                    </ComboBox>
                                    <Button x:Name="BtnApplyPreset" Content="Aplicar" Click="BtnApplyPreset_Click" Style="{StaticResource GoldButtonStyle}" Height="32" Margin="8,0,0,0"/>
                                    <Button Content="services.msc" Click="BtnOpenServicesMsc_Click" Style="{StaticResource SecondaryButtonStyle}" Height="32" Margin="8,0,0,0"
                                            ToolTip="Abre o gerenciador nativo de serviços do Windows"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- BARRA DE FERRAMENTAS -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Busca e Contador -->
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#20FFFFFF" CornerRadius="4" Height="30" Width="250" Margin="0,0,15,0">
                                <Grid>
                                    <TextBlock Text="&#x1F50D; Filtrar servi&#xE7;os..." Foreground="#888" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearchService}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtSearchService" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="5,0" TextChanged="TxtSearchService_TextChanged"/>
                                </Grid>
                            </Border>

                            <!-- Contador de Servi&#xE7;os -->
                            <TextBlock x:Name="TxtServiceCount" Text="Carregando..." Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
                        </StackPanel>

                        <!-- Toggles -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Mostrar Servi&#xE7;os Perigosos (Sistema)" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12"/>
                            <CheckBox x:Name="ChkShowDangerous" Style="{StaticResource ToggleSwitchStyle}" Click="ChkShowDangerous_Click"/>
                            <TextBlock Text="Apenas Terceiros" Foreground="#AAA" VerticalAlignment="Center" Margin="15,0,10,0" FontSize="12"/>
                            <CheckBox x:Name="ChkShowThirdParty" Style="{StaticResource ToggleSwitchStyle}" Click="ChkShowThirdParty_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- TABELA DE SERVI&#xC7;OS -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="#111">
                        <DataGrid x:Name="GridServices" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <!-- Nome Amig&#xE1;vel -->
                                <DataGridTextColumn Header="Nome" Binding="{Binding DisplayName}" Width="220" IsReadOnly="True" SortMemberPath="DisplayName">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="ToolTip" Value="{Binding Description}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- NOVA COLUNA: ID T&#xC9;CNICO -->
                                <DataGridTextColumn Header="ID (T&#xE9;cnico)" Binding="{Binding Name}" Width="150" IsReadOnly="True" SortMemberPath="Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Fabricante -->
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="100" IsReadOnly="True" SortMemberPath="Manufacturer">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Setter Property="FontStyle" Value="Italic"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Manufacturer}" Value="Microsoft">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Manufacturer}" Value="Terceiros">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Status (Cor) -->
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" IsReadOnly="True" SortMemberPath="Status">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Executando">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Parado">
                                                    <Setter Property="Foreground" Value="#888"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- Modo de Início (colorido: Desativado vermelho, Atrasado laranja) -->
                                <DataGridTextColumn Header="Início" Binding="{Binding StartMode}" Width="130" IsReadOnly="True" SortMemberPath="StartMode">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#AAA"/>
                                            <Setter Property="FontSize" Value="12"/>
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Desativado">
                                                    <Setter Property="Foreground" Value="#FF6F61"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Automático (Atrasado)">
                                                    <Setter Property="Foreground" Value="#FF9800"/>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Automático">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- N&#xED;vel de Seguran&#xE7;a (Badge Colorido) -->
                                <DataGridTemplateColumn Header="Seguran&#xE7;a" Width="*" SortMemberPath="Safety">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="3" Padding="5,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Safety}" Value="Safe">
                                                                <Setter Property="Background" Value="#204CAF50"/>
                                                                <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Safety}" Value="Dangerous">
                                                                <Setter Property="Background" Value="#20C42B1C"/>
                                                                <Setter Property="BorderBrush" Value="#C42B1C"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Safety}" Value="Caution">
                                                                <Setter Property="Background" Value="#20FFD700"/>
                                                                <Setter Property="BorderBrush" Value="#FFD700"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Safety}" Value="Unknown">
                                                                <Setter Property="Background" Value="#20FFD700"/>
                                                                <Setter Property="BorderBrush" Value="#FFD700"/>
                                                                <Setter Property="BorderThickness" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Safety}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>

                            <!-- Menu de Contexto (Bot&#xE3;o Direito) -->
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ServiceContextMenu}">
                                    <MenuItem Header="▶ Iniciar Agora (Ligar)" Click="MenuSvcStart_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#4CAF50" FontWeight="Bold"/>
                                    <MenuItem Header="■ Parar Agora (Desligar)" Click="MenuSvcStop_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#FF6F61" FontWeight="Bold"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="Configurar: AUTOM&#xC1;TICO" Click="MenuSvcAuto_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Configurar: AUTOM&#xC1;TICO (ATRASADO)" Click="MenuSvcDelayedAuto_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Configurar: MANUAL" Click="MenuSvcManual_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Restaurar Padr&#xE3;o" Click="MenuSvcDefault_Click" Style="{StaticResource ServiceMenuItem}" Foreground="{StaticResource AccentColor}"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="Configurar: DESATIVADO" Click="MenuSvcDisabled_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#FF6F61"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="Abrir services.msc" Click="BtnOpenServicesMsc_Click" Style="{StaticResource ServiceMenuItem}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Border>
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="▶ Iniciar Selecionado" Click="BtnStartService_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Margin="0,0,10,0" Foreground="#4CAF50"/>
                            <Button Content="■ Parar Selecionado" Click="BtnStopService_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Margin="0,0,10,0" Foreground="#FF6F61"/>
                            <Button Content="Início Atrasado" Click="BtnDelayedAuto_Click" Style="{StaticResource SecondaryButtonStyle}" Width="130" Margin="0,0,10,0"
                                    ToolTip="Configura como Automático (Atrasado): inicia após o boot, acelerando a inicialização do Windows"/>
                        </StackPanel>
                        <Button Content="Recarregar" Click="BtnRefreshServices_Click" HorizontalAlignment="Right" Width="120" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ABA 3: TAREFAS AGENDADAS -->
            <TabItem Header="Tarefas Agendadas">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="Tarefas de Telemetria e Manuten&#xE7;&#xE3;o em Segundo Plano" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtTaskCount" Text="0 tarefas" Foreground="#666" VerticalAlignment="Center" Margin="15,0,0,0" FontSize="11"/>
                        <Border Background="#20FFFFFF" CornerRadius="4" Height="26" Margin="15,0,0,0" BorderBrush="#404040" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0">
                                <TextBlock Text="Filtro:" Foreground="#888" FontSize="11" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="CboTaskFilter" SelectedIndex="0" Width="110" Height="22" FontSize="11"
                                          Background="#2d2d2d" Foreground="White" BorderBrush="#555"
                                          SelectionChanged="CboTaskFilter_SelectionChanged">
                                    <ComboBoxItem Content="Todos" IsSelected="True"/>
                                    <ComboBoxItem Content="Apenas Microsoft"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="1" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="#111">
                        <DataGrid x:Name="GridTasks" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome da Tarefa" Binding="{Binding Name}" Width="220" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Descri&#xE7;&#xE3;o" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Category}" Width="90" IsReadOnly="True" SortMemberPath="Category">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Category}" Value="Microsoft">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Category}" Value="Terceiros">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Estado" Width="100" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <Setter Property="Text" Value="ATIVO"/>
                                                                <Setter Property="Foreground" Value="#FF6F61"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <Setter Property="Text" Value="OTIMIZADO"/>
                                                                <Setter Property="Foreground" Value="#4CAF50"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="Desativar Microsoft" Click="BtnDisableMSTasks_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Desativar Todas" Click="BtnDisableAllTasks_Click" Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Restaurar Todas" Click="BtnRestoreAllTasks_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0"/>
                        <Button Content="Alternar Estado" Click="BtnToggleTask_Click" Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ABA 4: AN&#xC1;LISE DE BOOT (NOVA) -->
            <TabItem Header="An&#xE1;lise de Boot">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Resumo -->
                    <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="&#xDA;ltimo Tempo de Inicializa&#xE7;&#xE3;o:" Foreground="#AAA" FontSize="14"/>
                                <TextBlock x:Name="TxtBootTime" Text="Calculando..." Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,5,0,0"/>
                                <TextBlock x:Name="TxtBootDate" Text="" Foreground="#666" FontSize="12"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Analisar Agora" Click="BtnAnalyzeBoot_Click" Height="40" Width="120" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                    </Border>

                    <!-- Detalhes -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Apps e Servi&#xE7;os que atrasaram o in&#xED;cio:" Foreground="{StaticResource AccentColor}" FontWeight="Bold" Margin="0,0,0,10"/>

                        <Border Grid.Row="1" BorderBrush="#333" BorderThickness="1" CornerRadius="6" Background="#111">
                            <DataGrid x:Name="GridBootItems" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nome do Processo" Binding="{Binding ItemName}" Width="250" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding SubType}" Width="100" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Atraso" Width="120" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TimeTaken, StringFormat='{}{0:N0} ms'}" Foreground="#FF6F61" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Data" Binding="{Binding TimeOfEvent}" Width="*" IsReadOnly="True"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ABA 5: DRIVERS (LIGAR/DESLIGAR) -->
            <TabItem Header="Drivers (Ligar/Desligar)">
                <Grid Margin="0,15,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Info -->
                        <RowDefinition Height="Auto"/>
                        <!-- Filtros -->
                        <RowDefinition Height="*"/>
                        <!-- Tabela -->
                        <RowDefinition Height="Auto"/>
                        <!-- Ações -->
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#1A1A1A" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
                        <TextBlock Foreground="#AAA" FontSize="12" TextWrapping="Wrap"
                                   Text="Drivers kernel (arquivos .sys) carregados pelo Windows. 'Desligar' grava Start=4 no registro — o driver não carrega mais no boot (efeito após reiniciar). Drivers de boot do Windows são protegidos e não podem ser desligados. Este painel é o mesmo conjunto de dados da aba Kernel da página Drivers."/>
                    </Border>

                    <!-- FILTROS -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#20FFFFFF" CornerRadius="4" Height="30" Width="240" Margin="0,0,10,0">
                                <Grid>
                                    <TextBlock Text="&#x1F50D; Filtrar drivers..." Foreground="#888" VerticalAlignment="Center" Margin="10,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtDriverFilter}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBox x:Name="TxtDriverFilter" Background="Transparent" BorderThickness="0" Foreground="White" VerticalAlignment="Center" Margin="5,0" TextChanged="TxtDriverFilter_TextChanged"/>
                                </Grid>
                            </Border>
                            <CheckBox x:Name="ChkDriverThirdOnly" Content="Só terceiros" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0" Click="ChkDriverThirdOnly_Click"/>
                            <CheckBox x:Name="ChkDriverEnabled" Content="Somente ligados" Foreground="#AAA" VerticalAlignment="Center" Margin="0,0,10,0" Click="ChkDriverEnabled_Click" IsChecked="True"
                                      ToolTip="Esconde drivers já desligados (Start=4)"/>
                            <TextBlock x:Name="TxtDriverCount" Text="" Foreground="{StaticResource AccentColor}" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Recarregar" Click="BtnReloadDrivers_Click" Style="{StaticResource SecondaryButtonStyle}" Height="30"/>
                        </StackPanel>
                    </Grid>

                    <!-- TABELA DE DRIVERS -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="6" Background="#111">
                        <DataGrid x:Name="GridKernelDrivers" SelectionMode="Single" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Nome" Binding="{Binding Name}" Width="170" IsReadOnly="True" SortMemberPath="Name">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Setter Property="ToolTip" Value="{Binding DisplayName}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding DisplayName}" Width="*" IsReadOnly="True" SortMemberPath="DisplayName">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Fabricante" Binding="{Binding Manufacturer}" Width="90" IsReadOnly="True" SortMemberPath="Manufacturer">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#999"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Manufacturer}" Value="Microsoft">
                                                    <Setter Property="Foreground" Value="#4CAF50"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Manufacturer}" Value="Terceiros">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Início" Binding="{Binding StartName}" Width="80" IsReadOnly="True" SortMemberPath="StartValue">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StartValue}" Value="0">
                                                    <Setter Property="Foreground" Value="#FF3333"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StartValue}" Value="1">
                                                    <Setter Property="Foreground" Value="#FF6F00"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StartValue}" Value="2">
                                                    <Setter Property="Foreground" Value="#FFD700"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StartValue}" Value="4">
                                                    <Setter Property="Foreground" Value="#FF6F61"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Arquivo" Binding="{Binding ParentSoftware}" Width="150" IsReadOnly="True" SortMemberPath="ParentSoftware">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                            <Setter Property="Foreground" Value="#AAA"/>
                                            <Setter Property="ToolTip" Value="{Binding ResolvedPath}"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>

                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource ServiceContextMenu}">
                                    <MenuItem Header="&#x1F513; Ligar Driver (habilitar)" Click="MenuDriverEnable_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#4CAF50" FontWeight="Bold"/>
                                    <MenuItem Header="&#x1F512; Desligar Driver (desabilitar)" Click="MenuDriverDisable_Click" Style="{StaticResource ServiceMenuItem}" Foreground="#FF6F61" FontWeight="Bold"/>
                                    <Separator Background="#333"/>
                                    <MenuItem Header="Copiar nome" Click="MenuDriverCopyName_Click" Style="{StaticResource ServiceMenuItem}"/>
                                    <MenuItem Header="Abrir pasta do arquivo" Click="MenuDriverOpenFolder_Click" Style="{StaticResource ServiceMenuItem}"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                        </DataGrid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="&#x1F513; Ligar Selecionado" Click="BtnDriverEnable_Click" Style="{StaticResource SecondaryButtonStyle}" Width="150" Margin="0,0,10,0" Foreground="#4CAF50"/>
                            <Button Content="&#x1F512; Desligar Selecionado" Click="BtnDriverDisable_Click" Style="{StaticResource SecondaryButtonStyle}" Width="170" Margin="0,0,10,0" Foreground="#FF6F61"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Page>