                        </Button>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar GDI Scaling" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz carga da GPU em apps GDI legados (jogos antigos)." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusGdiScaling" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkGdiScaling" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkGdiScaling_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- SLIDE ENGINE (BOTTOM) -->
            <TextBlock Text="Performance Extrema (SLIDE)" FontSize="16" FontWeight="Bold" Foreground="#FFAA00" Margin="0,30,0,15"/>
            <Border Background="#1A1500" BorderBrush="#805500" BorderThickness="1" CornerRadius="8">
                <StackPanel>
                    
                    <!-- Aviso de Seguran&#xE7;a -->
                    <Border Background="#332000" BorderBrush="#995500" BorderThickness="1" CornerRadius="4" Padding="15" Margin="20,20,20,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x26A0;&#xFE0F; CUIDADO:" FontWeight="Bold" Foreground="#FFAA00" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Estas op&#xE7;&#xF5;es injetam mudan&#xE7;as extremas nos drivers prim&#xE1;rios do sistema." Foreground="#DDDDDD" FontSize="13" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Item 1: SLIDE Input -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFAA00" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="SLIDE" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Overdrive de Mouse &amp; Teclado" FontSize="15" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Remove recuos de polling. Define Kbdclass/Mouclass para prioridade m&#xE1;xima no Kernel." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Remove recuos de polling do mouse e teclado. Define Kbdclass e Mouclass para prioridade m&#xE1;xima no kernel (Priority=31). Isso reduz lat&#xEA;ncia de input em jogos competitivos."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusSlideInput" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkSlideInput" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkSlideInput_Click"/>
                    </Grid>

                    <Separator Background="#805500" Opacity="0.5"/>

                    <!-- Item 2: SLIDE USB -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFAA00" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="SLIDE" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Exterm&#xED;nio de Power Saving USB" FontSize="15" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Varre toda a &#xE1;rvore de perif&#xE9;ricos e previne micro-suspens&#xF5;es (Selective Suspend)." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Varre toda a &#xE1;rvore de dispositivos USB e desativa Selective Suspend em todos os perif&#xE9;ricos. Previne micro-suspens&#xF5;es que causam lag de input em jogos."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusSlideUsb" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkSlideUsb" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkSlideUsb_Click"/>
                    </Grid>

                    <Separator Background="#805500" Opacity="0.5"/>

                    <!-- Item 3: SLIDE Gaming -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFAA00" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="SLIDE" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Lat&#xEA;ncia Extrema de Rede &amp; GPU" FontSize="15" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Desativa GameDVR nativo e arranca visualizadores DWM. Extingue Nagle's Algorithm via rede." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa GameDVR nativo e reduz overhead de visualiza&#xE7;&#xE3;o DWM. Desativa Nagle's Algorithm na rede para reduzir lat&#xEA;ncia de pacotes. Melhora lat&#xEA;ncia de GPU e rede em jogos online."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusSlideGaming" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkSlideGaming" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkSlideGaming_Click"/>
                    </Grid>

                    <Separator Background="#805500" Opacity="0.5"/>

                    <!-- Item 4: PCIe Link State Power Management -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFAA00" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="SLIDE" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Desativar PCIe Link State Power Management" FontSize="15" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Desativa economia de energia PCIe (ASPM). Pode reduzir lat&#xEA;ncia de GPU em alguns sistemas." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa Link State Power Management (ASPM) para PCIe. Isso mant&#xE9;m o link PCIe sempre ativo, reduzindo lat&#xEA;ncia quando a GPU precisa de largura de banda m&#xE1;xima. Ganho de FPS varia entre sistemas (alguns usu&#xE1;rios reportaram 45-53 FPS para valores mais altos). N&#xE3;o recomendado para laptops (reduz bateria)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusPciePower" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkPciePower" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkPciePower_Click"/>
                    </Grid>

                    <Separator Background="#805500" Opacity="0.5"/>

                    <!-- Item 5: Hard Disk/Display Timeout -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#FFAA00" CornerRadius="4" Padding="4,1" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="SLIDE" FontSize="10" FontWeight="Bold" Foreground="Black" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Desativar Timeout de Disco e Tela" FontSize="15" Foreground="White" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Impede desligamento de disco e tela durante jogos longos." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Define timeout de disco e tela para 0 (nunca desligar). Evita que o disco r&#xED;gido ou a tela desliguem no meio de jogos longos. Recomendado para desktops gaming. N&#xE3;o recomendado para laptops (reduz bateria)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusTimeout" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkTimeout" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkTimeout_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GRUPO: HARDWARE & REDE -->
            <TextBlock Text="Hardware &amp; Rede" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,30,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#05202B" Offset="0.0"/>
                        <GradientStop Color="#041A22" Offset="0.5"/>
                        <GradientStop Color="#031418" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A6B80" Offset="0.0"/>
                        <GradientStop Color="#145568" Offset="0.5"/>
                        <GradientStop Color="#0E4050" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- Cache L2/L3 -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Ajusta o SecondLevelDataCache no registro com base no L2 Cache real da CPU. O Windows usa este valor para otimizar o agendamento de threads. Configurado pela Otimização Inteligente do Dashboard."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cache de CPU (L2/L3)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="SecondLevelDataCache baseado no L2 real da CPU." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                            <TextBlock x:Name="InfoCpu" Text="Verificando..." FontSize="11" Foreground="#80D0FF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusL2Cache" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkL2Cache" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkL2Cache_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <!-- RmCacheLoc (NVIDIA) -->
                    <Grid Margin="20,0,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="RmCacheLoc e um valor do Resource Manager do driver NVIDIA (lido por nvlddmkm/RM.dll). Guias de otimizacao o configuram com o numero de nucleos LOGICOS da CPU. E aplicado na Class\{4d36e968...}\00xx e em todos os Video\{GUID}\0000 NVIDIA (requer admin). So tem efeito com GPU NVIDIA - AMD/Intel ignoram o valor."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="14" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RmCacheLoc (NVIDIA)" FontSize="14" Foreground="White"/>
                            <TextBlock x:Name="InfoRmCacheLoc" Text="Configurado com o numero de nucleos logicos." FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusRmCacheLoc" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkRmCacheLoc" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkRmCacheLoc_Click" Margin="0,10,20,10"/>
                    </Grid>

                    <!-- Nagle's Algorithm -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa o Nagle's Algorithm em todas as interfaces de rede ativas (TCPNoDelay=1, TcpAckFrequency=1). Reduz latência de pacotes em jogos online. Aplica o mesmo tweak que o SLIDE Gaming afirma fazer (mas não fazia de fato)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Nagle (TCPNoDelay)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz lat&#xEA;ncia de rede em jogos online." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusNagle" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkNagle" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkNagle_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- Core Parking -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa Core Parking (ValueMax=0, ValueMin=0). Mantém todos os núcleos da CPU ativos e prontos, eliminando latência de reativação de cores adormecidos. Melhora performance em jogos CPU-bound."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Core Parking" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Mant&#xE9;m todos os n&#xFA;cleos da CPU ativos." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusCoreParking" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkCoreParking" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkCoreParking_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- HAGS -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="HAGS (Hardware Accelerated GPU Scheduling, HwSchMode=2) permite que a GPU gerencie sua própria memória e fila de trabalho, reduzindo latência e melhorando consistência de FPS. Benchmark: 2-5% de ganho em jogos, menor input lag. Padrão é 1 (driver scheduling). Recomendado para GPUs NVIDIA RTX 30+ / AMD RX 6000+ / Intel Arc."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
