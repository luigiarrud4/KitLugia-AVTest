                <StackPanel>
                    <ToggleButton x:Name="TglPrivacySection" Click="TglPrivacySection_Click" Cursor="Hand" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Left" Margin="15,0">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent">
                                    <ContentPresenter/>
                                </Border>
                            </ControlTemplate>
                        </ToggleButton.Template>
