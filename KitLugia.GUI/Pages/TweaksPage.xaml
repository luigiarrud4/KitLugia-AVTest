                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="0,16,15,12">
                            <TextBlock Text="Desativar Tarefas de Telemetria (Agendador)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Desativa as tarefas de telemetria do Agendador (Application Experience + CEIP)." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#103050" BorderBrush="#306080" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusTelemetryTasks" Text="Verificando..." Foreground="#8AB4F8" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkTelemetryTasks" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkTelemetryTasks_Click" Margin="0,16,20,16"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GRUPO: STARTUP + SHUTDOWN -->
            <TextBlock Text="Inicializa&#xE7;&#xE3;o e Desligamento" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,25,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2A2E" Offset="0.0"/>
                        <GradientStop Color="#242428" Offset="0.5"/>
                        <GradientStop Color="#1E1E22" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#666666" Offset="0.0"/>
                        <GradientStop Color="#555555" Offset="0.5"/>
                        <GradientStop Color="#444444" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- Startup Delay -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Remove o atraso artificial que o Windows Explorer espera antes de carregar a inicialização (StartupDelayInMSec=0). Melhora o tempo de inicialização para área de trabalho, especialmente em SSDs. O atraso padrão varia de 0 a 10 segundos dependendo do hardware."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Remover Startup Delay" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Elimina atraso de carregamento do Explorer na inicializa&#xE7;&#xE3;o." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusStartupDelay" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkStartupDelay" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkStartupDelay_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Fast Startup (Hiberboot) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa o Fast Startup (HiberbootEnabled=0), um híbrido entre hibernação e desligamento. Desativar resolve: drivers que não carregam corretamente, dual-boot com problemas, alterações no registro que não persistem, e certos erros de hardware. Recomendado para sistemas com SSD (a diferença de velocidade é mínima)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Fast Startup (Hybrid Boot)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="For&#xE7;a desligamento completo. Resolve problemas de driver e registro." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusFastStartup" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkFastStartup" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkFastStartup_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Boot Menu Timeout -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Define o timeout do menu de boot do Windows para 0 segundos via bcdedit. Acelera a inicialização ao pular automaticamente a tela de escolha de sistema operacional. Se você usa dual-boot (Linux + Windows), mantenha o valor padrão (30s) para ter tempo de escolher."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Boot Menu Timeout (0s)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pula a tela de sele&#xE7;&#xE3;o de SO na inicializa&#xE7;&#xE3;o (bcdedit)." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusBootMenu" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkBootMenu" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkBootMenu_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- NumLock on Startup -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Define se o NumLock deve ser ativado automaticamente na inicialização do Windows. Quando ativado, o LED do NumLock acende e o teclado numérico funciona já no login. Útil para quem usa o teclado numérico para digitar senha."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NumLock na Inicializa&#xE7;&#xE3;o" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Ativa o NumLock automaticamente ao ligar o PC." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusNumLock" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkNumLock" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkNumLock_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <!-- ======= DESLIGAMENTO ======= -->
                    <TextBlock Text="⏻ Desligamento" FontSize="13" FontWeight="Bold" Foreground="#AAAAAA" Margin="20,5,0,0"/>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- WaitToKillServiceTimeout -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Reduz o tempo que o Windows espera pelo fechamento de serviços em segundo plano ao desligar de 5s para 2s (WaitToKillServiceTimeout=2000). Acelera significativamente o desligamento. Não recomendado abaixo de 1000ms para evitar perda de dados."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="WaitToKillServiceTimeout (2s)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz espera de serviços em 2s. Acelera desligamento." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusWaitToKillService" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkWaitToKillService" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkWaitToKillService_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- WaitToKillAppTimeout + HungAppTimeout + AutoEndTasks combinado -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Combinação de 3 tweaks: WaitToKillAppTimeout (fecha apps em 2s), HungAppTimeout (detecta apps travados em 1s) e AutoEndTasks (fecha automaticamente sem perguntar). Juntos eliminam a tela 'Aguardando...' no desligamento."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
