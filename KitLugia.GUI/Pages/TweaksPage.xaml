                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Aumenta a fila de entrada do mouse e teclado de 100 para 200 pacotes. Reduz micro-stutters de input em jogos competitivos ao dar mais buffer para eventos de mouse/teclado. Ambos MouseDataQueueSize e KeyboardDataQueueSize são ajustados para 200. Efeito: input mais consistente em altas taxas de polling."/>
