                            <TextBlock Text="Impede desligamento de disco e tela durante jogos longos." FontSize="12" Foreground="#A0A0A0" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="Define timeout de disco e tela para 0 (nunca desligar). Evita que o disco r&#xED;gido ou a tela desliguem no meio de jogos longos. Recomendado para desktops gaming. N&#xE3;o recomendado para laptops (reduz bateria)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <TextBlock x:Name="StatusTimeout" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkTimeout" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkTimeout_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GRUPO: HARDWARE & REDE -->
            <TextBlock Text="Hardware &amp; Rede" FontSize="16" FontWeight="Bold" Foreground="#4FC3F7" Margin="0,30,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#05202B" Offset="0.0"/>
                        <GradientStop Color="#041A22" Offset="0.5"/>
                        <GradientStop Color="#031418" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A6B80" Offset="0.0"/>
                        <GradientStop Color="#145568" Offset="0.5"/>
                        <GradientStop Color="#0E4050" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- Cache L2/L3 -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Ajusta o SecondLevelDataCache no registro com base no L2 Cache real da CPU. O Windows usa este valor para otimizar o agendamento de threads. Configurado pela Otimização Inteligente do Dashboard."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Cache de CPU (L2/L3)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="SecondLevelDataCache baseado no L2 real da CPU." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                            <TextBlock x:Name="InfoCpu" Text="Verificando..." FontSize="11" Foreground="#80D0FF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusL2Cache" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkL2Cache" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkL2Cache_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <!-- RmCacheLoc (NVIDIA) -->
                    <Grid Margin="20,0,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="RmCacheLoc e um valor do Resource Manager do driver NVIDIA (lido por nvlddmkm/RM.dll). Guias de otimizacao o configuram com o numero de nucleos LOGICOS da CPU. E aplicado na Class\{4d36e968...}\00xx e em todos os Video\{GUID}\0000 NVIDIA (requer admin). So tem efeito com GPU NVIDIA - AMD/Intel ignoram o valor."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="14" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RmCacheLoc (NVIDIA)" FontSize="14" Foreground="White"/>
                            <TextBlock x:Name="InfoRmCacheLoc" Text="Configurado com o numero de nucleos logicos." FontSize="11" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusRmCacheLoc" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkRmCacheLoc" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkRmCacheLoc_Click" Margin="0,10,20,10"/>
                    </Grid>

                    <!-- Nagle's Algorithm -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa o Nagle's Algorithm em todas as interfaces de rede ativas (TCPNoDelay=1, TcpAckFrequency=1). Reduz latência de pacotes em jogos online. Aplica o mesmo tweak que o SLIDE Gaming afirma fazer (mas não fazia de fato)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Nagle (TCPNoDelay)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz lat&#xEA;ncia de rede em jogos online." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusNagle" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkNagle" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkNagle_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- Core Parking -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa Core Parking (ValueMax=0, ValueMin=0). Mantém todos os núcleos da CPU ativos e prontos, eliminando latência de reativação de cores adormecidos. Melhora performance em jogos CPU-bound."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Core Parking" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Mant&#xE9;m todos os n&#xFA;cleos da CPU ativos." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusCoreParking" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkCoreParking" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkCoreParking_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- HAGS -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="HAGS (Hardware Accelerated GPU Scheduling, HwSchMode=2) permite que a GPU gerencie sua própria memória e fila de trabalho, reduzindo latência e melhorando consistência de FPS. Benchmark: 2-5% de ganho em jogos, menor input lag. Padrão é 1 (driver scheduling). Recomendado para GPUs NVIDIA RTX 30+ / AMD RX 6000+ / Intel Arc."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="HAGS (GPU Scheduling Acelerado)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="HwSchMode=2. GPU gerencia própria fila, reduz lat&#xEA;ncia. 2-5% FPS." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusHags" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkHags" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkHags_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- TDR Delay -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="TDR (Timeout Detection &amp; Recovery) reinicia o driver GPU se ele travar por mais de 2s. Aumentar TdrDelay para 10s evita resets falsos em jogos pesados com shaders complexos ou texturas HD. Útil se você receber 'driver parou de responder e foi recuperado'. Padrão: 2s. Recomendado: 10s."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Aumentar TDR Delay (GPU Timeout)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Evita resets falsos do driver GPU em jogos pesados (2s &#x2192; 10s)." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusTdr" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkTdr" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkTdr_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- IoPageLockLimit -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="IoPageLockLimit define quantos KB de memória podem ser travados para operações de I/O (disco, GPU). Aumentar para 8192 (8 MB) reduz micro-stutters em jogos com streaming de texturas. Padrão é 0 (512 KB). Efeito: menos stutter em textura loading. Recomendado para sistemas com 16 GB+ de RAM."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="IoPageLockLimit (Cache I/O)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Aumenta mem&#xF3;ria travada para I/O. Reduz stutter em streaming de texturas." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusIoLock" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkIoLock" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkIoLock_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#1A5568" Opacity="0.4" Margin="20,0"/>

                    <!-- Input Queue Size -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Aumenta a fila de entrada do mouse e teclado de 100 para 200 pacotes. Reduz micro-stutters de input em jogos competitivos ao dar mais buffer para eventos de mouse/teclado. Ambos MouseDataQueueSize e KeyboardDataQueueSize são ajustados para 200. Efeito: input mais consistente em altas taxas de polling."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fila de Input (Mouse/Teclado)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Aumenta buffer de entrada para input mais consistente." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#0A2838" BorderBrush="#1A6B80" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusInputQueue" Text="Verificando..." Foreground="#4FC3F7" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkInputQueue" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkInputQueue_Click" Margin="0,20,20,20"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- GRUPO: INTERFACE & EXPLORER -->
            <TextBlock Text="Interface e Explorer" FontSize="16" FontWeight="Bold" Foreground="#E8B84E" Margin="0,30,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2418" Offset="0.0"/>
                        <GradientStop Color="#221E14" Offset="0.5"/>
                        <GradientStop Color="#1A1810" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D4A84E" Offset="0.0"/>
                        <GradientStop Color="#B8902E" Offset="0.5"/>
                        <GradientStop Color="#A0781E" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- MenuShowDelay -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Remove o atraso de 400ms que o Windows adiciona aos menus contextuais e popups (MenuShowDelay=0). Os menus aparecem instantaneamente ao clicar com o botão direito. Efeito: interface mais responsiva e ágil."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Remover Delay de Menus (0ms)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Menus contextuais e popups instant&#xE2;neos ao clique direito." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusMenuDelay" Text="Verificando..." Foreground="#E8B84E" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkMenuDelay" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkMenuDelay_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- VisualFX (animações) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa animações visuais do Windows (VisualFXSetting=2) como fade, slide e zoom de janelas. Em sistemas mais fracos ou para quem prioriza responsividade, desativar efeitos visuais reduz uso de CPU/GPU e torna a interface mais rápida."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Anima&#xE7;&#xF5;es Visuais" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Remove efeitos fade/slide. M&#xE1;ximo desempenho visual." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusVisualFX" Text="Verificando..." Foreground="#E8B84E" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkVisualFX" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkVisualFX_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Explorer LaunchTo (ComboBox) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Define para qual local o File Explorer abre quando iniciado. Opções: 'Acesso Rápido' (padrão), 'Este Computador' (acesso direto às unidades), 'Downloads' (acesso rápido a downloads). O Kit lê e mantém o valor atual selecionado automaticamente."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Abrir Explorer em" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Escolhe o local padr&#xE3;o ao abrir o File Explorer." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="0" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0" Height="28">
                            <ComboBox x:Name="ChkExplorerLaunchTo" SelectedIndex="0" VerticalAlignment="Center" Width="130" Margin="4,0" FontSize="12" Foreground="#E8B84E" Background="#1A1810" BorderThickness="0" SelectionChanged="ChkExplorerLaunchTo_SelectionChanged"/>
                        </Border>
                        <CheckBox Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" IsEnabled="False" Opacity="0" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Icon Cache -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Aumenta o cache de ícones do Windows para 8192 KB (padrão é ~2048). Com um cache maior, o Explorer não precisa recarregar ícones de arquivos e pastas com tanta frequência, resultando em uma navegação mais rápida e sem demora para renderizar ícones."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Aumentar Cache de &#xCD;cones (8192KB)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Explorer renderiza &#xED;cones mais r&#xE1;pido sem recarregar." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusIconCache" Text="Verificando..." Foreground="#E8B84E" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkIconCache" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkIconCache_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- PCA (Program Compatibility Assistant) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa o Program Compatibility Assistant (PCA), um serviço que monitora programas em busca de problemas de compatibilidade conhecidos. Desativar elimina notificações indesejadas e reduz processamento em segundo plano, especialmente ao executar instaladores ou programas antigos."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar PCA (Compat. Assistant)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Elimina verifica&#xE7;&#xE3;o de compatibilidade em segundo plano." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusPCA" Text="Verificando..." Foreground="#E8B84E" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkPCA" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkPCA_Click" Margin="0,20,20,20"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- AVISO DE REIN&#xCD;CIO -->
            <Border Background="#2D2020" BorderBrush="#503030" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;&#xFE0F;" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                    <TextBlock Text="Altera&#xE7;&#xF5;es nestas configura&#xE7;&#xF5;es exigem que voc&#xEA; reinicie o computador para serem aplicadas pelo Windows." 
                               Foreground="#FFC0C0" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>