                        <TextBlock x:Name="StatusWmp" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkWmp" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkWmp_Click"/>
                    </Grid>
                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- 14. Automatic Maintenance -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:InfoButton Grid.Column="0" ToolTipText="Manutenção Automática do Windows: roda defrag, diagnósticos e scans em janelas de idle — e pode ACORDAR o PC do sono. Esta configuração impede o despertar automático e amplia a janela aleatória de execução. A manutenção continua acontecendo, só não mais te acorda de madrugada."/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Configurar Manutenção Automática (não acordar PC)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Manutenção continua, mas nunca acorda o computador." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusMaintenance" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkMaintenance" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkMaintenance_Click"/>
                    </Grid>
                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- 15. Storage Sense -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:InfoButton Grid.Column="0" ToolTipText="Storage Sense: limpa temporários, esvazia lixeira antiga e remove arquivos da pasta Downloads não abertos há X dias — AUTOMATICAMENTE. O problema: pode deletar coisa que você queria (Downloads é notório). Quem já usa a Limpeza do KitLugia não precisa dele. Desativar dá controle total sobre o que é apagado."/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Storage Sense (limpeza automática)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Impede o Windows de deletar arquivos sozinho." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusStorageSense" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkStorageSense" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkStorageSense_Click"/>
                    </Grid>
                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- 16. Reserved Storage -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:InfoButton Grid.Column="0" ToolTipText="Reserved Storage: desde o Win10 1903, o Windows RESERVA ~7GB do disco exclusivamente para Windows Update (garante que updates nunca falhem por falta de espaço). Em discos grandes ou bem gerenciados, são 7GB parados à toa. Desativar libera o espaço NA HORA; o WU continua funcionando (se um dia faltar espaço, ele pede limpeza em vez de falhar). ATENÇÃO: só vale a pena se você tem costume de manter o disco com folga. Operação via DISM leva alguns segundos."/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Liberar Reserved Storage (~7GB)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Devolve os ~7GB reservados para Windows Update." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="StatusReserveStorage" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>
                        <CheckBox x:Name="ChkReserveStorage" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkReserveStorage_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- AVISO DE REIN&#xCD;CIO -->
            <Border Background="#2D2020" BorderBrush="#503030" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x26A0;&#xFE0F;" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="16"/>
                    <TextBlock Text="Altera&#xE7;&#xF5;es nestas configura&#xE7;&#xF5;es exigem que voc&#xEA; reinicie o computador para serem aplicadas pelo Windows." 
                               Foreground="#FFC0C0" VerticalAlignment="Center" FontSize="13"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>