                        </StackPanel>
                        <Button x:Name="BtnRestoreExplorerVisual" Grid.Column="2" Content="REPARAR EXPLORER" Click="BtnRestoreExplorerVisual_Click" Style="{StaticResource GoldButtonStyle}" Width="180" Height="38" FontWeight="Bold" VerticalAlignment="Center" Margin="0,10,20,10"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Turbo Explorer Automatico (watchdog F11) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Quando o explorer.exe reinicia (login do Windows, crash ou restart do shell), o truque do F11 (entrar/sair de tela cheia, que forca o re-render da pasta) e perdido. Com este toggle ATIVADO o Kit vigia o processo e, na 1a pasta aberta apos cada reinicio do Explorer, reaplica o F11 sozinho — o 'ir direto ao arquivo' (navegador -> 'Mostrar na pasta') continua instantaneo sem voce apertar nada. A aplicacao e INVISIVEL: a janela fica oculta por fracoes de segundo durante o toggle (nao pula em tela cheia, nao interrompe o que voce esta fazendo). Desligue se preferir aplicar manualmente pelo item do tray 'Turbo Explorer (F11)' ou com Ctrl+F11."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#E8B84E" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Turbo Explorer autom&#xE1;tico (F11 ao reiniciar)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reaplica o F11 re-render sozinho quando o explorer.exe reiniciar (login/crash)." Foreground="#A0A0A0"/>
                            <TextBlock Text="1x por processo — o 'ir direto ao arquivo' continua instant&#xE2;neo ap&#xF3;s reboot, sem Ctrl+F11." FontSize="11" Foreground="#9A9066" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1A1810" BorderBrush="#A0781E" BorderThickness="1" Margin="0,0,15,0">
