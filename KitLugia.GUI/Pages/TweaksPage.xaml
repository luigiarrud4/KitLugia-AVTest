<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.TweaksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:KitLugia.GUI.Controls"
      Title="Tweaks"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,50" MaxWidth="900" HorizontalAlignment="Left">

            <TextBlock Text="Desempenho e Tweaks" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="White"/>
            <TextBlock Text="Altera&#xE7;&#xF5;es avan&#xE7;adas no registro. Mudan&#xE7;as exigem reinicializa&#xE7;&#xE3;o." Foreground="#A0A0A0" Margin="0,0,0,30"/>

            <!-- GRUPO 1: JOGOS -->
            <TextBlock Text="Jogos e Gr&#xE1;ficos" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,0,0,15"/>
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Item 1: Game Mode -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Define prioridade 'High' para jogos no registro via HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows NT\CurrentVersion\Multimedia\SystemProfile\GameMode. Reduz latência e melhora FPS em jogos, dando prioridade de CPU aos processos de jogos."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Prioridade de GPU (Game Mode)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Define prioridade 'High' para jogos no registro." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusGame" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkGameMode" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkGameMode_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 2: MPO -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Multi-Plane Overlay (MPO) é um recurso da GPU que permite ao DWM sobrepor múltiplos planos de imagem sem composição. Pode causar telas piscando e micro-stutters em placas NVIDIA/AMD. Desativar força o DWM a compor tudo em um único plano, resolvendo esses problemas."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Multi-Plane Overlay (MPO)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Corrige telas piscando e stutters em placas NVIDIA/AMD." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusMPO" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkMPO" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkMPO_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 3: Timer & Latency -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Ajusta o PlatformClock para ACPI (mais estável), desativa o Tick Dinâmico (permite interrupções de timer mais precisas) e define a resolução do timer para 1ms (padrão é 15.6ms). Reduz latência de interrupções em jogos. Efeito: melhora estabilidade de FPS."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Otimizar Timer &amp; Lat&#xEA;ncia (HPET)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Ajusta PlatformClock, Tick Din&#xE2;mico e Resolu&#xE7;&#xE3;o do Timer (1ms)." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusTimer" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkTimer" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkTimer_Click"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- GRUPO: GPU & SCHEDULING -->
            <TextBlock Text="GPU &amp; Scheduling" FontSize="16" FontWeight="Bold" Foreground="#AA88FF" Margin="0,25,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A0A2E" Offset="0.0"/>
                        <GradientStop Color="#150826" Offset="0.5"/>
                        <GradientStop Color="#0E0620" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#7744CC" Offset="0.0"/>
                        <GradientStop Color="#6633AA" Offset="0.5"/>
                        <GradientStop Color="#552288" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- GPU Selector -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Seleciona qual GPU será usada como alvo para os tweaks de agendamento (FrameQueue, Preemption, Idle, Latency). A VRAM abaixo mostra todas as GPUs com toggle independente. A GPU selecionada aqui é usada como referência para o kit aplicar os tweaks corretamente."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AA88FF" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Adaptador de Vídeo (GPU):" Foreground="#BB99FF" FontSize="12" Margin="0,0,15,4"/>
                            <ComboBox x:Name="ChkGpuSelector" Height="32" MinWidth="280" SelectionChanged="ChkGpuSelector_SelectionChanged">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" Foreground="White" Padding="5"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="15,0,0,0">
                            <TextBlock Text="GPU alvo para tweaks de agendamento" Foreground="#A0A0A0" FontSize="11"/>
                            <TextBlock Text="A VRAM abaixo mostra TODAS as GPUs com toggle individual." Foreground="#8877AA" FontSize="10" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#552288" Opacity="0.4" Margin="20,0"/>

                    <!-- VRAM Dedicada (dinâmico por GPU) -->
                    <StackPanel x:Name="VramContainer" Margin="0"/>

                    <Separator x:Name="VramSeparator" Background="#552288" Opacity="0.4" Margin="20,0" Visibility="Collapsed"/>

                    <!-- FrameQueueMode -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="FrameQueueMode=0 força mínima fila de quadros (Low Latency). Reduz input lag drasticamente ao evitar que a GPU enfileire múltiplos quadros antes de processar. Padrão Windows é 'Normal' (1), que adiciona latência. Recomendado para jogos competitivos."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AA88FF" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="FrameQueueMode (Low Latency)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="For&#xE7;a fila m&#xED;nima de quadros na GPU para menor input lag." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                            <TextBlock x:Name="InfoFrameQueue" Text="Verificando..." FontSize="11" Foreground="#BB99FF" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E0A40" BorderBrush="#7744CC" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusFrameQueue" Text="Verificando..." Foreground="#BB99FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkFrameQueue" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkFrameQueue_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#552288" Opacity="0.4" Margin="20,0"/>

                    <!-- EnablePreemption -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="EnablePreemption=1 permite que a GPU interrompa tarefas computacionais longas para renderizar quadros mais urgentes. Reduz micro-stutters em jogos que usam compute shaders e async compute. Compatível com NVIDIA, AMD e Intel."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AA88FF" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Preempção de GPU (EnablePreemption)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Permite interromper tarefas GPU longas para renderizar quadros." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E0A40" BorderBrush="#7744CC" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusPreemption" Text="Verificando..." Foreground="#BB99FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkPreemption" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkPreemption_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#552288" Opacity="0.4" Margin="20,0"/>

                    <!-- DisableGpuIdle -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="DisableGpuIdle=1 impede que a GPU entre em estado de idle (economia) durante jogos. Elimina micro-latência de reativação. Mantém a GPU sempre pronta para processar o próximo quadro. Impacto maior em GPUs NVIDIA com drivers recentes."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AA88FF" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar GPU Idle" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Impede a GPU de entrar em economia durante jogos." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E0A40" BorderBrush="#7744CC" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusGpuIdle" Text="Verificando..." Foreground="#BB99FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkGpuIdle" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkGpuIdle_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#552288" Opacity="0.4" Margin="20,0"/>

                    <!-- GPU Power Latency -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Latency=1 no power profile da GPU prioriza latência sobre economia de energia. Instrui o driver a não reduzir clocks ou estados de energia durante cargas GPU-bound. Complementa o Disable Dynamic Pstate dos drivers NVIDIA/AMD."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AA88FF" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="GPU Power Latency" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Prioriza lat&#xEA;ncia sobre economia de energia na GPU." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E0A40" BorderBrush="#7744CC" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusPowerLatency" Text="Verificando..." Foreground="#BB99FF" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkPowerLatency" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkPowerLatency_Click" Margin="0,20,20,20"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- GRUPO: SMARTCREEN -->
            <TextBlock Text="SmartScreen e Navega&#xE7;&#xE3;o" FontSize="16" FontWeight="Bold" Foreground="#8AB4F8" Margin="0,25,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#082B3A" Offset="0.0"/>
                        <GradientStop Color="#081F2A" Offset="0.5"/>
                        <GradientStop Color="#081520" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#305565" Offset="0.0"/>
                        <GradientStop Color="#254555" Offset="0.5"/>
                        <GradientStop Color="#1A3545" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>
                    <!-- SmartScreen (Sistema) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="20,18,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Remove o filtro SmartScreen do Windows, que envia dados de aplicativos e arquivos para a Microsoft. Desativar reduz uso de CPU/RAM e elimina bloqueios durante instalação de programas. Recomenda-se manter um antivírus de terceiros ativo."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="0,16,15,12">
                            <TextBlock Text="Desativar SmartScreen (Sistema)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Desativar o SmartScreen trar&#xE1; uma experi&#xEA;ncia mais leve ao Windows.&#x0a;Recomenda-se ter um antiv&#xED;rus instalado." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#103050" BorderBrush="#306080" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusSmartScreenSystem" Text="Verificando..." Foreground="#8AB4F8" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkSmartScreenSystem" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkSmartScreenSystem_Click" Margin="0,16,20,16"/>
                    </Grid>

                    <Separator Background="#254455" Opacity="0.4" Margin="20,0"/>

                    <!-- SmartScreen (Explorer - Bloqueio de Arquivos) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="20,18,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Impede que o Windows Explorer bloqueie a execu&#xE7;&#xE3;o de arquivos baixados ou suspeitos com base na reputa&#xE7;&#xE3;o na nuvem. Ao desativar, voc&#xEA; poder&#xE1; abrir qualquer arquivo sem ser barrado pelo SmartScreen."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="0,12,15,16">
                            <TextBlock Text="Desativar Bloqueio do Explorer (SmartScreen)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Esse comando faz o Windows deixar voc&#xEA; usar seus arquivos&#x0a;sem serem bloqueados pelo SmartScreen." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#103050" BorderBrush="#306080" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusSmartScreenExplorer" Text="Verificando..." Foreground="#8AB4F8" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkSmartScreenExplorer" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkSmartScreenExplorer_Click" Margin="0,12,20,16"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GRUPO: STARTUP + SHUTDOWN -->
            <TextBlock Text="Inicializa&#xE7;&#xE3;o e Desligamento" FontSize="16" FontWeight="Bold" Foreground="#CCCCCC" Margin="0,25,0,15"/>
            <Border CornerRadius="8" Padding="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2A2E" Offset="0.0"/>
                        <GradientStop Color="#242428" Offset="0.5"/>
                        <GradientStop Color="#1E1E22" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#666666" Offset="0.0"/>
                        <GradientStop Color="#555555" Offset="0.5"/>
                        <GradientStop Color="#444444" Offset="1.0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
                <Border.BorderThickness>1</Border.BorderThickness>
                <StackPanel>

                    <!-- Startup Delay -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Remove o atraso artificial que o Windows Explorer espera antes de carregar a inicialização (StartupDelayInMSec=0). Melhora o tempo de inicialização para área de trabalho, especialmente em SSDs. O atraso padrão varia de 0 a 10 segundos dependendo do hardware."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Remover Startup Delay" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Elimina atraso de carregamento do Explorer na inicializa&#xE7;&#xE3;o." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusStartupDelay" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkStartupDelay" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkStartupDelay_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Fast Startup (Hiberboot) -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa o Fast Startup (HiberbootEnabled=0), um híbrido entre hibernação e desligamento. Desativar resolve: drivers que não carregam corretamente, dual-boot com problemas, alterações no registro que não persistem, e certos erros de hardware. Recomendado para sistemas com SSD (a diferença de velocidade é mínima)."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Fast Startup (Hybrid Boot)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="For&#xE7;a desligamento completo. Resolve problemas de driver e registro." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusFastStartup" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkFastStartup" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkFastStartup_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- Boot Menu Timeout -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Define o timeout do menu de boot do Windows para 0 segundos via bcdedit. Acelera a inicialização ao pular automaticamente a tela de escolha de sistema operacional. Se você usa dual-boot (Linux + Windows), mantenha o valor padrão (30s) para ter tempo de escolher."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Boot Menu Timeout (0s)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Pula a tela de sele&#xE7;&#xE3;o de SO na inicializa&#xE7;&#xE3;o (bcdedit)." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusBootMenu" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkBootMenu" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkBootMenu_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- NumLock on Startup -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Define se o NumLock deve ser ativado automaticamente na inicialização do Windows. Quando ativado, o LED do NumLock acende e o teclado numérico funciona já no login. Útil para quem usa o teclado numérico para digitar senha."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="NumLock na Inicializa&#xE7;&#xE3;o" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Ativa o NumLock automaticamente ao ligar o PC." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusNumLock" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkNumLock" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkNumLock_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <!-- ======= DESLIGAMENTO ======= -->
                    <TextBlock Text="⏻ Desligamento" FontSize="13" FontWeight="Bold" Foreground="#AAAAAA" Margin="20,5,0,0"/>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- WaitToKillServiceTimeout -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Reduz o tempo que o Windows espera pelo fechamento de serviços em segundo plano ao desligar de 5s para 2s (WaitToKillServiceTimeout=2000). Acelera significativamente o desligamento. Não recomendado abaixo de 1000ms para evitar perda de dados."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="WaitToKillServiceTimeout (2s)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz espera de serviços em 2s. Acelera desligamento." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusWaitToKillService" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkWaitToKillService" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkWaitToKillService_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- WaitToKillAppTimeout + HungAppTimeout + AutoEndTasks combinado -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Combinação de 3 tweaks: WaitToKillAppTimeout (fecha apps em 2s), HungAppTimeout (detecta apps travados em 1s) e AutoEndTasks (fecha automaticamente sem perguntar). Juntos eliminam a tela 'Aguardando...' no desligamento."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fechamento R&#xE1;pido de Apps" FontSize="15" Foreground="White"/>
                            <TextBlock Text="WaitToKillApp + HungApp + AutoEndTasks. Adeus 'Aguardando...'." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusQuickAppKill" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkQuickAppKill" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkQuickAppKill_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- ClearPageFileAtShutdown -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Impede que o Windows limpe o arquivo de paginação (pagefile) ao desligar (ClearPageFileAtShutdown=0). A limpeza do pagefile adiciona segundos extras ao desligamento, especialmente em sistemas com muita RAM. Desativar acelera o desligamento sem impacto na estabilidade."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Limpeza do PageFile" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Evita limpeza do pagefile ao desligar. Acelera shutdown." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusClearPageFile" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkClearPageFile" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkClearPageFile_Click" Margin="0,20,20,20"/>
                    </Grid>

                    <Separator Background="#444444" Opacity="0.4" Margin="20,0"/>

                    <!-- VerboseStatus -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="0,0,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Ativa mensagens detalhadas durante inicialização e desligamento (verbosestatus=1). Em vez do spinner genérico, você vê exatamente qual serviço está iniciando/parando. Útil para diagnosticar lentidão no boot/shutdown. Apenas informativo, não acelera o processo."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="#AAAAAA" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Mensagens Detalhadas (VerboseStatus)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Mostra servi&#xE7;os iniciando/parando no boot/shutdown." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#1E1E22" BorderBrush="#555555" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusVerboseStatus" Text="Verificando..." Foreground="#AAAAAA" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkVerboseStatus" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkVerboseStatus_Click" Margin="0,20,20,20"/>
                    </Grid>

                </StackPanel>
            </Border>

            <!-- GRUPO 2: SISTEMA -->
            <TextBlock Text="Sistema e Seguran&#xE7;a" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,30,0,15"/>
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Item 3: VBS -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Virtualization-Based Security (VBS) é um recurso de segurança do Windows que virtualiza componentes críticos usando Hyper-V. Consome 5-15% de CPU e até 2 GB de RAM. Desativar VBS é um dos maiores ganhos de FPS em jogos competitivos. ATENÇÃO: alguns anti-cheats como Easy Anti-Cheat podem não funcionar como esperado com VBS desativado. Recomendado para: gamers. Não recomendado para: ambientes corporativos."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Seguran&#xE7;a VBS (Ganho de FPS)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Virtualiza&#xE7;&#xE3;o de Seguran&#xE7;a. Desativar aumenta performance em CPU bound." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusVBS" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <!-- ATEN&#xC7;&#xC3;O: Aqui invertemos a l&#xF3;gica. Switch Azul = VBS DESLIGADO (Bom para Gamer) -->
                        <CheckBox x:Name="ChkVBS" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkVBS_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 4: Bing -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Remove as sugestões de pesquisa da web (Bing) do Menu Iniciar e da caixa de pesquisa. Reduz chamadas de rede desnecessárias quando você digita no Menu Iniciar. A pesquisa local de arquivos e configurações continua funcionando normalmente."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Pesquisa Web (Bing)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Remove sugest&#xF5;es da internet no Menu Iniciar." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusBing" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkBing" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkBing_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 5: MemoryUsage -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Equivalente a 'fsutil behavior set memoryusage 2'. Aumenta a frequência de descarga do cache do sistema de arquivos NTFS, reduzindo o uso de memória do kernel em cenários de alta carga de E/S. Efeito: pode reduzir travamentos em jogos que usam muita leitura/escrita de disco."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Otimizar Uso de Mem&#xF3;ria (Fsutil)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Equivalente a 'fsutil behavior set memoryusage 2'. Otimiza gerenciamento de mem&#xF3;ria." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusMemoryUsage" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkMemoryUsage" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkMemoryUsage_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 6: Fast Shutdown -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <controls:InfoButton Grid.Column="0" ToolTipText="Reduz o tempo de espera do Windows para fechar aplicativos ao desligar, de 5 segundos para 2 segundos (ShutdownTurbo). Configuração: WaitToKillServiceTimeout = 2000ms em HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control. Desliga o PC mais rápido sem esperar serviços travarem."/>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desligamento Turbo (Shutdownturbo)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Reduz o tempo de espera para fechar apps ao desligar (2s)." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusShutdown" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkShutdown" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkShutdown_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- GRUPO 3: TWEAKS DIVERSOS -->
            <TextBlock Text="Tweaks Diversos" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,30,0,15"/>
            <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="8" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <!-- Item 1: Background Apps -->
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" 
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="30" Height="30" Cursor="Help" Margin="0,0,10,0"
                                ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                            <Button.ToolTip>
                                <ToolTip Content="GPEDIT: Computer Configuration > Administrative Templates > Windows Components > App Privacy > Let Windows apps run in the background = Force Deny. Impede que aplicativos da Microsoft executem em background, reduzindo processos e uso de CPU."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desativar Apps em Segundo Plano" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Impede que aplicativos da Microsoft executem em background (reduz processos)." FontSize="12" Foreground="#808080" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="StatusBackgroundApps" Text="Verificando..." Grid.Column="2" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="Gray" FontWeight="SemiBold"/>

                        <CheckBox x:Name="ChkBackgroundApps" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkBackgroundApps_Click"/>
                    </Grid>

                    <Separator Background="{StaticResource CardBorder}"/>

                    <!-- Item 2: NDU Service (Memory Leak Fix) -->
                    <Grid Margin="20">
