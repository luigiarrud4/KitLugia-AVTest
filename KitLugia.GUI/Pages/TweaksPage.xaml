                        </Button>
                        <StackPanel Grid.Column="1" Margin="0,16,15,12">
                            <TextBlock Text="Desativar Compatibilidade (PcaSvc)" FontSize="15" Foreground="White"/>
                            <TextBlock Text="Desliga o Assistente de Compatibilidade de Programas e seus diagnosticos." FontSize="12" Foreground="#A0A0A0" Margin="0,2,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Padding="8,3" CornerRadius="4" Background="#103050" BorderBrush="#306080" BorderThickness="1" Margin="0,0,15,0">
                            <TextBlock x:Name="StatusPcaSvc" Text="Verificando..." Foreground="#8AB4F8" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <CheckBox x:Name="ChkPcaSvc" Grid.Column="3" Style="{StaticResource ToggleSwitchStyle}" Click="ChkPcaSvc_Click" Margin="0,16,20,16"/>
                    </Grid>

                    <Separator Background="#254455" Opacity="0.4" Margin="20,0"/>

                    <!-- Tarefas de telemetria (Agendador) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Width="30" Height="30" Cursor="Help" Margin="20,18,10,0" ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000" VerticalAlignment="Top">
                            <Button.ToolTip>
                                <ToolTip Content="Desativa todas as tarefas do Agendador nas pastas Application Experience (PcaPatchDbTask, DiskDiagnostic, ProgramDataUpdater, AitAgent...) e Customer Experience Improvement Program (CEIP). Tarefas protegidas podem nao mudar - o Kit avisa se sobrar alguma ativa."/>
                            </Button.ToolTip>
                            <TextBlock Text="&#x2139;&#xFE0F;" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="Transparent">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
