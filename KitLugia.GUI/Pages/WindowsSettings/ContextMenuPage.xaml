<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.ContextMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:KitLugia.GUI.Controls"
      Title="Menu de Contexto"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Page.Resources>
        <!-- Hover brush for menu items -->
        <SolidColorBrush x:Key="MenuHoverBrush" Color="#3A3A4A"/>
        <SolidColorBrush x:Key="MenuItemText" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="MenuItemMuted" Color="#888899"/>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,50" MaxWidth="900" HorizontalAlignment="Left">

            <!-- ================================================================ -->
            <!-- TITULO -->
            <!-- ================================================================ -->
            <TextBlock Text="&#x1F4CB; Menu de Contexto do Windows" FontSize="32" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="White"/>
            <TextBlock Text="Simulador 1:1 do menu de clique direito do Explorer. Selecione onde clicaria, veja o menu real, remova entradas indesejadas ou adicione novas." Foreground="{DynamicResource TextDescription}" Margin="0,0,0,25" TextWrapping="Wrap"/>

            <!-- ================================================================ -->
            <!-- BARRA DE BACKUP (compacta) -->
            <!-- ================================================================ -->
            <Border CornerRadius="6" Background="#14281A" BorderBrush="#3A6644" BorderThickness="1" Margin="0,0,0,20" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#x1F4BE;" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock x:Name="BackupStatus" Grid.Column="1" Text="Verificando backup..." FontSize="11" Foreground="#77AA88" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                    <Button x:Name="BtnRestoreBackup" Grid.Column="2" Content="&#x21A9; Restaurar" FontSize="11" Padding="10,4" Margin="0,0,6,0" Cursor="Hand" Click="BtnRestoreBackup_Click" Visibility="Collapsed">
                        <Button.Background><SolidColorBrush Color="#336622"/></Button.Background>
                        <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                    </Button>

                    <Button x:Name="BtnBackupNow" Grid.Column="3" Content="&#x1F504; Backup" FontSize="11" Padding="10,4" Cursor="Hand" Click="BtnBackupNow_Click">
                        <Button.Background><SolidColorBrush Color="#224488"/></Button.Background>
                        <Button.Foreground><SolidColorBrush Color="White"/></Button.Foreground>
                    </Button>
                </Grid>
            </Border>

            <!-- ================================================================ -->
            <!-- SELETOR DE CONTEXTO (onde voce "clicou com botao direito") -->
            <!-- ================================================================ -->
            <TextBlock Text="Clique com o botao direito em:" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,8"/>

            <WrapPanel x:Name="ContextChips" Orientation="Horizontal" Margin="0,0,0,20"/>

            <!-- ================================================================ -->
            <!-- MENU DE CONTEXTO SIMULADO (1:1) -->
            <!-- ================================================================ -->
            <TextBlock x:Name="EmptyHint" Text="Nenhuma entrada personalizada encontrada para este contexto." Foreground="{DynamicResource TextMuted}" FontSize="13" FontStyle="Italic" Margin="0,0,0,20" Visibility="Collapsed"/>

            <Border x:Name="SimulatedMenu" CornerRadius="8" Background="#2B2B30" BorderBrush="#404048" BorderThickness="1" Padding="4" HorizontalAlignment="Left" MinWidth="280" MaxWidth="420" Visibility="Collapsed">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.6"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="480" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="MenuPanel"/>
                </ScrollViewer>
            </Border>

            <!-- ================================================================ -->
            <!-- SEPARADOR -->
            <!-- ================================================================ -->
            <Separator Background="#22FFD700" Opacity="0.15" Margin="0,25,0,20"/>

            <!-- ================================================================ -->
            <!-- QUICK-ADD: Adicionar entradas predefinidas -->
            <!-- ================================================================ -->
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x2795; Adicionar ao Menu de Contexto" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                <Border Grid.Column="1" Padding="8,2" CornerRadius="10" Background="#224488">
                    <TextBlock x:Name="QuickAddActiveCount" Text="0 ativas" Foreground="#88CCFF" FontWeight="SemiBold" FontSize="11"/>
                </Border>
            </Grid>
            <TextBlock Text="Ative as opicoes para adiciona-las ao menu de contexto do Explorer. Desative para remove-las." Foreground="{DynamicResource TextDescription}" FontSize="12" Margin="0,0,0,15"/>

            <!-- Grid 2 colunas para os toggles -->
            <UniformGrid Rows="0" Columns="2" x:Name="QuickAddGrid"/>

        </StackPanel>
    </ScrollViewer>
</Page>
