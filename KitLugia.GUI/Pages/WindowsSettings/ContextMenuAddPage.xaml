<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.ContextMenuAddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Adicionar ao Menu de Contexto"
      Background="{StaticResource WindowBackground}"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="&#x26A1; Adicionar ao Menu de Contexto" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
            <TextBlock Text="Super comandos turbinados com toda a tecnologia do Kit — IPC, Restart Manager, PowerShell nativo. Adicione ou remova com 1 clique; tudo reversível."
                       Foreground="#A0A0A0" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- Grade de cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <UniformGrid x:Name="QuickAddGrid" Columns="3"/>
        </ScrollViewer>
    </Grid>
</Page>
