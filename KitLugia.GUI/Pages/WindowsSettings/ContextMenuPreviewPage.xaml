<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.ContextMenuPreviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Preview do Menu de Contexto"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="40,30,40,50" MaxWidth="860" HorizontalAlignment="Left">

            <TextBlock Text="&#x1F9EA; Preview 1:1 do Menu de Contexto" FontSize="32" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,6"/>
            <TextBlock Text="Selecione o tipo de item e veja o menu exatamente como no Windows Explorer." Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,25"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Clique com o bot&#xE3;o direito em:" Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center"/>
                <ComboBox x:Name="CtxSelector" Grid.Column="2" FontSize="13" Height="34"
                          Background="#2A2A35" Foreground="White" BorderBrush="#4A4A5A"
                          SelectionChanged="CtxSelector_SelectionChanged"/>
            </Grid>

            <TextBlock x:Name="EntriesEmpty" Text="Nenhuma entrada encontrada para este contexto."
                       Foreground="#7777AA" FontSize="12" FontStyle="Italic"
                       Visibility="Collapsed" Margin="0,0,0,8"/>

            <Border x:Name="SimulatedMenu" CornerRadius="8" Background="#2C2C33"
                    BorderBrush="#4A4A55" BorderThickness="1" Padding="4"
                    Visibility="Collapsed" MinWidth="260" HorizontalAlignment="Left">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="6" Opacity="0.7"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="520" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="MenuItemsPanel"/>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
