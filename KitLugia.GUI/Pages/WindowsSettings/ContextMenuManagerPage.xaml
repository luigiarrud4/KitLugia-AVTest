<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.ContextMenuManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Gerenciador do Menu de Contexto"
      Background="{StaticResource WindowBackground}"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Page.Resources>
        <ControlTemplate x:Key="CmToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="30"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                <Path x:Name="Arrow" Grid.Column="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#333333"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="OverridesDefaultStyle" Value="True"/>
                        <Setter Property="Background" Value="#222222"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="MinHeight" Value="34"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter Property="Background" Value="#444444"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#333333"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource CmToggleButton}" Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#1A1A1A" BorderThickness="1" BorderBrush="#444444"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho + filtros -->
        <StackPanel Grid.Row="0" Margin="24,20,24,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x1F5B1;&#xFE0F; Gerenciador do Menu de Contexto" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Desabilite, habilite ou delete — sempre reversível e com backup."
                               Foreground="#A0A0A0" FontSize="12.5" Margin="0,3,0,10" TextWrapping="Wrap"/>
                </StackPanel>
                <Button x:Name="BtnRestoreAll" Grid.Column="1" Content="&#x21BB; Restaurar tudo"
                        Height="36" VerticalAlignment="Top" Padding="14,0"
                        Background="#2A2A2A" Foreground="#CCCCCC" BorderThickness="0" Cursor="Hand" FontSize="12.5"
                        Click="BtnRestoreAll_Click"
                        ToolTip="Remove TODOS os bloqueios e sombras LegacyDisable criados pelo KitLugia."/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtSearch" Grid.Column="0" Style="{StaticResource DarkTextBoxStyle}"
                         Tag="&#x1F50D;  Buscar item, escopo ou DLL..."
                         TextChanged="TxtSearch_TextChanged" Height="36" VerticalContentAlignment="Center"/>

                <ComboBox x:Name="CmbFilter" Grid.Column="1" Width="220" Height="36" Margin="12,0,0,0"
                          Style="{StaticResource DarkComboBoxStyle}" SelectionChanged="CmbFilter_SelectionChanged">
                    <ComboBoxItem Content="Todos os itens" IsSelected="True"/>
                    <ComboBoxItem Content="Só do Windows (sistema)"/>
                    <ComboBoxItem Content="Só de terceiros"/>
                    <ComboBoxItem Content="Só desabilitados"/>
                    <ComboBoxItem Content="Só habilitados"/>
                </ComboBox>

            </Grid>

            <TextBlock x:Name="TxtCount" Text="" Foreground="#808080" FontSize="12" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- LINHA 2: lista em cima, largura total -->
        <Grid Grid.Row="1" Margin="24,4,24,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- LISTA -->
            <ListBox x:Name="ItemsList" Grid.Column="0" Background="#111111" BorderBrush="#333333" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionMode="Single" SelectionChanged="ItemsList_SelectionChanged"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="12,9" Background="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" Foreground="White" FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <TextBlock Text="{Binding Scope}" FontSize="11" Foreground="#888888"/>
                                        <TextBlock Text=" • " FontSize="11" Foreground="#555555"/>
                                        <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#777777"/>
                                        <TextBlock Text="{Binding DllShort}" FontSize="11" Foreground="#666666"
                                                   Margin="6,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                        Background="#12294A00" BorderBrush="#5588CC" BorderThickness="1" CornerRadius="4" Padding="7,2"
                                        Visibility="{Binding IsSystemBadgeVisible}">
                                    <TextBlock Text="WINDOWS" FontSize="10" Foreground="#88BBEE" FontWeight="Bold"/>
                                </Border>
                                <Border Grid.Column="1" VerticalAlignment="Center" Margin="8,0"
                                        Background="#33FFD600" BorderBrush="#FFD600" BorderThickness="1" CornerRadius="4" Padding="7,2"
                                        Visibility="{Binding IsThirdPartyBadgeVisible}">
                                    <TextBlock Text="TERCEIROS" FontSize="10" Foreground="#FFD700" FontWeight="Bold"/>
                                </Border>

                                <Border Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,0"
                                        Background="#44FF3D00" BorderBrush="#FF3D00" BorderThickness="1" CornerRadius="4" Padding="7,2"
                                        Visibility="{Binding IsDisabledBadgeVisible}">
                                    <TextBlock Text="OFF" FontSize="10" Foreground="#FF8866" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>

        <!-- LINHA 3: PRÉVIA DO MENU (esquerda) + ITEM SELECIONADO/AÇÕES (direita) -->
        <Grid Grid.Row="2" Margin="24,4,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Prévia -->
            <Border Grid.Column="0" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="10">
                <StackPanel>
                    <TextBlock Text="&#x1F440; PRÉVIA DO MENU — só o que aparece de verdade" FontSize="11.5" Foreground="#A0A0A0" FontWeight="SemiBold" Margin="4,0,0,8"/>
                    <Border Background="#2B2B2B" BorderBrush="#454545" BorderThickness="1" CornerRadius="6" MaxHeight="230">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="SimulatedMenu"/>
                        </ScrollViewer>
                    </Border>
                    <TextBlock Text="Cinza ⊘ = desabilitado (oculto no menu real). Azul = componente do Windows."
                               FontSize="10.5" Foreground="#777777" Margin="2,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- Item selecionado -->
            <Border Grid.Column="1" Background="#161616" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="14" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="ITEM SELECIONADO" FontSize="11" Foreground="#888888" FontWeight="Bold"/>
                    <TextBlock x:Name="TxtSelName" Text="(nenhum)" FontSize="15" Foreground="White" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSelDetail" Text="Selecione um item na lista para ver detalhes e ações." FontSize="11.5" Foreground="#999999" TextWrapping="Wrap" Margin="0,0,0,12"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="BtnToggle" Grid.Column="0" Content="Desabilitar item" Height="34" Click="BtnToggle_Click" Margin="0,0,6,0"
                                Background="#2A2A2A" Foreground="White" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                        <Button x:Name="BtnDelete" Grid.Column="1" Content="&#x1F5D1; Deletar (com backup)" Height="34" Click="BtnDelete_Click" Margin="6,0,0,0"
                                Background="#4A1E1E" Foreground="#FF9999" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                    </Grid>
                    <TextBlock x:Name="TxtBackupInfo" Text="" FontSize="10.5" Foreground="#778866" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
