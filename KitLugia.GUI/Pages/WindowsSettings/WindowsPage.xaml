<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.WindowsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Configuracoes do Windows"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30,40,50" MaxWidth="900" HorizontalAlignment="Left">

                <!-- CABECALHO -->
                <TextBlock Text="&#x2699;&#xFE0F; Configuracoes do Windows" FontSize="36" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,8"/>
                <TextBlock Text="Gerencie teclado, mouse, acessibilidade, idioma, som, energia e mais — tudo integrado ao Windows." 
                           Foreground="#A0A0A0" FontSize="14" Margin="0,0,0,30" TextWrapping="Wrap"/>

                <!-- LINHA DE CARDS: FORCE STOP | MENU DE CONTEXTO | ADICIONAR AO MENU -->
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Click="BtnForceStopUnlock_Click" Padding="0" HorizontalAlignment="Stretch" Cursor="Hand" ToolTip="Libere arquivos bloqueados por processos no Windows">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BgBorder" CornerRadius="8" Background="#2A1A3A" BorderBrush="#AA44CC" BorderThickness="1" SnapsToDevicePixels="True">
                                    <StackPanel Margin="14,14">
                                        <TextBlock Text="&#x1F513;" FontSize="26"/>
                                        <TextBlock Text="Force Stop Unlock" FontSize="15" FontWeight="SemiBold" Foreground="#DD88CC" Margin="0,8,0,3"/>
                                        <TextBlock Text="Desbloqueie arquivos travados por processos — direto no bot&#xE3;o direito" FontSize="11" Foreground="#AA55AA" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#3A2A4A"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#4A3A5A"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="2" Click="BtnContextMenu_Click" Padding="0" HorizontalAlignment="Stretch" Cursor="Hand"
                            ToolTip="Gerencie tudo que aparece no bot&#xE3;o direito — Windows vs terceiros, com pr&#xE9;via visual">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BgBorder" CornerRadius="8" Background="#1A2A1E" BorderBrush="#33AA55" BorderThickness="1" SnapsToDevicePixels="True">
                                    <StackPanel Margin="14,14">
                                        <TextBlock Text="&#x1F5B1;&#xFE0F;" FontSize="26"/>
                                        <TextBlock Text="Menu de Contexto" FontSize="15" FontWeight="SemiBold" Foreground="#77DD99" Margin="0,8,0,3"/>
                                        <TextBlock Text="Gerencie tudo que aparece no bot&#xE3;o direito — Windows vs terceiros, com pr&#xE9;via visual" FontSize="11" Foreground="#559966" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#2A3A2E"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#3A4A3E"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="4" Click="BtnContextMenuAdd_Click" Padding="0" HorizontalAlignment="Stretch" Cursor="Hand"
                            ToolTip="Adicione super vers&#xF5;es dos comandos: Take Ownership turbo, Terminal, PowerShell 7 e mais">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BgBorder" CornerRadius="8" Background="#2A2415" BorderBrush="#AA9933" BorderThickness="1" SnapsToDevicePixels="True">
                                    <StackPanel Margin="14,14">
                                        <TextBlock Text="&#x26A1;" FontSize="26"/>
                                        <TextBlock Text="Adicionar ao Menu" FontSize="15" FontWeight="SemiBold" Foreground="#EEDD77" Margin="0,8,0,3"/>
                                        <TextBlock Text="Super comandos turbinados: Take Ownership r&#xE1;pido, Terminal, PowerShell e mais" FontSize="11" Foreground="#AA9955" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#3A3425"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="BgBorder" Property="Background" Value="#4A4435"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- SECAO: DISPOSITIVOS (Teclado, Mouse, Som, Impressoras, Bluetooth) -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x1F5A5;&#xFE0F; Dispositivos" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x2328;&#xFE0F;"
                        Content="Teclado"
                        ToolTip="Layout, atalhos, teclas de filtro e teclado virtual"
                        Click="BtnKeyboard_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F5B1;&#xFE0F;"
                        Content="Mouse e Touchpad"
                        ToolTip="Velocidade, botoes, rolagem e gestos"
                        Click="BtnMouse_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F50A;"
                        Content="Som e Audio"
                        ToolTip="Dispositivos de saida/entrada, volume e microfone"
                        Click="BtnSound_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F5A8;&#xFE0F;"
                        Content="Impressoras e Scanners"
                        ToolTip="Adicionar, remover e configurar impressoras"
                        Click="BtnPrinters_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4F6;"
                        Content="Bluetooth e Dispositivos"
                        ToolTip="Emparelhar fones, controle e outros dispositivos"
                        Click="BtnBluetooth_Click"/>

                <!-- ================================================================== -->
                <!-- SECAO: ACESSIBILIDADE -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x267F; Acessibilidade" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,24,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4E3;"
                        Content="Acessibilidade (Visao)"
                        ToolTip="Contraste alto, lupa, cursor, filtros de cor"
                        Click="BtnAccessibilityDisplay_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F3A4;"
                        Content="Acessibilidade (Audio)"
                        ToolTip="Legendas ocultas, narrador, dispositivos auditivos"
                        Click="BtnAccessibilityAudio_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F399;&#xFE0F;"
                        Content="Acessibilidade (Fala)"
                        ToolTip="Reconhecimento de voz e leitura de texto"
                        Click="BtnAccessibilitySpeech_Click"/>

                <!-- ================================================================== -->
                <!-- SECAO: IDIOMA, REGIAO E HORA -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x1F310; Idioma e Regiao" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,24,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F1E7;&#x1F1F7;"
                        Content="Idioma do Sistema"
                        ToolTip="Adicionar idiomas, teclado e regiao"
                        Click="BtnLanguage_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F556;"
                        Content="Data e Hora"
                        ToolTip="Fuso horario, sincronizacao e formato"
                        Click="BtnDateTime_Click"/>

                <!-- ================================================================== -->
                <!-- SECAO: PERSONALIZACAO -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x1F3A8; Personalizacao" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,24,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F5BC;&#xFE0F;"
                        Content="Tela de Fundo e Cores"
                        ToolTip="Papel de parede, cor de destaque e temas"
                        Click="BtnPersonalization_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4DD;"
                        Content="Tela de Bloqueio"
                        ToolTip="Imagem de fundo, notificacoes e apps na tela de bloqueio"
                        Click="BtnLockScreen_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4CC;"
                        Content="Barra de Tarefas e Iniciar"
                        ToolTip="Comportamento, icones e organizacao"
                        Click="BtnTaskbar_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4D0;"
                        Content="Fontes do Sistema"
                        ToolTip="Visualizar e gerenciar fontes instaladas"
                        Click="BtnFonts_Click"/>

                <!-- ================================================================== -->
                <!-- SECAO: ENERGIA (Bitsum estrela) -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x26A1; Plano de Energia" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,24,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F31F;"
                        Content="Bitsum Highest Performance &#x2B50;"
                        ToolTip="Plano de energia maximo desempenho — Bitsum (recomendado para jogos e trabalho pesado)"
                        Click="BtnPowerPlan_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F50B;"
                        Content="Energia e Suspensao (Windows)"
                        ToolTip="Configuracoes nativas de bateria e energia"
                        Click="BtnPowerSleep_Click"/>

                <!-- ================================================================== -->
                <!-- SECAO: SISTEMA -->
                <!-- ================================================================== -->
                <TextBlock Text="&#x1F4BB; Sistema" FontSize="18" FontWeight="Bold" Foreground="White" Margin="0,24,0,12"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4F1;"
                        Content="Tela e Resolucao"
                        ToolTip="Monitores, escala, orientacao e HDR"
                        Click="BtnDisplay_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F514;"
                        Content="Notificacoes e Alertas"
                        ToolTip="Gerenciar notificacoes de apps e sistema"
                        Click="BtnNotifications_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F4E6;"
                        Content="Apps Padrao e Inicializacao"
                        ToolTip="Programas padrao por tipo de arquivo e apps de inicializacao"
                        Click="BtnDefaultApps_Click"/>

                <Button Style="{StaticResource SettingsCardStyle}" Tag="&#x1F916;"
                        Content="Sobre o Windows"
                        ToolTip="Versao, especificacoes, nome do PC e ativacao"
                        Click="BtnAbout_Click"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>