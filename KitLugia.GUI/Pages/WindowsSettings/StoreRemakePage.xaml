<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.StoreRemakePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020" FontFamily="Segoe UI Variable, Segoe UI"
      TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">

    <Page.Resources>
        <Style x:Key="HeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A86DB"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#005A9E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A3A3A"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#404040"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9A9A9A"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0,10"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#2F2F2F"/><Setter Property="Foreground" Value="White"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CategoryChip" TargetType="Button" BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>

    </Page.Resources>

    <!-- Layout idêntico MS Store Win11: nav esquerda 68px + conteúdo -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="68"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Nav esquerda — igual Store Win11 (Home, Apps, Jogos, Biblioteca) -->
        <Border Grid.Column="0" Background="#242424" BorderBrush="#333333" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8,0,0">
                <Button x:Name="BtnNavHome" Style="{StaticResource NavBtn}" ToolTip="Início — destaques e categorias" Click="BtnNavHome_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Início" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavApps" Style="{StaticResource NavBtn}" ToolTip="Apps — produtividade e utilitários" Margin="0,4,0,0" Click="BtnTabSearch_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE71D;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Apps" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavGames" Style="{StaticResource NavBtn}" ToolTip="Jogos — categorias e destaques" Margin="0,4,0,0" Click="BtnTabGames_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Jogos" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavLibrary" Style="{StaticResource NavBtn}" ToolTip="Biblioteca — instalados e atualizações" Margin="0,4,0,0" Click="BtnTabInstalled_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NavLibCount" Text="Biblioteca" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnNavDownloads" Style="{StaticResource NavBtn}" ToolTip="Downloads — Atualizações e downloads (como Store)" Margin="0,4,0,0" Click="BtnNavDownloads_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="18" HorizontalAlignment="Center"/>
                        <TextBlock Text="Downloads" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
                <Rectangle Height="1" Fill="#333333" Margin="12,12,12,8"/>
                <Button Style="{StaticResource NavBtn}" ToolTip="Voltar ao Kit" Click="BtnBack_Click">
                    <StackPanel>
                        <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center"/>
                        <TextBlock Text="Voltar" FontSize="9" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Conteúdo Store — igual MS Store Win11 com Fluent/Mica aproximado -->
        <ScrollViewer x:Name="MainScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" PanningMode="Both" CanContentScroll="False" Padding="0,0,0,0" PreviewMouseWheel="MainScroll_PreviewMouseWheel">
            <StackPanel Margin="24,14,24,18">

                <!-- Top bar idêntica Store: breadcrumb + busca central + ações direita -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- Breadcrumb / título -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Microsoft Store" FontSize="13" Foreground="#9A9A9A" VerticalAlignment="Center"/>
                        <TextBlock Text="  ›  " FontSize="13" Foreground="#5A5A5A" VerticalAlignment="Center"/>
                        <TextBlock Text="Kit Remake" FontSize="13" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <TextBlock Text="  ·  mais rápida que a original" FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <!-- Busca central — idêntica Store (480px, arredondada, ícone lupa) -->
                    <Border Grid.Column="1" Width="480" Height="36" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="0,0,8,0" VerticalContentAlignment="Center" FontSize="13"/>
                            <ComboBox x:Name="CmbSource" Grid.Column="2" Margin="4,3,4,3" Background="#323232" Foreground="White" BorderBrush="#3A3A3A" SelectedIndex="0" VerticalContentAlignment="Center" FontSize="11">
                                <ComboBoxItem Content="Todos"/>
                                <ComboBoxItem Content="winget"/>
                                <ComboBoxItem Content="chocolatey"/>
                                <ComboBoxItem Content="MS Store"/>
                            </ComboBox>
                            <Button Grid.Column="3" Content="Buscar" Style="{StaticResource PrimaryBtn}" Padding="0" FontSize="12" Margin="0,3,4,3" Click="BtnSearch_Click"/>
                        </Grid>
                    </Border>
                    <!-- Ações direita — idênticas Store (ícones) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtWingetStatus" Text="winget: ..." FontSize="10" Foreground="#7AA8D6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="32" Height="32" Style="{StaticResource GhostBtn}" Padding="0" Click="BtnPopOut_Click" ToolTip="Abrir em janela separada (TaskManager style)" Margin="0,0,6,0"/>
                        <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="32" Height="32" Style="{StaticResource GhostBtn}" Padding="0" Click="BtnRefresh_Click" ToolTip="Atualizar lista"/>
                    </StackPanel>
                </Grid>

                <!-- ========== HOME PANEL — estilo MS Store real ========== -->
                <StackPanel x:Name="HomePanel" Visibility="Collapsed">

                    <!-- Hero carousel — cards grandes de apps em destaque -->
                    <Border x:Name="HeroCarousel" CornerRadius="12" Height="200" Margin="0,0,0,18" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0D1B2A" Offset="0"/>
                                <GradientStop Color="#1B2838" Offset="0.5"/>
                                <GradientStop Color="#0A1628" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid x:Name="HeroGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Card principal (featured) -->
                            <Border x:Name="HeroCardMain" Grid.Column="0" CornerRadius="12" Background="#162233" Margin="8" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="120" Height="120" CornerRadius="16" Background="#1A3050" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Grid><TextBlock x:Name="HeroMainIcon" Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="48" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HeroMainImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/></Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,12,0">
                                        <TextBlock x:Name="HeroMainSource" Text="DESTAQUE" FontSize="10" FontWeight="Bold" Foreground="#4CC2FF" Margin="0,0,0,4"/>
                                        <TextBlock x:Name="HeroMainName" Text="Carregando..." FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock x:Name="HeroMainPublisher" Text="" FontSize="12" Foreground="#8A9AB0" Margin="0,2,0,0"/>
                                        <TextBlock x:Name="HeroMainVersion" Text="" FontSize="11" Foreground="#6A7A90" Margin="0,4,0,8"/>
                                        <Button x:Name="HeroMainBtn" Content="Abrir" Style="{StaticResource PrimaryBtn}" Padding="16,6" FontSize="12" HorizontalAlignment="Left" Click="HeroMainBtn_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <!-- Cards laterais (2 cards empilhados) -->
                            <Grid Grid.Column="1" Margin="0,8,8,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="8"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border x:Name="HeroSide1Card" Grid.Row="0" CornerRadius="10" Background="#1A2A3A" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="12" Background="#203050" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Grid><TextBlock x:Name="HeroSide1Icon" Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#FF8C00" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HeroSide1Image" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/></Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock x:Name="HeroSide1Name" Text="" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="HeroSide1Publisher" Text="" FontSize="10" Foreground="#7A8A9A" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="HeroSide1Badge" Text="" FontSize="10" Foreground="#FF8C00" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="HeroSide2Card" Grid.Row="2" CornerRadius="10" Background="#1A2A3A" Cursor="Hand">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="56" Height="56" CornerRadius="12" Background="#203050" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Grid><TextBlock x:Name="HeroSide2Icon" Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#7FBA00" HorizontalAlignment="Center" VerticalAlignment="Center"/><Image x:Name="HeroSide2Image" Stretch="Uniform" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed"/></Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,8,0">
                                            <TextBlock x:Name="HeroSide2Name" Text="" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="HeroSide2Publisher" Text="" FontSize="10" Foreground="#7A8A9A" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="HeroSide2Badge" Text="" FontSize="10" Foreground="#7FBA00" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Seção: Atualizações disponíveis -->
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Atualizações disponíveis" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HomeUpdatesCount" Text="" FontSize="12" Foreground="#FF8C00" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Ver todos  &#xE76C;" Style="{StaticResource GhostBtn}" Padding="8,4" FontSize="11" Click="BtnNavDownloads_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="HomeUpdatesScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <StackPanel x:Name="HomeUpdatesPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Seção: Aplicativos populares -->
                    <Grid Margin="0,8,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Aplicativos populares" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <Button Grid.Column="1" Content="Ver todos  &#xE76C;" Style="{StaticResource GhostBtn}" Padding="8,4" FontSize="11" Click="BtnTabSearch_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="HomePopularScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,6">
                        <StackPanel x:Name="HomePopularPanel" Orientation="Horizontal"/>
                    </ScrollViewer>

                    <!-- Seção: Instalados recentemente -->
                    <Grid Margin="0,8,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Seus aplicativos" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <Button Grid.Column="1" Content="Biblioteca  &#xE76C;" Style="{StaticResource GhostBtn}" Padding="8,4" FontSize="11" Click="BtnTabInstalled_Click"/>
                    </Grid>
                    <Border Style="{StaticResource CardBorder}" Padding="10" MinHeight="120">
                        <StackPanel>
                            <StackPanel x:Name="HomeInstalledSpinner" HorizontalAlignment="Center" Margin="0,20,0,0">
                                <Ellipse Width="24" Height="24" Stroke="#0078D4" StrokeThickness="2" Fill="Transparent" RenderTransformOrigin="0.5,0.5" StrokeDashArray="22 13" HorizontalAlignment="Center">
                                    <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                    <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock Text="Carregando..." FontSize="11" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <TextBlock x:Name="HomeEmptyText" Text="" FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"/>
                            <!-- Mini grid de apps instalados (3 colunas) -->
                            <ItemsControl x:Name="HomeInstalledGrid">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="200" Height="56" CornerRadius="8" Background="#252525" BorderBrush="#333333" BorderThickness="1" Padding="10" Margin="0,0,6,6" Cursor="Hand" MouseLeftButtonDown="HomeInstalledItem_Click" Tag="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="36"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="36" Height="36" CornerRadius="8" Background="#323232">
                                                    <Grid><Image Source="{Binding IconSource}" Stretch="Uniform" Margin="3" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/></Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#6A6A6A" Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Stats compactos -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4CC2FF" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="HomeStatLibrary" Text="—" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="apps instalados" FontSize="10" Foreground="#6A6A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="6,0,6,0" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF8C00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="HomeStatUpdates" Text="—" FontSize="18" FontWeight="Bold" Foreground="#FF8C00"/>
                                    <TextBlock Text="atualizações pendentes" FontSize="10" Foreground="#6A6A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="6,0,0,0" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA8C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7FBA00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock x:Name="HomeStatStore" Text="—" FontSize="18" FontWeight="Bold" Foreground="#7FBA00"/>
                                    <TextBlock Text="pacotes Store" FontSize="10" Foreground="#6A6A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Ferramentas rápidas -->
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Ferramentas" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="Atualizar tudo (Force)" Style="{StaticResource PrimaryBtn}" Padding="12,5" FontSize="11" Click="BtnUpgradeAllForce_Click"/>
                            <Button Content="wsreset" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Margin="6,0,0,0" Click="BtnWsreset_Click"/>
                            <Button Content="Reparar Store" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Margin="6,0,0,0" Click="BtnRepairStore_Click"/>
                            <Button Content="Pendências" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Margin="6,0,0,0" Click="BtnCheckPhantoms_Click"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- ========== CONTEÚDO PADRÃO (Library/Search/Games) ========== -->
                <StackPanel x:Name="StandardContent">
                    <!-- Statscompactos (referenciados pelo code-behind) -->
                    <UniformGrid Columns="4" Margin="0,0,0,14" x:Name="StandardStatsPanel">
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4CC2FF" Margin="0,0,6,0"/><TextBlock Text="Biblioteca" FontSize="11" Foreground="#9A9A9A" VerticalAlignment="Center"/></StackPanel>
                                <TextBlock x:Name="TxtInstalledCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtSourcesInfo" Text="winget/choco/store" FontSize="10" Foreground="#6A6A6A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0" BorderBrush="#4A3520">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#FF8C00" Margin="0,0,6,0"/><TextBlock Text="Atualizações" FontSize="11" Foreground="#9A9A9A" VerticalAlignment="Center"/></StackPanel>
                                <TextBlock x:Name="TxtUpdatesCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#FF8C00" Margin="0,4,0,0"/>
                                <TextBlock Text="winget upgrade / choco outdated" FontSize="10" Foreground="#6A6A6A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEA8C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#7FBA00" Margin="0,0,6,0"/><TextBlock Text="MS Store" FontSize="11" Foreground="#9A9A9A" VerticalAlignment="Center"/></StackPanel>
                                <TextBlock x:Name="TxtStoreCount" Text="—" FontSize="24" FontWeight="Bold" Foreground="#7FBA00" Margin="0,4,0,0"/>
                                <TextBlock x:Name="TxtStoreStatus" Text="Get-AppxPackage" FontSize="10" Foreground="#6A6A6A"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}">
                            <StackPanel>
                                <TextBlock Text="Exibir" FontSize="11" Foreground="#9A9A9A"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button x:Name="BtnTabInstalled" Content="Biblioteca" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" Click="BtnTabInstalled_Click"/>
                                    <Button x:Name="BtnTabSearch" Content="Descobrir" Style="{StaticResource GhostBtn}" Padding="10,4" FontSize="11" Margin="6,0,0,0" Click="BtnTabSearch_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Categorias -->
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                        <TextBlock Text="Explorar:" FontSize="11" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Button Content="Todos" Style="{StaticResource CategoryChip}" Background="#0078D4" Foreground="White" Click="BtnTabInstalled_Click"/>
                        <Button Content="Produtividade" Style="{StaticResource CategoryChip}" Click="BtnCategory_Click" Tag="Produtividade"/>
                        <Button Content="Desenvolvimento" Style="{StaticResource CategoryChip}" Click="BtnCategory_Click" Tag="Desenvolvimento"/>
                        <Button Content="Jogos" Style="{StaticResource CategoryChip}" Click="BtnTabGames_Click"/>
                        <Button Content="Utilitários" Style="{StaticResource CategoryChip}" Click="BtnCategory_Click" Tag="Utilitários"/>
                    </StackPanel>

                    <!-- Pendências / Fantasmas -->
                    <Border Style="{StaticResource CardBorder}" Background="#1E1515" BorderBrush="#3A2020" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#FF8C00" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="Pendências e fantasmas" FontSize="12" FontWeight="SemiBold" Foreground="#FF8C00" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtPhantomSummary" Text=" — clique em Verificar" FontSize="10" Foreground="#8A6A6A" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Verificar pendências" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Click="BtnCheckPhantoms_Click"/>
                                    <Button Content="Corrigir 0x80073CFB" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Margin="6,0,0,0" Click="BtnFix73CFB_Click"/>
                                    <Button Content="Bloquear Preview" Style="{StaticResource GhostBtn}" Padding="10,5" FontSize="11" Margin="6,0,0,0" Click="BtnBlockMinecraftPreview_Click"/>
                                </StackPanel>
                            </Grid>
                            <Border x:Name="PhantomPanel" Visibility="Collapsed" Background="#0F0F0F" CornerRadius="6" BorderBrush="#2A1A1A" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="TxtPhantomLog" FontFamily="Consolas" FontSize="10" Foreground="#C08060" TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Info busca + progresso — barra Store -->
                <Grid x:Name="SearchInfoGrid" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtSearchInfo" Text="Dica: deixe vazio e clique Buscar para listar atualizações." FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtListInfo" Grid.Column="1" Text="" FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center"/>
                </Grid>

                <!-- Barra de busca indeterminada (finíssima, estilo MS Store) -->
                <Border x:Name="PbSearchBorder" Visibility="Collapsed" Margin="0,0,0,6">
                    <Grid Height="2">
                        <Border Background="#2A2A2A" CornerRadius="1"/>
                        <Border x:Name="PbSearchFill" Background="#0078D4" CornerRadius="1" HorizontalAlignment="Left" Width="60">
                            <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>

                <!-- Lista — Biblioteca Store com virtualização corrigida (Altura fixa 380 + CanContentScroll True) -->
                <Border x:Name="ListContainerBorder" Style="{StaticResource CardBorder}" Padding="10" MinHeight="300">
                    <StackPanel>
                        <!-- Loading spinner animado (visível durante carregamento inicial) -->
                        <StackPanel x:Name="LoadingSpinnerPanel" HorizontalAlignment="Center" Margin="0,40,0,0">
                            <Ellipse Width="32" Height="32" Stroke="#0078D4" StrokeThickness="2.5" Fill="Transparent" RenderTransformOrigin="0.5,0.5" StrokeDashArray="22 13" HorizontalAlignment="Center">
                                <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                                <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                            </Ellipse>
                            <TextBlock x:Name="TxtLoadingMsg" Text="Carregando apps instalados..." FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <TextBlock x:Name="TxtEmpty" Text="" FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,28,0,0" Visibility="Collapsed"/>
                        <!-- Lista instalada — virtualizada (Recycling + CacheLength) -->
                        <ListView x:Name="LvApps" Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                  Height="380"
                                  VirtualizingStackPanel.IsVirtualizing="True"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.CacheLength="4,4"
                                  VirtualizingPanel.CacheLengthUnit="Page"
                                  VirtualizingPanel.ScrollUnit="Pixel"
                                  ScrollViewer.CanContentScroll="True"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ScrollViewer.PanningMode="VerticalOnly"
                                  PreviewMouseWheel="LvApps_PreviewMouseWheel">
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel/>
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="#252525"/>
                                    <Setter Property="Margin" Value="0,0,0,6"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="BorderBrush" Value="#333333"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListViewItem">
                                                <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="10">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#2F2F2F"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#3A5A7A"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="#2A3440"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="44"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Ícone app — estilo Store (quadrado arredondado + sombra) -->
                                        <Border Width="44" Height="44" CornerRadius="8" Background="#323232" BorderBrush="#3A3A3A" BorderThickness="1">
                                            <Grid>
                                                <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="5" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/>
                                                <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/>
                                            </Grid>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.35"/>
                                            </Border.Effect>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="340"/>
                                                <Border Background="#1A2A3A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Source}" FontSize="9" Foreground="#4CC2FF"/>
                                                </Border>
                                                <Border Background="#2A1A00" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding UpdateBadgeVisibility}">
                                                    <TextBlock Text="atualização" FontSize="9" Foreground="#FF8C00" FontWeight="Bold"/>
                                                </Border>
                                                <!-- Rating (quando disponível) -->
                                                <TextBlock Text="★" FontSize="10" Foreground="#FFB900" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RatingCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#6A6A6A" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                <TextBlock Text=" · " FontSize="10" Foreground="#444444" Margin="4,0"/>
                                                <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#7A7A7A" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#8A8AB0"/>
                                                <TextBlock Text=" → " FontSize="10" Foreground="#FF8C00" Visibility="{Binding HasUpdateVisibility}" Margin="4,0"/>
                                                <TextBlock Text="{Binding AvailableVersion}" FontSize="10" Foreground="#FF8C00" FontWeight="SemiBold" Visibility="{Binding HasUpdateVisibility}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Atualizar" Tag="{Binding}" Style="{StaticResource PrimaryBtn}" Padding="10,5" FontSize="11" Margin="0,0,6,0" Visibility="{Binding HasUpdateVisibility}" Click="BtnUpdateOne_Click"/>
                                            <Button Content="Force" Tag="{Binding}" Style="{StaticResource GhostBtn}" Padding="8,5" FontSize="11" Margin="0,0,6,0" Visibility="{Binding HasUpdateVisibility}" Click="BtnForceUpdateOne_Click" ToolTip="Mata processos e atualiza"/>
                                            <Button Content="Abrir" Tag="{Binding}" Style="{StaticResource GhostBtn}" Padding="8,5" FontSize="11" Click="BtnOpenApp_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <!-- Grid de busca estilo MS Store real — cards 2 por linha, scroll interno 360px -->
                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" x:Name="SearchScroll" PreviewMouseWheel="SearchScroll_PreviewMouseWheel" PanningMode="Both" CanContentScroll="False">
                            <ItemsControl x:Name="SearchGrid" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel IsItemsHost="True" Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="320" Height="132" CornerRadius="10" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" Padding="12" Margin="0,0,10,10">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="#3A5A7A"/><Setter Property="Background" Value="#252525"/></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Width="48" Height="48" CornerRadius="10" Background="#2A2A2A" BorderBrush="#3A3A3A" BorderThickness="1" VerticalAlignment="Top">
                                                    <Grid><Image Source="{Binding IconSource}" Stretch="Uniform" Margin="6" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/><TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#5A5A5A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/></Grid>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="180" TextWrapping="NoWrap"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="10" Foreground="#6A6A6A" TextTrimming="CharacterEllipsis" MaxWidth="180" Margin="0,2,0,0"/>
                                                    <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#7A7A7A" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <Border Background="#1A2A3A" CornerRadius="4" Padding="6,2"><TextBlock Text="{Binding Source}" FontSize="9" Foreground="#4CC2FF"/></Border>
                                                        <Border Background="#1A2A10" CornerRadius="4" Padding="6,2" Margin="6,0,0,0" Visibility="{Binding HasUpdateVisibility}"><TextBlock Text="UPDATE" FontSize="9" Foreground="#7FBA00" FontWeight="Bold"/></Border>
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Version}" FontSize="9" Foreground="#8A8AB0"/>
                                                        <TextBlock Text=" → " FontSize="9" Foreground="#FF8C00" Visibility="{Binding HasUpdateVisibility}" Margin="4,0"/>
                                                        <TextBlock Text="{Binding AvailableVersion}" FontSize="9" Foreground="#FF8C00" FontWeight="SemiBold" Visibility="{Binding HasUpdateVisibility}"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center"><Button Content="Instalar" Tag="{Binding}" Style="{StaticResource PrimaryBtn}" Padding="12,6" FontSize="11" Click="BtnInstallCard_Click" ToolTip="winget/choco install"/><Button Content="Detalhes" Tag="{Binding}" Style="{StaticResource GhostBtn}" Padding="8,4" FontSize="10" Margin="0,6,0,0" Click="BtnOpenApp_Click"/></StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- Downloads — estilo MS Store 'Atualizações e downloads' -->
                <StackPanel x:Name="DownloadsPanel" Visibility="Collapsed">
                    <!-- Header -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Atualizações e downloads" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Verificar se há atualizações" Style="{StaticResource PrimaryBtn}" Padding="14,6" FontSize="12" Click="BtnRefresh_Click"/>
                    </Grid>

                    <!-- Seção: Atualizações pendentes -->
                    <Border x:Name="DownloadsUpdatesSection" Background="#1E1E1E" CornerRadius="10" Padding="16" Margin="0,0,0,16" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" x:Name="DownloadsUpdatesTitle" Text="Atualizações disponíveis" FontSize="14" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="Atualizar todos" Style="{StaticResource PrimaryBtn}" Padding="12,5" FontSize="11" Click="BtnUpgradeAllForce_Click"/>
                            </Grid>
                            <!-- Lista de updates -->
                            <ListView x:Name="LvDownloads" Background="Transparent" BorderThickness="0" MaxHeight="400"
                                      ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,10" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="48"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Ícone -->
                                                <Border Width="48" Height="48" CornerRadius="8" Background="#2A2A2A">
                                                    <Grid><Image Source="{Binding IconSource}" Stretch="Uniform" Margin="6" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality" RenderOptions.EdgeMode="Aliased"/><TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/></Grid>
                                                </Border>
                                                <!-- Nome + Publisher + Tipo -->
                                                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                                    <TextBlock FontSize="11" Foreground="#8A8A8A" TextTrimming="CharacterEllipsis" MaxWidth="300">
                                                        <Run Text="{Binding Publisher}"/>
                                                    </TextBlock>
                                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                        <TextBlock Text="{Binding Version}" FontSize="10" Foreground="#8A8AB0"/>
                                                        <TextBlock Text=" → " FontSize="10" Foreground="#FF8C00" Margin="4,0"/>
                                                        <TextBlock Text="{Binding AvailableVersion}" FontSize="10" Foreground="#FF8C00" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                                <!-- Status -->
                                                <TextBlock Grid.Column="2" Text="Atualização disponível" FontSize="12" Foreground="#FF8C00" VerticalAlignment="Center" Margin="16,0,0,0"/>
                                                <!-- Botões -->
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                    <Button Content="Atualizar" Tag="{Binding}" Style="{StaticResource PrimaryBtn}" Padding="14,6" FontSize="12" Click="BtnUpdateOne_Click"/>
                                                    <Button Tag="{Binding}" Style="{StaticResource GhostBtn}" Padding="6,6" FontSize="11" Margin="6,0,0,0" Click="BtnForceUpdateOne_Click" ToolTip="Force Stop + Atualizar">
                                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock x:Name="TxtDownloadsEmpty" Text="" FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,12,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Seção: Atualizações recentes -->
                    <Grid x:Name="DownloadsRecentSection" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Atualizações recentes" FontSize="16" FontWeight="SemiBold" Foreground="White"/>
                        <TextBlock Grid.Column="1" x:Name="DownloadsRecentCount" Text="" FontSize="12" Foreground="#6A6A6A" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="DownloadsRecentEmpty" Text="Nenhuma atualização recente." FontSize="12" Foreground="#6A6A6A" Margin="0,0,0,14" Visibility="Collapsed"/>
                </StackPanel>

                <!-- Log — rodapé Store (consola) -->
                <Border Style="{StaticResource CardBorder}" Margin="0,12,0,0" MaxHeight="160">
                    <StackPanel>
                        <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Atividade" FontSize="11" FontWeight="SemiBold" Foreground="#9A9A9A" VerticalAlignment="Center"/><Button x:Name="BtnCopyLog" Grid.Column="1" Content="Copiar" FontSize="11" Style="{StaticResource GhostBtn}" Padding="8,3" Click="BtnCopyLog_Click" ToolTip="Copiar logs para área de transferência (também visível no log do Kit)"/></Grid>
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="LogScroll_PreviewMouseWheel" PanningMode="Both" MaxHeight="120">
                            <TextBlock x:Name="TxtLog" Text="Pronto." FontSize="10" Foreground="#6A6A6A" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Widget de progresso flutuante — canto inferior direito (sempre visível, não rola) -->
        <Border x:Name="InlineProgressPanel" Grid.Column="1" Panel.ZIndex="90"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,18,16" MinWidth="300" MaxWidth="420"
                BorderBrush="#660078D4" BorderThickness="1" CornerRadius="10" Padding="14,10"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#EE1A1A1A" Offset="0"/>
                    <GradientStop Color="#DD0A0A0A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#0078D4" BlurRadius="18" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <!-- Animação de fade-in ao aparecer -->
            <Border.RenderTransform>
                <TranslateTransform X="0"/>
            </Border.RenderTransform>
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <!-- Spinner Win11 amarelo (5 dots girando, estilo AppsPage) -->
                    <Grid Grid.Column="0" Width="22" Height="22" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
                        <Grid.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:1.4"/></Storyboard></BeginStoryboard></EventTrigger></Grid.Triggers>
                        <Ellipse Width="4" Height="4" Fill="#0078D4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="0" Y="-8"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#0078D4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="7.6" Y="-2.5"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#0078D4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="4.7" Y="6.5"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#0078D4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="-4.7" Y="6.5"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="4" Height="4" Fill="#0078D4" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse.RenderTransform><TranslateTransform X="-7.6" Y="-2.5"/></Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <TextBlock x:Name="TxtInlineStatus" Grid.Column="1" Text="" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtInlinePercent" Grid.Column="2" Text="" FontSize="14" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <Border x:Name="InlineProgressTrack" Background="#333333" CornerRadius="3" Height="4">
                    <Border x:Name="InlineProgressFill" Background="#0078D4" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="TxtInlineDetail" Text="" FontSize="10" Foreground="#8A8A8A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </StackPanel>
        </Border>

        <!-- Dropdown de busca flutuante (Popup — não rola com o conteúdo) -->
        <Popup x:Name="SearchPopup" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade" StaysOpen="True" Panel.ZIndex="999">
            <Border Width="480" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Margin="0,4,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="4" Opacity="0.5"/>
                </Border.Effect>
                <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SearchDropdownResults"/>
                </ScrollViewer>
            </Border>
        </Popup>

        <!-- Detail modal — overlay estilo MS Store ao clicar num card -->
        <Border x:Name="DetailOverlay" Visibility="Collapsed" Grid.Column="1" Panel.ZIndex="200" Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" MaxHeight="520" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="12" Padding="0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <StackPanel Margin="24">
                        <!-- Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="80" Height="80" CornerRadius="12" Background="#2A2A2A" Margin="0,0,16,0">
                                <Grid>
                                    <Image x:Name="DetailIcon" Stretch="Uniform" Margin="6" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="DetailFallbackIcon" Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#7A7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailName" Text="" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailPublisher" Text="" FontSize="12" Foreground="#8A9AB0" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#1A2A3A" CornerRadius="4" Padding="8,2"><TextBlock x:Name="DetailSource" Text="" FontSize="10" Foreground="#4CC2FF"/></Border>
                                    <TextBlock x:Name="DetailVersion" Text="" FontSize="11" Foreground="#6A7A90" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="32" Height="32" Style="{StaticResource GhostBtn}" Padding="0" VerticalAlignment="Top" Click="DetailClose_Click"/>
                        </Grid>
                        <!-- Description -->
                        <TextBlock x:Name="DetailDescription" Text="" FontSize="12" Foreground="#8A8A8A" TextWrapping="Wrap" Margin="0,0,0,16" MaxHeight="100"/>
                        <!-- Info grid -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID" FontSize="10" Foreground="#5A5A5A"/>
                                <TextBlock x:Name="DetailId" Text="" FontSize="11" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Categoria" FontSize="10" Foreground="#5A5A5A"/>
                                <TextBlock x:Name="DetailCategory" Text="" FontSize="11" Foreground="#9A9A9A"/>
                            </StackPanel>
                        </Grid>
                        <!-- Update info -->
                        <Border x:Name="DetailUpdateInfo" Visibility="Collapsed" Background="#1A2A10" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7FBA00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Atualização disponível" FontSize="11" FontWeight="SemiBold" Foreground="#7FBA00"/>
                                    <TextBlock x:Name="DetailUpdateVersion" Text="" FontSize="10" Foreground="#6A8A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DetailActionBtn" Content="Instalar" Style="{StaticResource PrimaryBtn}" Padding="18,8" FontSize="13" Click="DetailAction_Click"/>
                            <Button x:Name="DetailForceBtn" Content="Force" Style="{StaticResource GhostBtn}" Padding="12,8" FontSize="12" Margin="8,0,0,0" Click="DetailForce_Click" ToolTip="Mata processos e atualiza"/>
                            <Button x:Name="DetailUninstallBtn" Content="Desinstalar" Style="{StaticResource GhostBtn}" Padding="12,8" FontSize="12" Margin="8,0,0,0" Click="DetailUninstall_Click" Foreground="#E74856"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Page>
