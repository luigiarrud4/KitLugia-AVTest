<Page x:Class="KitLugia.GUI.Pages.WindowsSettings.StoreRemakePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#202020" FontFamily="Segoe UI Variable, Segoe UI"
      TextOptions.TextFormattingMode="Display" SnapsToDevicePixels="True">

    <Page.Resources>
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <!-- Botão de ação principal estilo UniGetUI (accent, radius 4) -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#0078D4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A86DB"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#005A9E"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </Style.Triggers>
        </Style>
        <!-- Botões de toolbar estilo WinUI AppBarButton (flat, hover sutil) -->
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource PrimaryBtn}">
            <Setter Property="Background" Value="#323232"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#3A3A3A"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#404040"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ChipBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="#2F2F2F"/>
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="16,12,16,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ HEADER estilo UniGetUI: ícone grande + título 28pt + subtítulo ============ -->
        <Grid Grid.Row="0" Margin="4,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="44" Height="44" CornerRadius="10" Background="#0F1A2E" BorderBrush="#0078D4" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#4CC2FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock x:Name="TxtPageTitle" Text="Descobrir pacotes" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock x:Name="TxtPageSubtitle" Text="Busque no winget, Chocolatey e Microsoft Store e instale com um clique" FontSize="12" Opacity="0.6" Foreground="White"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtWingetStatus" Text="winget: ..." FontSize="10" Foreground="#7AA8D6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <Button Content="&#xE8A7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="34" Height="34" Style="{StaticResource GhostBtn}" Padding="0" Click="BtnPopOut_Click" ToolTip="Abrir em janela separada" Margin="0,0,6,0"/>
                <Button Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="34" Height="34" Style="{StaticResource GhostBtn}" Padding="0" Click="BtnBack_Click" ToolTip="Voltar ao Kit" Margin="0,0,6,0"/>
                <Button Content="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="12" Width="34" Height="34" Style="{StaticResource GhostBtn}" Padding="0" Click="BtnRefresh_Click" ToolTip="Atualizar lista"/>
            </StackPanel>
        </Grid>

        <!-- ============ TOOLBAR ROW estilo UniGetUI: botão principal + busca + filtros de fonte ============ -->
        <Grid Grid.Row="1" Margin="4,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Botão principal de ação (muda por aba: Atualizar tudo / pacote selecionado) -->
            <Button x:Name="MainToolbarButton" Grid.Column="0" Height="40" MinWidth="150" Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="MainToolbarButton_Click" ToolTip="Executa a ação principal da aba atual">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="MainToolbarIcon" Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock x:Name="MainToolbarText" Text="Instalar selecionado" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <!-- Mega query box estilo UniGetUI: caixa larga com underline accent no focus -->
            <Border Grid.Column="1" x:Name="MegaQueryContainer" Background="#2B2B2B" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4" Height="40" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="36"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7A7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="TxtSearch" Grid.Column="1" Background="Transparent" Foreground="White" BorderThickness="0" Padding="2,0,8,0" VerticalContentAlignment="Center" FontSize="13" KeyDown="TxtSearch_KeyDown" TextChanged="TxtSearch_TextChanged"/>
                    <TextBlock x:Name="TxtSearchPlaceholder" Grid.Column="1" Text="Pesquisar pacotes (nome, id, moniker...)" FontSize="12" Foreground="#6A6A6A" VerticalAlignment="Center" Margin="2,0,8,0" IsHitTestVisible="False"/>
                    <Button x:Name="BtnClearSearch" Grid.Column="2" Content="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11" Width="28" Height="28" Background="Transparent" Foreground="#7A7A7A" BorderThickness="0" Padding="0" Click="BtnClearSearch_Click" Visibility="Collapsed" ToolTip="Limpar"/>
                    <Button Grid.Column="3" Content="Buscar" Style="{StaticResource PrimaryBtn}" Padding="14,0" Margin="6,4,4,4" FontSize="12" Click="BtnSearch_Click"/>
                </Grid>
            </Border>
            <!-- Filtros de fonte (uniGetUI Sources): chips por gerenciador -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                <ToggleButton x:Name="ChkSrcWinget" Content="winget" Style="{StaticResource ChipBtn}" IsChecked="True" Margin="0,0,4,0" Checked="SourceFilter_Changed" Unchecked="SourceFilter_Changed" ToolTip="Winget (Windows Package Manager)"/>
                <ToggleButton x:Name="ChkSrcChoco" Content="choco" Style="{StaticResource ChipBtn}" IsChecked="True" Margin="0,0,4,0" Checked="SourceFilter_Changed" Unchecked="SourceFilter_Changed" ToolTip="Chocolatey"/>
                <ToggleButton x:Name="ChkSrcStore" Content="msstore" Style="{StaticResource ChipBtn}" IsChecked="False" Margin="0,0,4,0" Checked="SourceFilter_Changed" Unchecked="SourceFilter_Changed" ToolTip="Microsoft Store (requer winget com acordo da fonte msstore)"/>
            </StackPanel>
        </Grid>

        <!-- ============ TABS + contador de resultados (linha fina estilo UniGetUI) ============ -->
        <Grid Grid.Row="2" Margin="4,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button x:Name="BtnTabDiscover" Content="Descobrir" Style="{StaticResource GhostBtn}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="BtnTabDiscover_Click" ToolTip="Buscar pacotes disponíveis para instalar (winget, Chocolatey, MS Store)"/>
                <Button x:Name="BtnTabInstalled" Content="Instalados" Style="{StaticResource GhostBtn}" Padding="12,6" FontSize="11" Margin="0,0,6,0" Click="BtnTabInstalled_Click" ToolTip="Apps já instalados neste PC — desinstalar, reinstalar ou ver detalhes"/>
                <Button x:Name="BtnTabUpdates" Content="Atualizações" Style="{StaticResource GhostBtn}" Padding="12,6" FontSize="11" Click="BtnTabUpdates_Click" ToolTip="Pacotes instalados que têm uma versão mais nova disponível"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="TxtSearchInfo" Text="" FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center"/>
                <!-- Barra de progresso indeterminada finíssima -->
                <Border x:Name="PbSearchBorder" Visibility="Collapsed" Width="140" Height="3" Margin="10,0,0,0" Background="#2A2A2A" CornerRadius="1">
                    <Border x:Name="PbSearchFill" Background="#0078D4" CornerRadius="1" HorizontalAlignment="Left" Width="50">
                        <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                    </Border>
                </Border>
            </StackPanel>
            <TextBlock x:Name="TxtListInfo" Grid.Column="2" Text="" FontSize="11" Foreground="#6A6A6A" VerticalAlignment="Center"/>
        </Grid>

        <!-- ============ DATA GRID estilo UniGetUI (colunas: ícone, nome, id, versão, nova versão, fonte) ============ -->
        <Border Grid.Row="3" Style="{StaticResource CardBorder}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <!-- Spinner de carregamento -->
                <StackPanel x:Name="LoadingSpinnerPanel" Grid.Row="0" HorizontalAlignment="Center" Margin="0,40,0,20" Visibility="Collapsed">
                    <Ellipse Width="32" Height="32" Stroke="#0078D4" StrokeThickness="2.5" Fill="Transparent" RenderTransformOrigin="0.5,0.5" StrokeDashArray="22 13" HorizontalAlignment="Center">
                        <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                        <Ellipse.Triggers><EventTrigger RoutedEvent="Loaded"><BeginStoryboard><Storyboard RepeatBehavior="Forever"><DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/></Storyboard></BeginStoryboard></EventTrigger></Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock x:Name="TxtLoadingMsg" Text="Carregando..." FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <TextBlock x:Name="TxtEmpty" Grid.Row="0" Text="" FontSize="12" Foreground="#6A6A6A" HorizontalAlignment="Center" Margin="0,28,0,10" Visibility="Collapsed"/>

                <!-- Coluna header estilo WinUI: barra arredondada, sem separadores -->
                <ListView x:Name="LvPackages" Grid.Row="1" Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.CacheLength="4,4"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="52"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="8,6">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2F2F2F"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#2A3440"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#0078D4"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="2*" MinWidth="170"/>
                                    <ColumnDefinition Width="1.4*" MinWidth="150"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Ícone -->
                                <Border Width="38" Height="38" CornerRadius="8" Background="#323232" BorderBrush="#3A3A3A" BorderThickness="1" VerticalAlignment="Center">
                                    <Grid>
                                        <Image Source="{Binding IconSource}" Stretch="Uniform" Margin="4" Visibility="{Binding IconVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#9A9A9A" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding FallbackIconVisibility}"/>
                                    </Grid>
                                </Border>
                                <!-- Nome + editor -->
                                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <TextBlock Text="{Binding Publisher}" FontSize="10" Foreground="#7A7A7A" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <!-- Id -->
                                <TextBlock Grid.Column="2" Text="{Binding Id}" FontSize="10.5" Foreground="#8A9AB0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}"/>
                                <!-- Versão -->
                                <TextBlock Grid.Column="3" Text="{Binding DisplayVersion}" FontSize="11" Foreground="#C0C0C0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <!-- Nova versão -->
                                <TextBlock Grid.Column="4" Text="{Binding AvailableVersion}" FontSize="11" Foreground="#FF8C00" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Visibility="{Binding HasUpdateVisibility}"/>
                                <!-- Fonte + flag de já instalado -->
                                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Background="#1A2A3A" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Source}" FontSize="9" Foreground="#4CC2FF"/>
                                    </Border>
                                    <Border Background="#1A2A10" CornerRadius="4" Padding="6,2" Margin="4,0,0,0" VerticalAlignment="Center" Visibility="{Binding InstalledBadgeVisibility}" ToolTip="Este pacote já está instalado neste PC">
                                        <TextBlock Text="&#x2713; instalado" FontSize="9" Foreground="#7FBA00"/>
                                    </Border>
                                </StackPanel>
                                <!-- Ações -->
                                <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{Binding InstallButtonText}" Tag="{Binding}" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Visibility="{Binding InstallBtnVisibility}" Click="BtnInstallCard_Click" ToolTip="Instala (ou reinstala) este pacote"/>
                                    <Button Content="Atualizar" Tag="{Binding}" Style="{StaticResource PrimaryBtn}" Padding="10,4" FontSize="11" Margin="0,0,6,0" Visibility="{Binding UpdateBtnVisibility}" Click="BtnUpdateOne_Click" ToolTip="Atualizar para a nova versão"/>
                                    <Button Content="Force" Tag="{Binding}" Style="{StaticResource GhostBtn}" Padding="7,4" FontSize="11" Margin="0,0,6,0" Visibility="{Binding UpdateBtnVisibility}" Click="BtnForceUpdateOne_Click" ToolTip="Mata processos em execução e atualiza"/>
                                    <Button Content="&#xE74D;" Tag="{Binding}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostBtn}" Padding="7,4" FontSize="11" Visibility="{Binding UninstallBtnVisibility}" Click="BtnUninstallOne_Click" ToolTip="Desinstalar"/>
                                    <Button Content="&#xE712;" Tag="{Binding}" FontFamily="Segoe MDL2 Assets" Style="{StaticResource GhostBtn}" Padding="6,4" FontSize="10" Click="BtnDetails_Click" ToolTip="Detalhes do pacote"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!-- ============ STATUS BAR estilo UniGetUI: gerenciadores detectados + contador ============ -->
        <Border Grid.Row="4" Background="#252525" BorderBrush="#333333" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ScrollViewer MaxHeight="52" VerticalScrollBarVisibility="Auto" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLog" Text="Pronto." FontSize="10" Foreground="#6A6A6A" TextWrapping="Wrap" FontFamily="Consolas"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtStatusCounts" Grid.Column="1" Text="" FontSize="10" Foreground="#8A8A8A" VerticalAlignment="Center" Margin="10,0"/>
                <Button x:Name="BtnCopyLog" Grid.Column="2" Content="Copiar" FontSize="10" Style="{StaticResource GhostBtn}" Padding="8,3" Click="BtnCopyLog_Click" ToolTip="Copiar log (também visível no log do Kit)"/>
            </Grid>
        </Border>

        <!-- Widget de progresso flutuante -->
        <Border x:Name="InlineProgressPanel" Grid.Row="3" Panel.ZIndex="90"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,10,10" MinWidth="300" MaxWidth="420"
                BorderBrush="#660078D4" BorderThickness="1" CornerRadius="10" Padding="14,10"
                Visibility="Collapsed">
            <Border.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#EE1A1A1A" Offset="0"/>
                    <GradientStop Color="#DD0A0A0A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#0078D4" BlurRadius="18" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#0078D4" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtInlineStatus" Grid.Column="1" Text="" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtInlinePercent" Grid.Column="2" Text="" FontSize="14" FontWeight="Bold" Foreground="#0078D4" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </Grid>
                <Border x:Name="InlineProgressTrack" Background="#333333" CornerRadius="3" Height="4">
                    <Border x:Name="InlineProgressFill" Background="#0078D4" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
                </Border>
                <TextBlock x:Name="TxtInlineDetail" Text="" FontSize="10" Foreground="#8A8A8A" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </Border>

        <!-- Detail modal -->
        <Border x:Name="DetailOverlay" Visibility="Collapsed" Grid.Row="3" Panel.ZIndex="200" Background="#CC000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" MouseLeftButtonDown="DetailOverlay_MouseLeftButtonDown">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="640" MaxHeight="520" Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="24" ShadowDepth="8" Opacity="0.6"/>
                </Border.Effect>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="500">
                    <StackPanel Margin="24">
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="80" Height="80" CornerRadius="12" Background="#2A2A2A">
                                <Grid>
                                    <Image x:Name="DetailIcon" Stretch="Uniform" Margin="6" Visibility="Collapsed" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <TextBlock x:Name="DetailFallbackIcon" Text="&#xE772;" FontFamily="Segoe MDL2 Assets" FontSize="32" Foreground="#7A7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock x:Name="DetailName" Text="" FontSize="20" FontWeight="Bold" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailPublisher" Text="" FontSize="12" Foreground="#8A9AB0" Margin="0,2,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <Border Background="#1A2A3A" CornerRadius="4" Padding="8,2"><TextBlock x:Name="DetailSource" Text="" FontSize="10" Foreground="#4CC2FF"/></Border>
                                    <TextBlock x:Name="DetailVersion" Text="" FontSize="11" Foreground="#6A7A90" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="14" Width="32" Height="32" Style="{StaticResource GhostBtn}" Padding="0" VerticalAlignment="Top" Click="DetailClose_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="ID" FontSize="10" Foreground="#5A5A5A"/>
                                <TextBlock x:Name="DetailId" Text="" FontSize="11" Foreground="#9A9A9A" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Categoria / Moniker" FontSize="10" Foreground="#5A5A5A"/>
                                <TextBlock x:Name="DetailCategory" Text="" FontSize="11" Foreground="#9A9A9A"/>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="DetailUpdateInfo" Visibility="Collapsed" Background="#1A2A10" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7FBA00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Atualização disponível" FontSize="11" FontWeight="SemiBold" Foreground="#7FBA00"/>
                                    <TextBlock x:Name="DetailUpdateVersion" Text="" FontSize="10" Foreground="#6A8A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Já instalado (Discover) -->
                        <Border x:Name="DetailInstalledInfo" Visibility="Collapsed" Background="#12211A" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#7FBA00" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <StackPanel>
                                    <TextBlock Text="Já instalado neste PC" FontSize="11" FontWeight="SemiBold" Foreground="#7FBA00"/>
                                    <TextBlock x:Name="DetailInstalledVersion" Text="" FontSize="10" Foreground="#6A8A6A"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="DetailActionBtn" Content="Instalar" Style="{StaticResource PrimaryBtn}" Padding="18,8" FontSize="13" Click="DetailAction_Click"/>
                            <Button x:Name="DetailForceBtn" Content="Force" Style="{StaticResource GhostBtn}" Padding="12,8" FontSize="12" Margin="8,0,0,0" Click="DetailForce_Click" ToolTip="Mata processos e atualiza"/>
                            <Button x:Name="DetailUninstallBtn" Content="Desinstalar" Style="{StaticResource GhostBtn}" Padding="12,8" FontSize="12" Margin="8,0,0,0" Click="DetailUninstall_Click" Foreground="#E74856"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Border>
    </Grid>
</Page>
