<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.MacSpoofPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="MAC Spoof"
      TextElement.FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">
    <!-- DnsPlaceholderTextBoxStyle virou DarkPlaceholderTextBoxStyle no tema
         (Themes/BaseStyles.xaml). -->
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="MAC Spoof (estilo TMAC)"/>
            <TextBlock Style="{StaticResource PageSubtitleStyle}" Text="Alterar, randomizar, persistir e restaurar MAC de adaptadores" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Adaptador" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbAdapters" Margin="0,0,0,10" Height="32" FontSize="13" Foreground="White" Background="{DynamicResource Surface1}"/>
                        <TextBlock x:Name="TxtCurrentMac" Text="MAC atual: -" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="TxtOriginalMac" Text="MAC original: -" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="TxtStatus" Text="Status: -" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ações" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtNewMac" Style="{StaticResource DarkPlaceholderTextBoxStyle}" Tag="- . - . - . -" Margin="0,0,0,10" Height="32" FontSize="13"/>
                        <CheckBox x:Name="ChkUse02" Content="Usar 02: como primeiro octeto (locally administered)" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimary}"/>
                        <CheckBox x:Name="ChkIncludeMac" Content="Incluir MAC no nome do adaptador" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnRandom" Content="Random MAC" Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnChange" Content="Aplicar MAC" Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnReset" Content="Restaurar original" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnDelete" Content="Deletar do registro" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Presets" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ListPresets">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimary}" FontSize="13" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Monitor de Tráfego" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Upload" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtTrafficUp" Text="0 KB/s" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Download" FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                <TextBlock x:Name="TxtTrafficDown" Text="0 KB/s" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtTrafficPackets" Text="Pacotes: 0" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>