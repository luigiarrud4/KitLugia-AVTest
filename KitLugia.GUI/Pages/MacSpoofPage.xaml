<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.MacSpoofPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="MAC Spoof"
      TextElement.FontFamily="Segoe UI Variable, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">
    <Page.Resources>
        <Style x:Key="DnsPlaceholderTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#161616"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="CaretBrush" Value="#FFD700"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="false"
                                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <TextBlock x:Name="ph" Text="{TemplateBinding Tag}"
                                           Margin="10,6,0,0"
                                           FontSize="{TemplateBinding FontSize}" Foreground="#666"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           TextTrimming="CharacterEllipsis"
                                           Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#555"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FFD700"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="MAC Spoof (estilo TMAC)" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
            <TextBlock Text="Alterar, randomizar, persistir e restaurar MAC de adaptadores" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,8">
                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Adaptador" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                        <ComboBox x:Name="CmbAdapters" Margin="0,0,0,10" Height="32" FontSize="13" Foreground="White" Background="#1A1A1A"/>
                        <TextBlock x:Name="TxtCurrentMac" Text="MAC atual: -" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="TxtOriginalMac" Text="MAC original: -" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,2"/>
                        <TextBlock x:Name="TxtStatus" Text="Status: -" Foreground="{StaticResource TextMuted}" FontSize="13" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Ações" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                        <TextBox x:Name="TxtNewMac" Style="{StaticResource DnsPlaceholderTextBoxStyle}" Tag="- . - . - . -" Margin="0,0,0,10" Height="32" FontSize="13"/>
                        <CheckBox x:Name="ChkUse02" Content="Usar 02: como primeiro octeto (locally administered)" Margin="0,0,0,6" Foreground="{StaticResource TextPrimary}"/>
                        <CheckBox x:Name="ChkIncludeMac" Content="Incluir MAC no nome do adaptador" Margin="0,0,0,10" Foreground="{StaticResource TextPrimary}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnRandom" Content="Random MAC" Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnChange" Content="Aplicar MAC" Style="{StaticResource GoldButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnReset" Content="Restaurar original" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                            <Button x:Name="BtnDelete" Content="Deletar do registro" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Presets" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                        <ItemsControl x:Name="ListPresets">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{StaticResource TextPrimary}" FontSize="13" Margin="0,2"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource CardBackground}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Monitor de Tráfego" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Upload" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtTrafficUp" Text="0 KB/s" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Download" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtTrafficDown" Text="0 KB/s" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtTrafficPackets" Text="Pacotes: 0" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>