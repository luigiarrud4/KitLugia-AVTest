<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.WindowsUpdatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Windows Update (Insider)"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial"
      Background="Transparent">

    <Page.Resources>
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="{x:Type ToggleButton}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border" Grid.ColumnSpan="2" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                <Path x:Name="Arrow" Grid.Column="1" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" Data="M0,0 L4,4 L8,0" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="Background" Value="#333333" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="DarkComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1A1A1A"/>
            <Setter Property="BorderBrush" Value="#444444"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource ComboBoxToggleButton}" Grid.Column="2" Focusable="false" IsChecked="{Binding Path=IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,30,0" VerticalAlignment="Center" HorizontalAlignment="Left" />
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" SnapsToDevicePixels="True" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder" Background="#1A1A1A" BorderThickness="1" BorderBrush="#444444"/>
                                    <ScrollViewer Margin="4,6,4,6" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#222"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#333"/>
                    <Setter Property="Foreground" Value="{StaticResource AccentColor}"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20">
        <StackPanel Margin="30" MaxWidth="950">

            <!-- HEADER -->
            <StackPanel Orientation="Horizontal" Margin="0,0,0,25">
                <TextBlock Text="X" FontSize="32" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Windows Update (Insider)" FontSize="24" FontWeight="Bold" Foreground="{StaticResource AccentColor}"/>
                    <TextBlock x:Name="TxtSubtitle" Text="OfflineInsiderEnroll e Controle de Updates" FontSize="12" Foreground="{StaticResource TextSecondary}"/>
                </StackPanel>
            </StackPanel>

            <!-- STATUS DO SISTEMA -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,25" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="Diagnostico do Sistema" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource AccentColor}" VerticalAlignment="Center"/>
                        <Button x:Name="BtnRefreshStatus" Content="Atualizar" Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Right" Height="30" Width="100"
                                ToolTip="Atualiza as informacoes de build, versao, servicos e status Insider exibidas no diagnostico."
                                Click="BtnRefreshStatus_Click"/>
                    </Grid>

                    <Border Background="#1A1A1A" CornerRadius="6" Padding="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Build do Windows" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtBuild" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,2,0,10"/>

                                <TextBlock Text="Versao Atual" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtVersion" Text="-" FontSize="16" FontWeight="Bold" Foreground="White" Margin="0,2,0,10"/>

                                <TextBlock Text="Windows Update (wuauserv)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtWUStatus" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="USOSvc" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtUSOStatus" Text="-" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Insider (wisvc)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtWisvcStatus" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="Status Insider" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtInsiderStatus" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="Channel / Branch" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtInsiderChannel" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="Flight Signing" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtFlightSigning" Text="-" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="#1A1A1A" CornerRadius="6" Padding="15" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Updates Pausados" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtPausedStatus" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="Dias Restantes" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtPauseDays" Text="-" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Target Release" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtTargetRelease" Text="-" FontSize="14" Margin="0,2,0,10"/>

                                <TextBlock Text="Deferral Quality (dias)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock x:Name="TxtDeferralDays" Text="-" FontSize="14" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- CONTROLES DO WINDOWS UPDATE -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,25" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Controles do Windows Update" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Pausar updates por:" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                        <ComboBox Grid.Column="1" x:Name="CmbPauseDays" Style="{StaticResource DarkComboBoxStyle}"
                                  ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}" Width="120" HorizontalAlignment="Left" SelectedIndex="0"
                                  ToolTip="Selecione por quantos dias pausar. O scroll do mouse nao troca os itens sem clique.">
                            <ComboBoxItem Content="7 dias" Tag="7"/>
                            <ComboBoxItem Content="14 dias" Tag="14"/>
                            <ComboBoxItem Content="30 dias" Tag="30"/>
                            <ComboBoxItem Content="60 dias" Tag="60"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="Pausar" Style="{StaticResource SecondaryButtonStyle}"
                                Width="100" Height="36" Margin="10,0,0,0"
                                ToolTip="Para os servicos wuauserv/usosvc, grava as datas de pausa no registro e reinicia os servicos. Efeito imediato."
                                Click="BtnPause_Click"/>
                    </Grid>

                    <WrapPanel Margin="0,0,0,5">
                        <Button Content="Retomar Updates" Style="{StaticResource SecondaryButtonStyle}"
                                Width="160" Height="40" Margin="0,0,10,10"
                                ToolTip="Cancela a pausa do Windows Update: remove as datas de pausa do registro e reinicia os servicos. Volta a receber updates normalmente."
                                Click="BtnResume_Click"/>
                        <Button Content="Refresh Scan" Style="{StaticResource SecondaryButtonStyle}"
                                Width="160" Height="40" Margin="0,0,10,10"
                                ToolTip="Roda UsoClient StartScan + RefreshSettings: limpa o cache de scan e dispara uma nova verificacao de updates no Windows Update."
                                Click="BtnRefreshScan_Click"/>
                    </WrapPanel>

                    <Separator Background="#444" Margin="0,5,0,15"/>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Target Version:" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                        <TextBox Grid.Column="1" x:Name="TxtTargetVersion" Text="" FontSize="13"
                                 Background="#1A1A1A" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                 Padding="8,5" Height="34" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="Definir" Style="{StaticResource SecondaryButtonStyle}"
                                Width="100" Height="36" Margin="10,0,0,0"
                                ToolTip="Define uma versao alvo (ex: 23H2, 24H2, 10.0.22621.1) para o Windows Update oferecer apenas updates ate essa versao — evita upgrade de feature para versoes mais novas."
                                Click="BtnSetTarget_Click"/>
                    </Grid>
                    <TextBlock Text="Ex: 23H2, 24H2, 10.0.22621.1 — deixa em branco e clica em Limpar para remover" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,10"/>
                    <Button Content="Limpar Target Version" Style="{StaticResource SecondaryButtonStyle}"
                            Width="180" Height="36"
                            ToolTip="Remove a politica de versao alvo do registro. O Windows Update volta a oferecer qualquer versao disponivel."
                            Click="BtnClearTarget_Click"/>
                </StackPanel>
            </Border>

            <!-- CANAIS WINDOWS INSIDER -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,25" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Canais Windows Insider" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                    <TextBlock Text="Selecione um canal e inscreva o dispositivo. Nao precisa de conta Microsoft. A inscricao e feita via registro offline. A versao alvo de cada canal e calculada conforme o build deste PC."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <ComboBox x:Name="CmbChannel" Style="{StaticResource DarkComboBoxStyle}"
                              ItemContainerStyle="{StaticResource DarkComboBoxItemStyle}"
                              Width="320" HorizontalAlignment="Left" Margin="0,0,0,10"
                              SelectionChanged="CmbChannel_SelectionChanged"
                              ToolTip="Canal do programa Windows Insider. Itens desabilitados nao funcionam neste build do seu PC. O scroll do mouse em cima do box NAO troca o item sem clique."/>

                    <Border Background="#1A1A1A" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Comparacao com este PC" FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource AccentColor}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtBuildCompare" Text="Detectando build do sistema..."
                                       FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TxtChannelInfo" Text=""
                                       FontSize="11" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Content="Inscrever no Canal Selecionado"
                            Style="{StaticResource GoldButtonStyle}"
                            Height="50" FontSize="16" FontWeight="Bold"
                            ToolTip="Inscreve o dispositivo no canal selecionado via registro offline (WindowsSelfHost) e ativa o flight signing no BCD. Apos reiniciar, o Windows Update oferecera o build do canal."
                            Click="BtnEnroll_Click"/>

                    <Separator Background="#444" Margin="0,15"/>

                    <WrapPanel>
                        <Button Content="Resetar Config Insider" Style="{StaticResource SecondaryButtonStyle}"
                                Width="200" Height="40" Margin="0,0,10,10"
                                ToolTip="Apaga toda a configuracao Insider do registro (WindowsSelfHost, politicas, labels) sem desativar o flight signing."
                                Click="BtnResetInsider_Click"/>
                        <Button Content="Desinscrever (limpeza total)" Style="{StaticResource SecondaryButtonStyle}"
                                Width="200" Height="40" Margin="0,0,10,10"
                                ToolTip="Remove a inscricao Insider por completo: apaga as configuracoes e desativa o flight signing no BCD. Volta ao canal estavel publico."
                                Click="BtnUnenroll_Click"/>
                        <Button Content="Refresh WU Scan + Cache" Style="{StaticResource SecondaryButtonStyle}"
                                Width="200" Height="40" Margin="0,0,10,10"
                                ToolTip="Para wisvc/usosvc/wuauserv, limpa o cache do Update Store e os logs, reinicia os servicos e roda UsoClient RefreshSettings. Use apos inscrever para forcara busca do build."
                                Click="BtnRefreshWu_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- CONTROLE DE UPDATES (NAO-INSIDER) -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="25"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Margin="0,0,0,25" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="Controle de Updates (nao-Insider)" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource AccentColor}" Margin="0,0,0,10"/>
                    <TextBlock Text="Updates normais do Windows (KBs de qualidade, servico e drivers). Coloque um update manualmente ou tire um instalado — remover um KB desfaz o patch e volta os binarios a versao anterior (downgrade)."
                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Instalar update manual:" FontSize="13" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                        <TextBox Grid.Column="1" x:Name="TxtUpdatePath" Text="" FontSize="13"
                                 Background="#1A1A1A" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                 Padding="8,5" Height="34" VerticalContentAlignment="Center"
                                 ToolTip="Caminho de um arquivo .msu ou .cab de update (ex: Windows11.0-KBxxxxxxx-x64.msu)."/>
                        <Button Grid.Column="2" Content="Procurar..." Style="{StaticResource SecondaryButtonStyle}"
                                Width="110" Height="36" Margin="10,0,0,0"
                                ToolTip="Abre o seletor de arquivo para escolher um .msu ou .cab de update."
                                Click="BtnBrowseUpdate_Click"/>
                        <Button Grid.Column="3" Content="Instalar" Style="{StaticResource GoldButtonStyle}"
                                Width="110" Height="36" Margin="10,0,0,0"
                                ToolTip="Instala o update selecionado: .msu via wusa.exe, .cab via DISM /Add-Package. Requer administrador."
                                Click="BtnInstallUpdate_Click"/>
                    </Grid>

                    <StackPanel>
                        <WrapPanel Margin="0,0,0,8">
                            <TextBlock Text="Updates instalados neste PC:" FontSize="13" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="0,0,12,0" Foreground="White"/>
                            <Button Content="Atualizar Lista" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="140" Height="34" Margin="0,0,10,0"
                                    ToolTip="Relista os KBs instalados via Get-HotFix (WMI). Pode levar alguns segundos."
                                    Click="BtnRefreshInstalled_Click"/>
                            <Button Content="Remover Selecionado (downgrade)" Style="{StaticResource SecondaryButtonStyle}"
                                    Width="220" Height="34"
                                    ToolTip="Desinstala o KB selecionado com wusa.exe /uninstall — desfaz o patch (downgrade dos binarios). Pergunta confirmacao antes."
                                    Click="BtnRemoveUpdate_Click"/>
                        </WrapPanel>
                        <ListBox x:Name="LstInstalledUpdates" Height="200"
                                 Background="#1A1A1A" Foreground="White" BorderBrush="#444" BorderThickness="1"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ToolTip="KBs instalados neste PC (Get-HotFix). Selecione um e clique em Remover para desinstalar.">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3">
                                        <TextBlock FontWeight="Bold">
                                            <Run Text="{Binding HotFixId}"/><Run Text=" - "/><Run Text="{Binding Description}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="11" Foreground="{StaticResource TextMuted}" Text="{Binding InstalledOn}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Atencao: remover um KB de qualidade tambem remove os KBs dependentes mais novos que vieram depois dele."
                                   FontSize="11" Foreground="#FFA500" TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- AVISOS -->
            <Border Background="{StaticResource CardBackground}" CornerRadius="8" Padding="20"
                    BorderBrush="{StaticResource CardBorder}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Avisos" FontSize="16" FontWeight="Bold"
                               Foreground="#FFA500" Margin="0,0,0,10"/>
                    <TextBlock Text="- Builds Insider podem ser instaveis. Faca backup antes de inscrever."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="- Para desinscrever completamente, use 'Desinscrever (limpeza total)'."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    <TextBlock Text="- Todas as operacoes requerem privilegios de administrador."
                               FontSize="12" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
