<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="KitLugia.GUI.Pages.IntegrityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:converters="clr-namespace:KitLugia.GUI.Converters"
      mc:Ignorable="d" 
      Title="Integridade do Sistema"
      Background="{StaticResource WindowBackground}"
      TextElement.FontFamily="Segoe UI Variable Display, Segoe UI, Segoe UI Emoji, Segoe UI Symbol, Arial">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:PendingReasonConverter x:Key="PendingReason"/>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <converters:TweakDescriptionTooltipConverter x:Key="TweakDescriptionTooltip"/>
    </Page.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. CABEÇALHO -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Integridade e Seguranca" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Monitoramento ativo de vulnerabilidades e configurações críticas." Foreground="#AAA" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Loading Spinner (sobreposto ao score quando carregando) -->
            <Grid Grid.Column="1" Width="90" Height="90">
                <Border Width="90" Height="90" CornerRadius="45" BorderThickness="4" x:Name="BorderScore">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="TxtScore" Text="100%" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                        <TextBlock Text="SCORE" FontSize="10" Foreground="#AAA" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <!-- Loading overlay -->
                <Border x:Name="LoadingOverlay" Width="90" Height="90" CornerRadius="45" Background="#CC111111"
                        Visibility="Collapsed" IsHitTestVisible="True">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="⏳" FontSize="28" HorizontalAlignment="Center"/>
                        <TextBlock Text="SCAN" FontSize="9" Foreground="#AAA" HorizontalAlignment="Center" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- 1.1 Barra de progresso + aviso de correcoes pendentes de reinicio -->
        <StackPanel Grid.Row="1">
            <Border x:Name="PendingBanner" Visibility="Collapsed" Margin="0,0,0,10"
                    Background="#33FFB900" BorderBrush="#FFB8860B" BorderThickness="1" CornerRadius="6" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtPendingBanner" Grid.Column="0" FontSize="11"
                               Foreground="#FFD700" TextWrapping="Wrap" Margin="0,0,10,0"/>
                                    </Grid>
            </Border>

            <Border x:Name="ProgressBarContainer" Visibility="Collapsed" Margin="0,0,0,10" Height="4" CornerRadius="2" Background="#222">
                <Border x:Name="ProgressBarFill" Width="100" Height="4" CornerRadius="2" Background="{StaticResource AccentColor}" HorizontalAlignment="Left"/>
            </Border>
        </StackPanel>
        <!-- 2. BOTÕES E PESQUISA -->
        <Grid Grid.Row="2" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnFixAll" Content="🛡️ RESTAURAR TODOS (PADRÃO SEGURO)" Click="BtnFixAll_Click"
                    Width="280" Height="40" Background="#C42B1C" Foreground="White" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Style="{StaticResource GoldButtonStyle}"
                    ToolTip="Corrige apenas os itens MODIFICADOS (vulnerabilidades reais). Itens OPCIONAIS são mantidos como estão — eles são escolha sua e não contam para o score."/>

            <!-- SEARCH BOX (LUPA) -->
            <Border Grid.Column="1" Height="36" Margin="15,0,15,0" CornerRadius="18" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="14" Opacity="0.5"/>
                    <TextBox x:Name="SearchBox" Grid.Column="1" 
                             Text="" 
                             VerticalAlignment="Center" Margin="5,0,12,0"
                             Background="Transparent" Foreground="White" BorderThickness="0"
                             FontSize="13" CaretBrush="White"
                             TextChanged="SearchBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Text" Value=""/>
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="ToolTip" Value="Pesquisar por nome ou categoria..."/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- Botão limpar pesquisa -->
                    <Button Grid.Column="1" x:Name="BtnClearSearch" Width="22" Height="22" 
                            HorizontalAlignment="Right" Margin="0,0,6,0"
                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                            Visibility="Collapsed" Click="BtnClearSearch_Click">
                        <TextBlock Text="✕" Foreground="#666" FontSize="10"/>
                    </Button>
                </Grid>
            </Border>

            <!-- CATEGORY FILTER COMBO -->
            <Border Grid.Column="2" Height="36" CornerRadius="18" Background="#1A1A1A" BorderBrush="#333" BorderThickness="1" Margin="0,0,10,0">
                <ComboBox x:Name="CategoryFilter" VerticalAlignment="Center" Width="160"
                          Background="Transparent" Foreground="White" BorderThickness="0"
                          FontSize="12" SelectionChanged="CategoryFilter_SelectionChanged"
                          IsHitTestVisible="True" Cursor="Hand">
                    <ComboBoxItem Tag="ALL" IsSelected="True" Content="📋 Todas as Categorias"/>
                    <ComboBoxItem Tag="SEGURANCA" Content="🛡️ Segurança"/>
                    <ComboBoxItem Tag="PROTEGIDO" Content="✅ Protegido"/>
                    <ComboBoxItem Tag="MODIFICADO" Content="⚠️ Modificado"/>
                    <ComboBoxItem Tag="OPCIONAL" Content="⚙️ Opcional"/>
                    <ComboBoxItem Tag="DESEMPENHO" Content="⚡ Desempenho"/>
                </ComboBox>
            </Border>

            <Button Grid.Column="3" Content="🔄 Re-escanear" Click="BtnRescan_Click" x:Name="BtnRescan"
                    Width="130" Height="36" Background="#222" Foreground="White" BorderBrush="#444" BorderThickness="1" Cursor="Hand" Style="{StaticResource SecondaryButtonStyle}"/>
        </Grid>

        <!-- 2.5 CARD ÚNICO DE PATH (sistema + usuário) — substitui os vários botões PATH na lista -->
        <Border Grid.Row="3" Margin="0,0,0,12" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="15,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="📁" FontSize="26" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="PATH do Sistema e do Usuário" Foreground="White" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <Border x:Name="PathStatusBadge" CornerRadius="4" Padding="8,3" Margin="10,0,0,0" Background="#154CAF50" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPathStatus" Text="✅ OK" FontSize="10" FontWeight="Bold" Foreground="#4CAF50"/>
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtPathDetail" Text="Um clique corrige TUDO de uma vez: entradas duplicadas, pastas inexistentes, essenciais do Windows e programas instalados fora do PATH (winget, git, node, dotnet, npm, 7-Zip, cargo...)."
                               Foreground="#A0A0A0" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- Explorador (+) detalhado: ver entradas e adicionar manualmente -->
                <Button Grid.Column="2" Click="BtnPathExplore_Click" Width="34" Height="34" Margin="0,0,10,0"
                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                        ToolTip="Ver o PATH atual, o que está certo/errado e adicionar caminhos manualmente">
                    <TextBlock Text="➕" FontSize="17" Foreground="#FFD700" Opacity="0.85"/>
                </Button>

                <!-- Botão único: repara System + User e adiciona os ausentes.
                     Estado PADRÃO neutro; o UpdatePathCardState vira o destaque de
                     acao (AccentColor + "CORRIGIR...") SO quando ha pendencia real. -->
                <Button x:Name="BtnPathRepairAll" Grid.Column="3" Click="BtnPathRepairAll_Click"
                        Height="36" MinWidth="210" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5"
                        Background="#1F1F1F" BorderBrush="#3A3A3A" Foreground="#B5B5B5"
                        Content="⟳ Reaplicar / Adicionar ausentes">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- 3. LISTA DE ITENS COM VIRTUALIZAÇÃO REAL -->
        <!-- ListBox tem ScrollViewer próprio + UI virtualização nativa. O padrão anterior
             (ItemsControl dentro de ScrollViewer) desligava a virtualização: TODOS os itens
             eram materializados de uma vez, congelando a página em listas grandes. -->
        <Border Grid.Row="4" Background="#111111" BorderBrush="#333333" BorderThickness="1" CornerRadius="8">
          <Grid>
            <!-- Fundo escuro global: o template default do ListBox/ScrollViewer usa fundo
                 BRANCO do sistema. Enquanto a lista materializa (UI thread ocupada setando
                 ~900 itens), o WPF mostra o fundo NÃO renderizado = flash branco. -->
            <Grid.Resources>
                <Style TargetType="ScrollViewer">
                    <Setter Property="Background" Value="#111111"/>
                </Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#111111"/>
                </Style>
            </Grid.Resources>
            <ListBox x:Name="ItemsList"
                     Background="#111111"
                     Foreground="White"
                     BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.CacheLength="1,2"
                     VirtualizingPanel.CacheLengthUnit="Page"
                     ScrollViewer.IsDeferredScrollingEnabled="False"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel VirtualizingPanel.IsVirtualizing="True"
                                                VirtualizingPanel.VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Setter Property="Background" Value="#161616"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="#222" BorderThickness="0,0,0,1" Padding="15,10">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E1E22"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#23232A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <!-- Responsivo: colunas fixas viram Auto (encolhem quando falta espaço),
                             a de conteúdo é * com MinWidth; sem larguras somadas > viewport -->
                        <Border Padding="15,10" Background="#161616" BorderBrush="#222" BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*" MinWidth="120"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Escudo -->
                                <TextBlock Text="🛡️" VerticalAlignment="Center" FontSize="18" Opacity="0.7"/>

                                <!-- Nome e Categoria -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0,10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                        <!-- Selo de reinicialização pendente: só aparece em itens PENDING.
                                             Fica ao lado do título para o usuário saber de relance
                                             que a correção só valerá no próximo boot. -->
                                        <Border Grid.Column="1" x:Name="PendingRestartSeal" Visibility="Collapsed"
                                                Margin="8,0,0,0" VerticalAlignment="Center"
                                                CornerRadius="3" Padding="6,2"
                                                Background="#33FFB900" BorderBrush="#FFB900" BorderThickness="1"
                                                ToolTip="Este item já foi corrigido, mas a mudança só vale após reiniciar o Windows.">
                                            <TextBlock Text="🔄 REINICIALIZAÇÃO PENDENTE" Foreground="#FFD700" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Category}" Foreground="#666" FontSize="11"/>
                                </StackPanel>

                                <!-- BOTÃO DE INFORMAÇÃO + EXPLORADOR DE PATH -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Button x:Name="InfoBtn" Click="BtnInfo_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0"
                                            Width="30" Height="30" Cursor="Help"
                                            ToolTip="{Binding Converter={StaticResource TweakDescriptionTooltip}}"
                                            ToolTipService.InitialShowDelay="0" ToolTipService.ShowDuration="20000">
                                        <TextBlock Text="ℹ️" FontSize="16" Foreground="{StaticResource AccentColor}" Opacity="0.6"/>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <Button x:Name="BtnPathExplore" Click="BtnPathExplore_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Visibility="Collapsed"
                                            Width="30" Height="30" Cursor="Hand"
                                            ToolTip="Ver o PATH atual, o que falta e adicionar caminhos ausentes">
                                        <TextBlock Text="➕" FontSize="15" Foreground="#FFD700" Opacity="0.75"/>
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="Transparent">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Opacity" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>

                                <!-- Badge de Status: usa binding direto para StatusDisplayText/StatusBadgeBackground
                                     (itens opcionais mostram "OPCIONAL" em vez de "PROTEGIDO") -->
                                <Border Grid.Column="3" VerticalAlignment="Center" Margin="10,0"
                                        CornerRadius="4" Padding="10,4" MinWidth="100" x:Name="StatusBadge">
                                    <TextBlock x:Name="TxtStatus" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"
                                               Text="{Binding StatusDisplayText}"
                                               Foreground="{Binding StatusTextColor, Converter={StaticResource HexToBrush}}"/>
                                    <Border.Background>
                                        <Binding Path="StatusBadgeBackground" Converter="{StaticResource HexToBrush}"/>
                                    </Border.Background>
                                </Border>

                                <!-- Botão de Ação -->
                                <Button Grid.Column="4" Click="BtnToggleItem_Click" Tag="{Binding}"
                                        Height="32" Width="110" Cursor="Hand" HorizontalAlignment="Right"
                                        x:Name="BtnAction" FontWeight="SemiBold" FontSize="11">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bdr" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bdr" Property="Opacity" Value="0.8"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bdr" Property="Opacity" Value="0.5"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>

                                    </Grid>
                                </Border>

                                <DataTemplate.Triggers>
                                    <!-- ITENS DE PATH: mostra o botão + (Explorador de PATH) -->
                                    <DataTrigger Binding="{Binding IsPathItem}" Value="True">
                                        <Setter TargetName="BtnPathExplore" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>

                                    <!-- BtnAction: só aplica quando NÃO é opcional.
                                         Itens opcionais nunca mostram status vermelho/verde, só OPCIONAL. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="OK"/>
                                            <Condition Binding="{Binding IsOptional}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="BtnAction" Property="Content" Value="Desativar"/>
                                        <Setter TargetName="BtnAction" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="BtnAction" Property="BorderBrush" Value="#333333"/>
                                        <Setter TargetName="BtnAction" Property="Foreground" Value="#777777"/>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding Status}" Value="MODIFIED"/>
                                            <Condition Binding="{Binding IsOptional}" Value="False"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="BtnAction" Property="Content" Value="CORRIGIR"/>
                                        <Setter TargetName="BtnAction" Property="Background" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="BtnAction" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="BtnAction" Property="Foreground" Value="Black"/>
                                    </MultiDataTrigger>

                                    <!-- OPCIONAL: badge FIXA "◇ OPCIONAL" nos estados
                                         estáveis (OK e MODIFIED). Só o botão muda
                                         (CORRIGIR / REVERTER). Se a badge mudasse
                                         conforme o status, a separação dos filtros
                                         (Protegido / Modificado / Opcional) quebraria:
                                         um opcional modificado apareceria com badge
                                         de modificado no filtro errado. -->
                                    <DataTrigger Binding="{Binding IsOptional}" Value="True">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#115533"/>
                                        <Setter TargetName="TxtStatus" Property="Text" Value="◇ OPCIONAL"/>
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#FFA500"/>
                                    </DataTrigger>

                                    <!-- ESTADO: N/A -->
                                    
                                    <!-- AGUARDANDO REINICIO: corrigido, so vale no proximo boot -->
                                    <DataTrigger Binding="{Binding Status}" Value="PENDING">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#33FFB900"/>
                                        <Setter TargetName="TxtStatus" Property="Text" Value="⏳ AGUARDANDO REINÍCIO"/>
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#FFD700"/>
                                        <Setter TargetName="BtnAction" Property="Visibility" Value="Hidden"/>
                                        <!-- Selo no título: "reinicialização pendente" -->
                                        <Setter TargetName="PendingRestartSeal" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    
                                    <DataTrigger Binding="{Binding Status}" Value="NOT_FOUND">
                                        <Setter TargetName="StatusBadge" Property="Background" Value="#111111"/>
                                        <Setter TargetName="TxtStatus" Property="Text" Value="N/A"/>
                                        <Setter TargetName="TxtStatus" Property="Foreground" Value="#555555"/>
                                        <Setter TargetName="BtnAction" Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                    
                                    <!-- ITENS OPCIONAIS: têm botão próprio (APLICAR / REVERTER) para o usuário
                                         escolher a otimização. Sem estes triggers o BtnAction ficava vazio. -->
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOptional}" Value="True"/>
                                            <Condition Binding="{Binding Status}" Value="OK"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="BtnAction" Property="Content" Value="CORRIGIR"/>
                                        <Setter TargetName="BtnAction" Property="Background" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="BtnAction" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="BtnAction" Property="Foreground" Value="Black"/>
                                    </MultiDataTrigger>

                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsOptional}" Value="True"/>
                                            <Condition Binding="{Binding Status}" Value="MODIFIED"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter TargetName="BtnAction" Property="Content" Value="REVERTER"/>
                                        <Setter TargetName="BtnAction" Property="Background" Value="Transparent"/>
                                        <Setter TargetName="BtnAction" Property="BorderBrush" Value="{StaticResource AccentColor}"/>
                                        <Setter TargetName="BtnAction" Property="Foreground" Value="{StaticResource AccentColor}"/>
                                    </MultiDataTrigger>

                                </DataTemplate.Triggers>
                            </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state quando pesquisa não encontra nada -->
            <TextBlock x:Name="EmptyState" Text="🔍 Nenhum item encontrado para esta pesquisa."
                       Foreground="#666" FontSize="14" IsHitTestVisible="False"
                       VerticalAlignment="Center" HorizontalAlignment="Center"
                       Visibility="Collapsed"/>
          </Grid>
        </Border>
    </Grid>
</Page>