<Window x:Class="KitLugia.WinPE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KitLugia WinPE Toolkit" Height="750" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow"
        AllowsTransparency="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16" Background="{StaticResource BgCardBrush}">
                    <StackPanel>
                        <TextBlock Text="🛠️ KitLugia" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="WinPE Toolkit" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="EnvText" FontSize="11" Margin="0 4 0 0"
                                   Foreground="{StaticResource SuccessBrush}"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="1" Margin="0 8 0 0">
                    <Button x:Name="NavDashboard" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Dashboard">📊  Dashboard</Button>
                    <Button x:Name="NavExplorer" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="FileExplorer">📁  Explorador</Button>
                    <Button x:Name="NavPartitions" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Partitions">💾  Partições</Button>
                    <Button x:Name="NavShrink" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Shrink">📦  Shrink</Button>
                    <Button x:Name="NavInstall" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="InstallWindows">🖥️  Instalar Windows</Button>
                    <Button x:Name="NavTools" Style="{StaticResource NavButton}"
                            Click="Nav_Click" Tag="Tools">🔧  Ferramentas</Button>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="16">
                    <Button x:Name="BtnLaunchShell" Content="🚀  Iniciar WinXShell"
                            Style="{StaticResource AccentButton}" Click="BtnLaunchShell_Click"
                            IsEnabled="False"/>
                    <TextBlock x:Name="ShellStatus" FontSize="11" Margin="0 4 0 0"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Text="WinXShell: não encontrado"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Area -->
        <Grid Grid.Column="1">
            <Frame x:Name="MainFrame" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
