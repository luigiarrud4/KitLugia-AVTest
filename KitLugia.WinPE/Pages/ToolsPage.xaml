<Page x:Class="KitLugia.WinPE.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDarkBrush}"
      Title="Ferramentas">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Ferramentas do Sistema" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Utilitários para WinPE" 
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 24"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Coluna 1 -->
                <StackPanel Grid.Column="0" Margin="0 0 8 0">
                    <Border Style="{StaticResource CardBorder}" Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="🔧  Ferramentas de Disco" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                            <Button Content="🧹  Clean Disk via diskpart" Style="{StaticResource AccentButton}" 
                                    Click="BtnCleanDisk_Click" Margin="0 0 0 6"/>
                            <Button Content="📋  Listar Volumes Detalhado" Style="{StaticResource AccentButton}"
                                    Click="BtnListVolumes_Click" Margin="0 0 0 6"/>
                            <Button Content="🔍  Verificar Integridade (SFC)" Style="{StaticResource AccentButton}"
                                    Click="BtnSfc_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="📦  Imagens WIM/ISO" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                            <Button Content="🔗  Montar ISO" Style="{StaticResource AccentButton}" 
                                    Click="BtnMountIso_Click" Margin="0 0 0 6"/>
                            <Button Content="💿  Desmontar ISO" Style="{StaticResource AccentButton}"
                                    Click="BtnDismountIso_Click" Margin="0 0 0 6"/>
                            <Button Content="📊  Info do WIM" Style="{StaticResource AccentButton}"
                                    Click="BtnWimInfo_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="🖥️  Boot" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                            <Button Content="📝  Gerenciar BCD" Style="{StaticResource AccentButton}" 
                                    Click="BtnManageBcd_Click" Margin="0 0 0 6"/>
                            <Button Content="🔄  Reparar Boot (bootrec)" Style="{StaticResource AccentButton}"
                                    Click="BtnRepairBoot_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Coluna 2 -->
                <StackPanel Grid.Column="1" Margin="8 0 0 0">
                    <Border Style="{StaticResource CardBorder}" Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="🌐  Rede" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                            <Button Content="🌍  Testar Conexão (ping)" Style="{StaticResource AccentButton}" 
                                    Click="BtnPing_Click" Margin="0 0 0 6"/>
                            <Button Content="📶  Listar Interfaces" Style="{StaticResource AccentButton}"
                                    Click="BtnListInterfaces_Click" Margin="0 0 0 6"/>
                            <Button Content="🔑  Configurar IP" Style="{StaticResource AccentButton}"
                                    Click="BtnSetIp_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardBorder}" Margin="0 0 0 12">
                        <StackPanel>
                            <TextBlock Text="📄  Logs e Relatórios" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                            <Button Content="📋  Info do Sistema" Style="{StaticResource AccentButton}" 
                                    Click="BtnSystemInfo_Click" Margin="0 0 0 6"/>
                            <Button Content="📊  Exportar Relatório" Style="{StaticResource AccentButton}"
                                    Click="BtnExportReport_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Margin="0 16 0 0">
                <StackPanel>
                    <TextBlock Text="Console" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <TextBox x:Name="LogBox" Height="180" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource BgMediumBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
