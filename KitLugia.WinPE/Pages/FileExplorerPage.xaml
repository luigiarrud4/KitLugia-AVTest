<Page x:Class="KitLugia.WinPE.Pages.FileExplorerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDarkBrush}"
      Title="Explorador de Arquivos">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgMediumBrush}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button x:Name="BtnBack" Content="⬅" Width="36" Height="32" Margin="0 0 4 0"
                            Style="{StaticResource AccentButton}" Padding="0" Click="BtnBack_Click"
                            IsEnabled="False"/>
                    <Button x:Name="BtnUp" Content="⬆" Width="36" Height="32" Margin="0 0 4 0"
                            Style="{StaticResource AccentButton}" Padding="0" Click="BtnUp_Click"/>
                </StackPanel>
                <TextBlock x:Name="CurrentPath" Grid.Column="1" VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                           TextTrimming="CharacterEllipsis" Margin="8 0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📋 Copiar" Style="{StaticResource AccentButton}" Padding="12 6"
                            Click="BtnCopy_Click" Margin="0 0 4 0"/>
                    <Button Content="📋 Colar" Style="{StaticResource AccentButton}" Padding="12 6"
                            Click="BtnPaste_Click" Margin="0 0 4 0"/>
                    <Button Content="🗑️ Deletar" Style="{StaticResource DangerButton}" Padding="12 6"
                            Click="BtnDelete_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main: Tree + File List -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Drive/Folder Tree -->
            <Border Grid.Column="0" Background="{StaticResource BgMediumBrush}" Margin="0 0 2 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="UNIDADES" Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="Bold" Padding="12 8"/>
                    <TreeView x:Name="FolderTree" Grid.Row="1" Background="Transparent"
                              BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                              SelectedItemChanged="FolderTree_SelectedItemChanged">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="4 2"/>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </Grid>
            </Border>

            <!-- File List -->
            <Border Grid.Column="1" Background="{StaticResource BgMediumBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="{StaticResource BgCardBrush}" Padding="8 6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Nome" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Column="1" Text="Tamanho" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Column="2" Text="Tipo" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Grid.Column="3" Text="Modificado" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="FileList" Grid.Row="1" Background="Transparent"
                             BorderThickness="0" Foreground="{StaticResource TextPrimaryBrush}"
                             SelectionMode="Extended" MouseDoubleClick="FileList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Size}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Type}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Modified}"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource BgMediumBrush}" Padding="12 6">
            <TextBlock x:Name="StatusBar" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Page>
