<Page x:Class="KitLugia.WinPE.Pages.InstallWindowsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDarkBrush}"
      Title="Instalar Windows">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Instalar Windows" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Instalação direta via ISO + DISM + bcdboot (sem USB)" 
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 24"/>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="1. Selecione a ISO do Windows" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IsoPathBox" Grid.Column="0" Text="" IsReadOnly="True"
                                 Background="{StaticResource BgMediumBrush}"
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="8"/>
                        <Button Grid.Column="1" Content="📂  Procurar ISO" Style="{StaticResource AccentButton}"
                                Click="BtnBrowseIso_Click" Margin="8 0 0 0" Width="140"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="2. Selecione o destino" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <ComboBox x:Name="TargetDriveCombo"
                              Background="{StaticResource BgMediumBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                              MinWidth="120" HorizontalAlignment="Left"/>
                    <Button Content="🔄  Atualizar Unidades" Style="{StaticResource AccentButton}"
                            Click="BtnRefreshDrives_Click" Margin="0 8 0 0" Width="160"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="3. Opções de Instalação" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <CheckBox x:Name="ChkFormat" Content="Formatar partição antes de instalar"
                              Foreground="{StaticResource TextPrimaryBrush}" Margin="0 0 0 4"/>
                    <CheckBox x:Name="ChkBypass" Content="Pular requisitos (TPM/RAM/CPU) - Win11"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="True" Margin="0 0 0 4"/>
                    <CheckBox x:Name="ChkLocalAccount" Content="Criar conta local (sem Microsoft)"
                              Foreground="{StaticResource TextPrimaryBrush}" IsChecked="True"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <Button Content="🚀  INICIAR INSTALAÇÃO" Style="{StaticResource AccentButton}"
                        Click="BtnInstall_Click" Width="240" Height="44" FontSize="16"/>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <TextBox x:Name="LogBox" Height="200" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource BgMediumBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                    <TextBlock x:Name="ProgressText" Margin="0 8 0 0"
                               Foreground="{StaticResource AccentBrush}" FontSize="12"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
