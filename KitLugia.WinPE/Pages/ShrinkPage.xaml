<Page x:Class="KitLugia.WinPE.Pages.ShrinkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgDarkBrush}"
      Title="Shrink Avançado">
    <ScrollViewer Padding="24">
        <StackPanel>
            <TextBlock Text="Shrink Inteligente de Partição" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="Reduza partições sem as limitações do Windows (via WinPE)" 
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0 4 0 24"/>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Text="Unidade:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                    <ComboBox x:Name="DriveCombo" Grid.Row="0" Grid.Column="1" Margin="0 0 0 4"
                              Background="{StaticResource BgMediumBrush}" Foreground="{StaticResource TextPrimaryBrush}"
                              MinWidth="120" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Text="Tamanho Atual:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                    <TextBlock x:Name="CurrentSize" Grid.Row="1" Grid.Column="1" 
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0 0 0 4"/>

                    <TextBlock Grid.Row="2" Text="Espaço Livre:" Foreground="{StaticResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                    <TextBlock x:Name="FreeSpace" Grid.Row="2" Grid.Column="1"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0 0 0 4"/>

                    <Button Grid.Row="3" Grid.Column="0" Content="📊  Analisar" Style="{StaticResource AccentButton}"
                            Click="BtnAnalyze_Click" Width="140" Margin="0 8 0 0"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorder}" Margin="0 0 0 16">
                <StackPanel>
                    <TextBlock Text="Configurar Shrink" Style="{StaticResource SectionTitle}" Margin="0 0 0 12"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quanto reduzir (MB):" Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center"/>
                        <TextBox x:Name="ShrinkMbInput" Grid.Column="1" Text="7000"
                                 Background="{StaticResource BgMediumBrush}" 
                                 Foreground="{StaticResource TextPrimaryBrush}"
                                 BorderThickness="0" Padding="8" Width="120" HorizontalAlignment="Left"/>
                    </Grid>
                    <Button Content="🚀  Agendar Shrink via WinPE" Style="{StaticResource AccentButton}"
                            Click="BtnScheduleShrink_Click" Margin="0 12 0 0" Width="240" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Log" Style="{StaticResource SectionTitle}" Margin="0 0 0 8"/>
                    <TextBox x:Name="LogBox" Height="200" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="11"
                             Background="{StaticResource BgMediumBrush}"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderThickness="0" VerticalScrollBarVisibility="Auto"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
