<Window x:Class="KitLugia.WinPE.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Entrada" Width="400" Height="180"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Foreground="{StaticResource TextPrimaryBrush}" Margin="0 0 0 12"/>
        <TextBox x:Name="InputBox" Grid.Row="1"
                 Background="{StaticResource BgMediumBrush}"
                 Foreground="{StaticResource TextPrimaryBrush}"
                 BorderThickness="0" Padding="8" FontSize="14"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
            <Button Content="OK" Style="{StaticResource AccentButton}" Width="80"
                    Click="BtnOk_Click" Margin="0 0 8 0"/>
            <Button Content="Cancelar" Style="{StaticResource DangerButton}" Width="80"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
