<UserControl x:Class="KitLugia.Bootstrap.DependencyDialogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540">

    <!--
        Telas do bootstrapper: as cores vem das MESMAS tokens do KitLugia
        (KitLugia.GUI/Themes/Brushes.xaml) para o launcher falar a mesma
        linguagem visual do app — fundo #0F0F0F, dourado #FFD700, textos
        #FFFFFF / #E0E0E0 / #8A8A8A.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AccentColor" Color="#FFD700"/>
            <SolidColorBrush x:Key="Surface0" Color="#0F0F0F"/>
            <SolidColorBrush x:Key="Surface1" Color="#1A1A1A"/>
            <SolidColorBrush x:Key="Surface2" Color="#252525"/>
            <SolidColorBrush x:Key="BorderSubtle" Color="#333333"/>
            <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#E0E0E0"/>
            <SolidColorBrush x:Key="TextMuted" Color="#8A8A8A"/>

            <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFD700" Offset="0"/>
                <GradientStop Color="#FFA500" Offset="1"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1A1505" Offset="0.0"/>
                <GradientStop Color="#0A0A0A" Offset="0.35"/>
                <GradientStop Color="#050505" Offset="1.0"/>
            </LinearGradientBrush>

            <DropShadowEffect x:Key="GlowEffect" Color="#FFD700" BlurRadius="26" ShadowDepth="0" Opacity="0.45"/>
            <DropShadowEffect x:Key="TextGlow" Color="#FFD700" BlurRadius="7" ShadowDepth="0" Opacity="0.75"/>

            <!-- Botao principal (dourado) -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="#101010"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="22,0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" CornerRadius="8" Background="{StaticResource GoldGradient}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#FFE44D"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bdr" Property="Background" Value="#4D4D4D"/>
                                    <Setter Property="Foreground" Value="#9A9A9A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botao secundario (neutro) -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="22,0"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bdr" CornerRadius="8" Background="#1A1A1A" BorderBrush="{StaticResource BorderSubtle}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bdr" Property="Background" Value="#252525"/>
                                    <Setter TargetName="bdr" Property="BorderBrush" Value="#55FFD700"/>
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource AccentColor}"
            Background="{StaticResource Surface0}" Effect="{StaticResource GlowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. BARRA DE TITULO -->
            <Border Grid.Row="0" Background="#15FFD700" BorderBrush="#33FFD700" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_Click">
                <Grid>
                    <TextBlock Text="INSTALAÇÃO DO KITLUGIA"
                               Foreground="{StaticResource AccentColor}"
                               FontWeight="Bold" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Effect="{StaticResource TextGlow}"/>
                    <TextBlock x:Name="TxtClose" Text="✕"
                               Foreground="{StaticResource TextMuted}" FontSize="14"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Margin="0,0,14,0" Cursor="Hand"
                               MouseLeftButtonDown="BtnClose_Click"/>
                </Grid>
            </Border>

            <!-- 2. CONTEUDO -->
            <StackPanel Grid.Row="1" Margin="30,22,30,6">

                <!-- Icone de aviso (mesmo triangulo do LugiaMsgBox do Kit) -->
                <Grid HorizontalAlignment="Center" Width="46" Height="42" Margin="0,0,0,12">
                    <Path Data="M 23,0 L 46,42 L 0,42 Z"
                          Fill="{StaticResource AccentColor}"
                          Stroke="{StaticResource AccentColor}"
                          StrokeThickness="3" StrokeLineJoin="Round"
                          Effect="{StaticResource TextGlow}"/>
                    <TextBlock Text="!" FontSize="21" FontWeight="ExtraBold" Foreground="Black"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="0,9,0,0" IsHitTestVisible="False"/>
                </Grid>

                <TextBlock Text="Componentes Adicionais Necessários"
                           Foreground="{StaticResource AccentColor}"
                           FontSize="17" FontWeight="Bold"
                           HorizontalAlignment="Center" TextAlignment="Center"/>

                <TextBlock Text="O KitLugia precisa que os seguintes itens sejam instalados primeiro:"
                           Foreground="{StaticResource TextPrimary}"
                           FontSize="13" Margin="0,10,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>

                <ItemsControl x:Name="ListComponents" Margin="0,12,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#12FFFFFF" BorderBrush="#26FFD700" BorderThickness="1"
                                    CornerRadius="8" Padding="12,9" Margin="0,3">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="Deseja baixá-los e instalá-los agora?"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="13" Margin="0,14,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>

            <!-- 3. PROGRESSO -->
            <StackPanel Grid.Row="2" Margin="30,10,30,0" x:Name="PanelProgress" Visibility="Collapsed">
                <Border x:Name="ProgressTrack" Height="6" Background="#1FFFFFFF" CornerRadius="3" ClipToBounds="True">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="3"
                            Background="{StaticResource GoldGradient}"/>
                </Border>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Preparando..."
                               Foreground="{StaticResource TextSecondary}" FontSize="12"
                               HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                    <TextBlock x:Name="TxtPercent" Grid.Column="1" Text="0%"
                               Foreground="{StaticResource AccentColor}" FontSize="12" FontWeight="Bold"
                               HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="TxtError" Foreground="#FF8A8A8A" FontSize="11" TextWrapping="Wrap"
                           Margin="0,6,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <!-- 4. BOTOES -->
            <Border Grid.Row="3" Background="#0AFFFFFF" Padding="26,14" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtHint" Grid.Column="0"
                               Text="Download oficial da Microsoft."
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button x:Name="BtnCancel" Content="Cancelar"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button x:Name="BtnInstall" Content="Instalar"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnInstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
